<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="/Basestation_Software.Web.styles.css" />

    <link rel="stylesheet" href="/js/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="/js/lib/leaflet-contextmenu/leaflet.contextmenu.min.css" />

    <link rel="stylesheet" href="/styles/app.css" />
    <link rel="stylesheet" href="/icons/bootstrap-icons.css" />

    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="/_framework/blazor.web.js"></script>

    @* Leaflet does not support JS modules *@
    <script src="/js/lib/leaflet/leaflet.js"></script>
    <script src="/js/lib/leaflet-contextmenu/leaflet.contextmenu.min.js"></script>
    @* Script needs to be imported only once for the page *@
    <script type="module">
        import * as cameras from "/js/cameras.js";
        window.cameras = cameras;
        import * as components from "/js/components.js";
        window.components = components;
    </script>
    @* three.js and 3D rover are imported with modules, so do not require a script tag *@
</body>

</html>