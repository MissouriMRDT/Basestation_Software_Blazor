@inject RoveCommService _RoveCommService

<div class="card full-height">
    <div class="card-header d-flex">
        <h3>Autonomy Log</h3>
        <button @onclick=@(() => {
                logs.Add(new Log{message = "very very long messagevery very long messagevery very long messagevery very long messagevery very long messagevery very long messagevery very long messagevery very long message", timestamp = DateTime.Now});
        })>Test Log</button>
    </div>
    <div class="card-body">
        <div class="d-flex">
            <RadzenNumeric TValue="byte" Min="0" Max="8" @bind-Value=@ll1 />
            <RadzenNumeric TValue="byte" Min="0" Max="8" @bind-Value=@ll2 />
            <RadzenNumeric TValue="byte" Min="0" Max="8" @bind-Value=@ll3 />
            <button class="btn btn-primary" @onclick=@(() => _RoveCommService.SendAsync<byte>("Autonomy", "SetLoggingLevels", [ll1, ll2, ll3]))>Set Log Level</button>
        </div>
        <div style="height: 15vh; overflow-y: scroll">
            <table class="table table-striped">
                <thead class="thead-light">
                    <tr>
                        <th>message</th>
                        <th>timestamp</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Log log in logs)
                    {
                        <tr>
                            <td scope="row">@log.message</td>
                            <td>@log.timestamp</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {

    byte ll1 = 0;
    byte ll2 = 0;
    byte ll3 = 0;

    struct Log {
        public string message;
        public DateTime timestamp;
    }
    List<Log> logs = new();

    protected override async Task OnInitializedAsync()
    {
        _RoveCommService.On<char>("Autonomy", "CurrentLog", async (packet) =>
        {
            Log newLog = new Log
            {
                message = packet.Data.ToString(),
                timestamp = DateTime.Now
            };
            logs.Add(newLog);

            await InvokeAsync(StateHasChanged);
        });

        _RoveCommService.On<byte>("Autonomy", "ReachedGoal", async (packet) =>
        {
        Log newLog = new Log
            {
                message = "Reached Goal!",
                timestamp = DateTime.Now
            };
        logs.Add(newLog);

        await InvokeAsync(StateHasChanged);
        });
    }
}