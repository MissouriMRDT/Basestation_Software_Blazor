@implements IDisposable
@inject RoveCommService _RoveCommService
@using System.IO

<div class="card h-100">
	<div class="card-header">
		<h3>Science Displays</h3>
	</div>

	<img style="max-width: 100%; max-height: 200px;" src=@("graphs/" + _graphFiles[_selectedGraphIndex]) />


	@*Setting all the buttons*@
	<div style="display:flex; flex-wrap: wrap; justify-content:center; align-content: center; height:100%;">
		@for (int i = 0; i < _graphFiles.Length; i++)
		{
			int _i = i;
			<button @onclick=@(() => _selectedGraphIndex = _i)>@_graphFiles[_i].Split(".")[0]</button>
		}
	</div>

</div>


@code {
	private string[] _graphFiles = ["Gypsum.png", "Dolomite.png", "Calcite.png", "Talc.png", "Glycine.png", "L-alanine.png", "D-alanine.png"];
	private int _selectedGraphIndex = 0; 
	void IDisposable.Dispose()
	{

	}
}
