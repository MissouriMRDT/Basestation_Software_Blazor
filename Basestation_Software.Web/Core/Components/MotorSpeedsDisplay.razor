@inject RoveCommService _RoveCommService
@inject IJSRuntime _IJSRuntime

<style>
    .motor-info-grid {
        display: grid;
        gap: 2px;
        grid-template-rows: 1fr 1fr 1fr;
        grid-template-columns: 50% 50%;
        grid-auto-flow: column;
        padding: 2px;
        background-color: black;
    }
</style>

<div class="card h-100">
    <div class="card-header d-flex justify-content-between">
        <h5 class="mr-auto">Motor Speeds</h5>
        <div>
            <label for="show-3d-rover">Super cool feature!<i class="bi bi-arrow-right"></i></label>
            <input type="checkbox" name="show-3d-rover" @bind="_show3DRover" />
        </div>
    </div>
    <div class="card-body p-0">
        <div class="h-100 d-flex flex-column align-items-start">
            @if (@_show3DRover)
            {
                <div class="w-100 flex-grow-1" style="min-width: 20%; min-height: 20%;">
                    <Rover3DView />
                </div>
            }
            <div class="motor-info-grid w-100 flex-grow-1">
                @foreach (MotorInfo? motor in _motorData)
                {
                    <div class="d-flex flex-column fw-bold w-100 h-100">
                        <div class="d-flex align-items-center flex-grow-1 h-100 @(motor.FaultCode == 0 ? "" : "bg-danger")"
                            style="color: white;">
                            <div class="col-3 text-center fw-bold p-1">@motor.DisplayName</div>
                            <div class="col d-flex flex-column h-100">
                                <div class="small px-2 py-1 flex-grow-1"
                                    style="background-color: @(motor.InputCurrent is null ? "lightgray" : $"color-mix(in oklab, #ff0000 {Math.Clamp((double)motor.InputCurrent, 0, DANGER_INPUT_CURRENT) / DANGER_INPUT_CURRENT * 100}%, #00ff00)"); color: black;">
                                    VESC Current: <span class="float-end">@(motor.InputCurrent is null ? "--" :
                                                                            $"{motor.InputCurrent:0.00}") A</span>
                                </div>
                                <div class="small px-2 py-1 flex-grow-1"
                                    style="background-color: @(motor.MotorCurrent is null ? "lightgray" : $"color-mix(in oklab, #ff0000 {Math.Clamp((double)motor.MotorCurrent, 0, DANGER_MOTOR_CURRENT) / DANGER_MOTOR_CURRENT * 100}%, #00ff00)"); color: black;">
                                    Motor Current: <span class="float-end">@(motor.MotorCurrent is null ? "--" :
                                                                            $"{motor.MotorCurrent:0.00}") A</span>
                                </div>
                            </div>
                        </div>
                        @if (motor.FaultCode != 0)
                        {
                            <div class="bg-danger px-2 py-1 small" sytle="font-family: Consolas; color: black;">
                                @(Enum.GetName<RoveComm.Boards.Core.VESCFaultCode>(motor.FaultCode))</div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>


@code
{
    private class MotorInfo
    {
        public string DisplayName = "";
        public float? MotorSpeed { get; set; }
        public float? MotorCurrent { get; set; }
        public float? InputCurrent { get; set; }
        public RoveComm.Boards.Core.VESCFaultCode FaultCode { get; set; } = 0;
        public Timer? FaultWatchdog;
    }

    const double DANGER_MOTOR_CURRENT = 60;
    const double DANGER_INPUT_CURRENT = 6;
    private List<MotorInfo> _motorData = [];

    public const int TELEMETRY_TIMEOUT = 10_000; // ms
    private Timer? TelemetryWatchdog = null!;

    private bool _show3DRover = false;

    protected override void OnInitialized()
    {
        _motorData.Add(new() { DisplayName = "FL" });
        _motorData.Add(new() { DisplayName = "ML" });
        _motorData.Add(new() { DisplayName = "BL" });
        _motorData.Add(new() { DisplayName = "FR" });
        _motorData.Add(new() { DisplayName = "MR" });
        _motorData.Add(new() { DisplayName = "BR" });

        _RoveCommService.On<float>("Core", "MotorSpeeds", OnVescCurrents);
        _RoveCommService.On<float>("Core", "MotorCurrents", OnMotorCurrents);
        _RoveCommService.On<float>("Core", "VESCCurrents", OnVescCurrents);
        _RoveCommService.On<byte>("Core", "VESCFault", OnVescFault);

        TelemetryWatchdog = new Timer(OnResetTelemetry, null, TELEMETRY_TIMEOUT, Timeout.Infinite);
    }

    private void ResetTelemetryWatchdog()
    {
        TelemetryWatchdog?.Change(TELEMETRY_TIMEOUT, Timeout.Infinite);
    }

    private async void OnResetTelemetry(object? _)
    {
        foreach (MotorInfo? motor in _motorData)
        {
            motor.InputCurrent = null;
            motor.MotorCurrent = null;
            motor.MotorSpeed = null;
            motor.FaultCode = 0;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async void OnResetFault(object? context)
    {
        MotorInfo? motor = context as MotorInfo;
        if (motor is not null)
        {
            motor.FaultCode = 0;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnMotorSpeeds(RoveCommPacket<float> packet)
    {
        for (int i = 0; i < 6; i++)
        {
            MotorInfo? motor = _motorData[i];
            motor.MotorSpeed = packet.Data[i];
        }

        ResetTelemetryWatchdog();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnMotorCurrents(RoveCommPacket<float> packet)
    {
        for (int i = 0; i < 6; i++)
        {
            MotorInfo? motor = _motorData[i];
            motor.MotorCurrent = packet.Data[i];
        }

        ResetTelemetryWatchdog();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnVescCurrents(RoveCommPacket<float> packet)
    {
        for (int i = 0; i < 6; i++)
        {
            _motorData[i].InputCurrent = packet.Data[i];
        }

        ResetTelemetryWatchdog();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnVescFault(RoveCommPacket<byte> packet)
    {
        int motorId = packet.Data[0];
        if (motorId < 6)
        {
            MotorInfo? motor = _motorData[motorId];
            motor.FaultCode = (RoveComm.Boards.Core.VESCFaultCode)packet.Data[1];
            if (motor.FaultWatchdog is null)
            {
                motor.FaultWatchdog = new Timer(OnResetFault, motor, TELEMETRY_TIMEOUT, Timeout.Infinite);
            }
            else
            {
                motor.FaultWatchdog.Change(TELEMETRY_TIMEOUT, Timeout.Infinite);
            }

            await InvokeAsync(StateHasChanged);
        }
    }

}
