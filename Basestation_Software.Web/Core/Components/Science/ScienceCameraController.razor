@inject RoveCommService _RoveCommService
@inject OpService _OpState;

<div class="component-header">
    <h3>Science Camera Controls</h3>
</div>
<div class="component-body">
    <div style="display: grid; grid-template-columns: auto auto">
        <label>Site Name: </label>
        <input @bind=_siteName>
        <label>Pano Index: </label>
        <input @bind=_panoIndex>
    </div>
    <button @onclick=TakePano class="btn btn-primary">Take Pano</button>
    <div style="display: grid; grid-template-columns: repeat(7, auto); gap: 2px">
        @for (int i = 0; i < 8; i++)
        {
            int _i = i;
            <label class="font-monospace align-self-center">C@(i)</label>
            <button @onclick=@(() => TakePicture(_i, "pic"))>Picture</button>
            <button @onclick=@(() => TakePicture(_i, "autoFl"))>AutoFl</button>
            <button @onclick=@(() => TakePicture(_i, "strat"))>Strat</button>
            <button @onclick=@(() => TakePicture(_i, "micro"))>Micro</button>
            <button @onclick=@(() => TakePicture(_i, "overall"))>Overall</button>
            <button @onclick=@(() => TakePicture(_i, "rock"))>Rock</button>
        }
    </div>
</div>

@code {
    private int _panoIndex = 0;
    private string _siteName = "site1";
    private string _optionsTemplate = @"--verbose
--device
$input
--palette
YUYV
--resolution
1280x720
--frames
4
--set
Brightness=$brightness%
--set
Contrast=$contrast%
--skip
40
--png
9
--no-timestamp
--font
sans:{1}
--banner-colour
\#A00A0A0A
--line-colour
\#99000
--title
{2}
pictures/{0}.png";
    private List<string> panoSegmentNames = ["panoL", "panoM", "panoR"];

    private async Task TakePicture(int cameraIndex, string pictureName, int fontSize = 22, string titleAppendix = "$position")
    {
        var board = RoveCommManifest.Boards[cameraIndex < 4 ? "Camera1" : "Camera2"];
        if (cameraIndex >= 4) cameraIndex -= 4;
        await _RoveCommService.SendAsync<byte>(board.Commands["ToggleStream"].DataID, [(byte)cameraIndex, 0], board.IP);
        // Arbitrary delay to ensure packet is recieved
        await Task.Delay(1000);

        await _RoveCommService.SendAsync<char>(board.Commands["SetPictureArguments"].DataID, GeneratePictureArgs(pictureName, fontSize, titleAppendix), board.IP);
        await Task.Delay(1000);

        // await RoveComm.Boards.Camera1.TakePicture(_RoveCommService, (byte)cameraIndex, (byte)1);
        await _RoveCommService.SendAsync<byte>(board.Commands["TakePicture"].DataID, [(byte)cameraIndex, 1], board.IP);
    }

    private async Task TakePano()
    {
        await _RoveCommService.SendAsync<short>("Core", "LeftMainGimbalIncrement", [-180, 0]);
        await Task.Delay(3000);
        for (int i = 0; i < 3; i++)
        {
            await TakePicture(_panoIndex, panoSegmentNames[i], 40, "");
            await Task.Delay(20000);
            await _RoveCommService.SendAsync<short>("Core", "LeftMainGimbalIncrement", [90, 0]);
            await Task.Delay(2000);
        }
    }

    private List<char> GeneratePictureArgs(string filename, int fontSize, string titleAppendix)
    {
        string fullName = _siteName + "_" + filename;
        List<char> characters = String.Join("\x1f", String.Format(_optionsTemplate, fullName, fontSize, titleAppendix).Split("\n")).ToList();
        characters.Add('\x04');
        return characters;
    }
}