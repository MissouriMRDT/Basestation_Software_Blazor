@inject RoveCommService _RoveCommService
@inject OpService _OpState;

<div class="component-header">
    <h3>Science Camera Controls</h3>
</div>
<div class="component-body">
    <div style="display: grid; grid-template-columns: auto auto">
        <label>Site Name: </label>
        <input @bind=_siteName />
        <label>Pano Index: </label>
        <input @bind=_panoIndex />
    </div>
    <button @onclick=TakePano>Take Pano</button>
    <div style="display: grid; grid-template-columns: repeat(7, auto); gap: 2px">
        @for (int i = 0; i < 8; i++)
        {
            int _i = i;
            <label class="font-monospace align-self-center">C@(i)</label>
            <button @onclick=@(() => TakePicture(_i, "pic"))>Picture</button>
            <button @onclick=@(() => TakePicture(_i, "autoFl"))>AutoFl</button>
            <button @onclick=@(() => TakePicture(_i, "strat"))>Strat</button>
            <button @onclick=@(() => TakePicture(_i, "micro"))>Micro</button>
            <button @onclick=@(() => TakePicture(_i, "overall"))>Overall</button>
            <button @onclick=@(() => TakePicture(_i, "rock"))>Rock</button>
        }
    </div>
</div>

@code {
    private int _panoIndex = 0;
    private string _siteName = "site1";
    private string _optionsTemplate = @"--verbose
--device
$input
--palette
YUYV
--resolution
1280x720
--frames
4
--set
Brightness=$brightness%
--set
Contrast=$contrast%
--skip
40
--png
9
--no-timestamp
--font
sans:{1}
--banner-colour
\#A00A0A0A
--line-colour
\#99000
--title
{2}
pictures/{0}.png";
    private List<string> panoSegmentNames = ["panoL", "panoM", "panoR"];

    private async Task TakePicture(int cameraIndex, string pictureName, int fontSize = 22, string titleAppendix = "$position")
    {
        if (cameraIndex < 4)
        {
            _RoveCommService.Boards.Camera1.ToggleStream((byte)cameraIndex, 0);
            // Arbitrary delay to ensure packet is recieved
            await Task.Delay(1000);

            _RoveCommService.Boards.Camera1.SetPictureArguments(GeneratePictureArgs(pictureName, fontSize, titleAppendix));
            await Task.Delay(1000);

            _RoveCommService.Boards.Camera1.TakePicture((byte)cameraIndex, 1);
        }
        else
        {
            cameraIndex -= 4;
            _RoveCommService.Boards.Camera1.ToggleStream((byte)cameraIndex, 0);
            // Arbitrary delay to ensure packet is recieved
            await Task.Delay(1000);

            _RoveCommService.Boards.Camera1.SetPictureArguments(GeneratePictureArgs(pictureName, fontSize, titleAppendix));
            await Task.Delay(1000);

            _RoveCommService.Boards.Camera1.TakePicture((byte)cameraIndex, 1);
        }
    }

    private async Task TakePano()
    {
        _RoveCommService.Boards.Core.LeftGimbal(-180, 0);
        await Task.Delay(3000);
        for (int i = 0; i < 3; i++)
        {
            await TakePicture(_panoIndex, panoSegmentNames[i], 40, "");
            await Task.Delay(20000);
            _RoveCommService.Boards.Core.LeftGimbal((short)(i * 90 - 180), 0);
            await Task.Delay(2000);
        }
    }

    private char[] GeneratePictureArgs(string filename, int fontSize, string titleAppendix)
    {
        string fullName = _siteName + "_" + filename;
        return (String.Join("\x1f", String.Format(_optionsTemplate, fullName, fontSize, titleAppendix).Split("\n")) + '\x04').ToCharArray();
    }
}