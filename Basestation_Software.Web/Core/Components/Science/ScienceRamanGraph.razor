@inject RoveCommService _RoveCommService
@inject IJSRuntime _IJSRuntime
@using PSC.Blazor.Components.Chartjs
@using PSC.Blazor.Components.Chartjs.Models.Line
@using PSC.Blazor.Components.Chartjs.Models.Common
@using System.Threading.Tasks
@using System.Text
@using System.Timers
@using System.Runtime.CompilerServices
@implements IDisposable

<script>
    function DownloadFile(filename, contentType, content) {
        const file = new File([content], filename, { type: contentType });
        const exportUrl = URL.createObjectURL(file);
        const link = document.createElement("a");
        link.href = exportUrl;
        link.download = filename;
        link.target = "_self";
        link.click();
        URL.revokeObjectURL(exportUrl);
    }
</script>
<div class="component-header @_loadingState">
    <h3>Raman Spectroscopy Graph</h3>
</div>
<div class="component-body" style="display: grid; grid: minmax(0%, 100%) repeat(4, min-content) / 40% 60%; height: 95%;">
    <Chart Config="RamanChartConfig" @ref="RamanChart" Style="grid-column: 1 / 3; height:100%%"></Chart>
    <button class=@(_requestChecked ? "danger" : "") checked=@(_requestChecked) @onclick=@(() => RequestPressed())>@(_requestChecked ? "Cancel" : "Request Data")</button>
    <div style="display: grid; grid-template-columns: 50% 50%; grid-auto-flow: column;">
        <button onclick="const link = document.createElement('a'); link.download = 'RamanGraph.png'; link.href = this.parentElement.parentElement.getElementsByTagName('canvas')[0].toDataURL(); link.click();"><i class="bi-filetype-png" /></button>
        <button @onclick=DownloadCSV><i class="bi-filetype-csv" /></button>
    </div>
    <p>Integration Time (ms, cycles)</p>
    <div style="display: grid; grid-template-columns: 30% 30% 40%; grid-auto-flow: column;">
        <input style="width: 100%;" @bind=_integrationTime/>
        <input style="width: 100%;" @bind=_integrationCycles/>
        <select @bind=_requestType style="width: 100% ;">
            <option value="0">Single</option>
            <option value="1">Averaging</option>
            <option value="2">Increment</option>
            <option value="3">Continuous</option>
            <option value="4">Hardware Background</option>
        </select>
    </div>
    <p>Dot Size</p>
    <input @bind=_dotSize @bind:after=UpdateChartAsync />
    <div style="display: grid; grid-template-columns: 33% 33% 34%; grid-column: 1 / 3; grid-auto-flow: column;">
        <button style="width: 100%;" @onclick=@SetBackground>Set Background</button>
        <button checked=@(_backgroundChecked) style="width: 100%;" @onclick=@(async () => await SubtractData())>Apply Background</button>
        <button @onclick=@(() => _RoveCommService.Boards.Raman.RequestRamanReading(405, 405)) style="danger">Reset Hardware Background</button>
    </div>
    <button style="grid-column: 1 / 3;" class=@(_laserActive ? "danger" : "") checked=@(_laserActive) @onclick=@(() => ToggleLaser())>Laser</button>
</div>

@code {
    private string _loadingState = "";
    private float _dotSize = 2f;
    private uint _integrationTime = 100, _integrationCycles = 1;
    private ushort[] _data = new ushort[2048];
    private ushort[] _backgroundData = new ushort[2048];
    private bool _backgroundChecked = false;
    private bool _requestChecked = false;
    private uint _requestType = 0;
    private bool _laserActive = false;
    private PeriodicTimer _continuousTimer = new PeriodicTimer(TimeSpan.FromSeconds(1.2));
    private bool _continuousEnabled = false;
    private CancellationTokenSource _ctts = new();
    private Timer _laserTimer = new Timer(  200);
    private LineChartConfig? RamanChartConfig;
    private Chart? RamanChart;
    private string _acquiredAt = "";


    protected override async Task OnAfterRenderAsync(bool f)
    {
        if (f)
        {
            _laserTimer.Elapsed += LaserElapsed;
            _laserTimer.AutoReset = true;
            _laserTimer.Enabled = true;

            _ = ContinuousTimer();
        }
    }
    protected override async void OnInitialized()
    {   

        // Initialize data with easter egg
        for (int i = 0; i < _data.Length; i++)
        {
            _data[i] = (ushort)(1000 * Math.Pow(Math.E, -0.005 * Math.Abs(i - 1024)) * Math.Cos(1024 * (i - 1024)) + 1000);
        }

        _RoveCommService.Boards.Raman.OnRamanReading_Part1(async packet =>
        {
            _acquiredAt = DateTime.UtcNow.ToString("yyyy-MM-ddTHH_mm_ssZ");

            _RoveCommService.Boards.Raman.RamanReading_Part1.CopyTo(_data, 0);
            await UpdateChartAsync();
            await InvokeAsync(StateHasChanged);

            RequestOver();
        });

        _RoveCommService.Boards.Raman.OnRamanReading_Part2(async packet =>
        {
            _RoveCommService.Boards.Raman.RamanReading_Part2.CopyTo(_data, 512);
            await UpdateChartAsync();
            await InvokeAsync(StateHasChanged);
        });

        _RoveCommService.Boards.Raman.OnRamanReading_Part3(async packet =>
        {
            _RoveCommService.Boards.Raman.RamanReading_Part3.CopyTo(_data, 1024);
            await UpdateChartAsync();
            await InvokeAsync(StateHasChanged);
        });

        _RoveCommService.Boards.Raman.OnRamanReading_Part4(async packet =>
        {
            _RoveCommService.Boards.Raman.RamanReading_Part4.CopyTo(_data, 1536);
            await UpdateChartAsync();
            await InvokeAsync(StateHasChanged);
        });

        await UpdateChartAsync();
    }

    private void ToggleLaser()
    {
        _laserActive = !_laserActive;
    }

    private void RequestOver(bool c = false)
    {
        if (_requestType != 3)
            _requestChecked = false;

        _loadingState = !c ? "topBarFinished" : "topBarCanceled";

        _backgroundChecked = false;
    }

    private void CancelRequest()
    {
        _requestChecked = false;
        _continuousEnabled = false;

        RequestOver(true);
        _RoveCommService.Boards.Raman.RequestRamanReading(404, 404);
    }


    private async void LaserElapsed(object? sender, ElapsedEventArgs e)
    {
        _RoveCommService.Boards.Raman.Laser(_laserActive ? (byte)1 : (byte)0);
        Console.WriteLine(_laserActive);
    }

    private async Task ContinuousTimer()
    {
        try
        {
            while (await _continuousTimer.WaitForNextTickAsync(_ctts.Token))
            {
                if (_requestType != 3)
                    _continuousEnabled = false;

                if (_continuousEnabled)
                {
                    Console.WriteLine("Request");
                    _loadingState = "topBarLoading";
                    _RoveCommService.Boards.Raman.RequestRamanReading(Math.Min(_integrationCycles, 1000), 1);
                }
            }
        }
        catch (OperationCanceledException) {Console.WriteLine("Timer Canceled");}
    }
    private void RequestRaman()
    {   

        uint processedIntegrationTime = _integrationTime - (_integrationTime % 10);
        _integrationCycles = (_requestType % 4 == 0) ? 1 : _integrationCycles;

        if (_requestType != 3)
        {
            processedIntegrationTime += _requestType;

            _RoveCommService.Boards.Raman.RequestRamanReading(processedIntegrationTime, _integrationCycles);
            _loadingState = "topBarLoading";
        }

        //If timer is set to true, initialize it
        else if (_requestType == 3)
            _continuousEnabled = true;
    }

    private void RequestPressed()
    {
        if (!_requestChecked)
        {
            _requestChecked = true;
            RequestRaman();
        }
        else
            CancelRequest();
    }

    private void SetBackground()
    {
        for (int i = 0; i < _data.Length; i++)
            _backgroundData[i] = _data[i];
    }

    private async Task SubtractData()
    {
        for (int i = 0; i < _data.Length; i++)
        {
            if (!_backgroundChecked)
                _data[i] -= (_backgroundData[i] <= _data[i]) ? _backgroundData[i] : _data[i];
            else
                _data[i] += _backgroundData[i];
        }

        _backgroundChecked = !_backgroundChecked;

        await UpdateChartAsync();
    }

    private async Task UpdateChartAsync()
    {
        // TODO: Rescale x from pixel to raman shift. Set major axis lines to every 10 cm-1. Add reference spectra lines from spreadsheet.
        // Reinitialize the chart config
        RamanChartConfig = new LineChartConfig()
        {
            Options = new Options()
            {
                Responsive = true,
                RegisterDataLabels = true,
                MaintainAspectRatio = false,
                Animation = false,
                Scales = new Dictionary<string, Axis>()
                {
                    {
                        Scales.XAxisId, new Axis()
                        {
                            Ticks = new Ticks()
                            {
                                StepSize = 50
                            },
                            Display = true,
                            Text = "Raman Shift (cm⁻¹)",
                            Color = "black",
                            Title = new AxesTitle()
                            {
                                Display = true,
                                Text = "Raman Shift (cm⁻¹)",
                                Color = "black"
                            }
                        }
                    },
                    {
                        Scales.YAxisId, new Axis()
                        {
                            Display = true,
                            Text = "Intensity",
                            Color = "black",
                            Title = new AxesTitle()
                            {
                                Display = true,
                                Text = "Intensity",
                                Color = "black"
                            }
                        }
                    }
                },
                Plugins = new Plugins()
                {
                    Legend = new Legend()
                    {
                        Display = false
                    }
                }
            }
        };

        RamanChartConfig.Data.Labels = Enumerable.Range(0, 2048).Select(i => i.ToString()).ToList();

        RamanChartConfig.Data.Datasets.Add(
            new LineDataset()
            {
                Label = "Raman Spectrum",
                Data = _data.Select(x => (decimal?)x).ToList(),
                BorderColor = "rgba(255, 0, 0, 1)",
                BackgroundColor = "rgba(255, 0, 0, 0.5)",
                PointRadius = (int)Math.Max(1, _dotSize),
            }
        );

        // RamanChart?.ClearData();
    }


    private async Task DownloadCSV()
    {
        byte[] file = Encoding.ASCII.GetBytes(String.Join("\n", _data.Select((x, i) => $"{i},{x}")));
        await _IJSRuntime.InvokeVoidAsync("DownloadFile", $"Raman_{_acquiredAt}.csv", "application/octet-stream", file);
    }

    void IDisposable.Dispose()
    {
        _laserTimer.Elapsed -= LaserElapsed;
        _laserTimer.Dispose();

        _ctts.Cancel();
        _continuousTimer.Dispose();
        _ctts.Dispose();
    }
}