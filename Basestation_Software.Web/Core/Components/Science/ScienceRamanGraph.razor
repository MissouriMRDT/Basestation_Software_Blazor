@inject RoveCommService _RoveCommService
@inject IJSRuntime _IJSRuntime
@using PSC.Blazor.Components.Chartjs
@using PSC.Blazor.Components.Chartjs.Models.Line
@using PSC.Blazor.Components.Chartjs.Models.Scatter
@using PSC.Blazor.Components.Chartjs.Models.Common
@using System.Threading.Tasks
@using System.Text
@using System.IO

<script>
    function DownloadFile(filename, contentType, content) {
        const file = new File([content], filename, { type: contentType });
        const exportUrl = URL.createObjectURL(file);
        const link = document.createElement("a");
        link.href = exportUrl;
        link.download = filename;
        link.target = "_self";
        link.click();
        URL.revokeObjectURL(exportUrl);
    }
</script>
<div class="component-header">
    <h3>Raman Spectroscopy Graph</h3>
</div>
<div class="component-body" style="display: grid; grid: minmax(0%, 100%) repeat(4, min-content) / 1fr 1fr;">
    <Chart Config="RamanChartConfig" @ref="RamanChart" Style="grid-column: 1 / 3; height:100%; min-height:0;"></Chart>
    <button @onclick=@(() => _RoveCommService.Boards.Raman.RequestRamanReading(_integrationTime))>Request Data</button>
    <button onclick="const link = document.createElement('a'); link.download = 'RamanGraph_@(_acquiredAt).png'; link.href = this.parentElement.getElementsByTagName('canvas')[0].toDataURL(); link.click();"><i class="bi-filetype-png" /></button>
    <input type="checkbox" @bind=_displayRaw @bind:after=UpdateChartAsync />
    <button @onclick=DownloadCSV><i class="bi-filetype-csv" /></button>
    <p>Integration Time (ms)</p>
    <input @bind=_integrationTime />
    <p>Dot Size</p>
    <input @bind=_dotSize @bind:after=UpdateChartAsync />
    <div>
        <input type="checkbox"
               id="backgroundSubtractionToggle"
               name="Background Subtraction"
               @bind=_backgroundSubtractionEnabled
               @bind:after=UpdateChartAsync />
        <label for="backgroundSubtractionToggle">Background Subtraction</label>
    </div>
    <div>
        <button @onclick=@(() => ResetBackground())>Reset Background</button>
        <button @onclick=@(() => SetBackground())>Set Background</button>
    </div>
    <div>
        <input type="checkbox"
               id="cosmicRayRemovalToggle"
               name="Cosmic Ray Removal"
               @bind=_cosmicRayRemovalEnabled
               @bind:after=UpdateChartAsync />
        <label for="cosmicRayRemoval">Cosmic Ray Removal</label>
    </div>
    <div>
        <label>Threshold</label>
        <input @bind=_cosmicRayThreshold @bind:after=UpdateChartAsync/>
    </div>
    <div>
        <button @onclick=ToggleRamanGraphListVisibility>Raman Graphs</button>
        <div id="RamanGraphList" style="display:@(ramanGraphListVisibility)">
            @{
                int i = 0;
                foreach (string file in ramanDataFiles)
                {
                    string name = GetFirstWord(Path.GetFileNameWithoutExtension(file));
                    <div>
                        <input type="checkbox"
                               id="@name"
                               name="@name"
                               @onchange=@(e => UpdateGraphVisibility(name, file, e))>
                        <label for="@name">@name</label>
                    </div>
                    ++i;
                }
            }
        </div>
    </div>
</div>

<style>
    .component-body {
        min-height: 0;
    }

    .component-body > * {
        min-height: 0;
    }
</style>

@code {

    // TODO: Add raman data for: Quartz, Calcite, Gypsum, Kaolinite, Hematite, Magnetite, iron oxide

    private float _dotSize = 1f;
    private uint _integrationTime;

    private ushort[] _rawData = new ushort[2048];
    private ushort[] _rawBackground = new ushort[2048];
    private int _rawBackgroundSampleCount = 0;
    private bool _backgroundSubtractionEnabled = false;

    private double[] _data = new double[2048];

    private bool _displayRaw = false;
    private string _acquiredAt = "";

    private float _cosmicRayThreshold = 200f;
    private bool _cosmicRayRemovalEnabled = false;

    private ScatterChartConfig? RamanChartConfig;
    private Chart? RamanChart;

    private static Dictionary<string, List<(double, double)>> rawRamanGraphs = new Dictionary<string, List<(double, double)>> { };
    private static Dictionary<string, bool> rawGraphVisibility = new Dictionary<string, bool> { };

    private const string ramanDataFolder = "Raman";
    private string[] ramanDataFiles = Directory.GetFiles(ramanDataFolder);

    private void Export()
    {
        File.WriteAllLines("RamanExport_" + ((DateTimeOffset)DateTime.Now).ToUnixTimeMilliseconds() + ".csv", _data.Select(x => string.Join(",", x)));
    }

    protected override async void OnInitialized()
    {
        // Initialize data with easter egg
        for (int i = 0; i < _data.Length; i++)
        {
            //_data[i] = (1000 * Math.Pow(Math.E, -0.005 * Math.Abs(i - 1024)) * Math.Cos(1024 * (i - 1024)) + 1000);
            _data[i] = 0;
            if (i == 512)
            {
                _rawData[i] = (ushort)(2000);
            } else
            {
                _rawData[i] = (ushort)(1000 * Math.Pow(Math.E, -0.005 * Math.Abs(i - 1024)) * Math.Cos(1024 * (i - 1024)) + 1000);
            }
        }

        // RamanReading_Part4 always occurs last.
        _RoveCommService.Boards.Raman.OnRamanReading_Part4(async packet =>
        {
            _acquiredAt = DateTime.UtcNow.ToString("yyyy-MM-ddTHH_mm_ssZ");

            _RoveCommService.Boards.Raman.RamanReading_Part1.CopyTo(_rawData, 0);
            _RoveCommService.Boards.Raman.RamanReading_Part2.CopyTo(_rawData, 512);
            _RoveCommService.Boards.Raman.RamanReading_Part3.CopyTo(_rawData, 1024);
            _RoveCommService.Boards.Raman.RamanReading_Part4.CopyTo(_rawData, 1536);

            double white = _data[0..89].Min();//.Average();
            double black = _data[89..98].Max();//.Average();
            for (int i = 0; i < _data.Length; i++) _data[i] = Double.Clamp(Utils.Map((double)_rawData[i], black, white, 0.0, 1.0), 0.0, 1.0);

            await UpdateChartAsync();
            await InvokeAsync(StateHasChanged);
        });

        await UpdateChartAsync();

    }

    private async Task UpdateChartAsync()
    {
        // Reinitialize the chart config
        RamanChartConfig = new ScatterChartConfig()
        {
            Options = new Options()
            {
                Responsive = true,
                RegisterDataLabels = true,
                MaintainAspectRatio = false,
                Animation = false,
                Scales = new Dictionary<string, Axis>()
                {
                    {
                        Scales.XAxisId, new Axis()
                        {
                            Display = true,
                            Text = "Raman Shift (cm⁻¹)",
                            Color = "black",
                            Title = new AxesTitle()
                            {
                                Display = true,
                                Text = "Raman Shift (cm⁻¹)",
                                Color = "black"
                            }
                        }
                    },
                    {
                        Scales.YAxisId, new Axis()
                        {
                            Display = true,
                            Text = "Intensity",
                            Color = "black",
                            Title = new AxesTitle()
                            {
                                Display = true,
                                Text = "Intensity",
                                Color = "black"
                            }
                        }
                    }
                },
                Plugins = new Plugins()
                {
                    Legend = new Legend()
                    {
                        Display = true
                    }
                }
            }
        };

        RamanChartConfig.Data.Labels = Enumerable.Range(0, 2048).Select(i => i.ToString()).ToList();
        RamanChartConfig.Data.Datasets.Clear();

        // Add live raman data
        RamanChartConfig.Data.Datasets.Add(
            new ScatterDataset()
                {
                    Label = "Raman Spectrum",
                    Data = _rawData.Select((value, index) => new ScatterXYValue()
                    {
                        X = (decimal)index,
                        Y = (decimal)RemoveCosmicRaysAndBackground(_rawData, index)
                    }).ToList(),
                    BorderColor = "rgba(255, 0, 0, 1)",
                    BackgroundColor = "rgba(255, 0, 0, 0.5)",
                    PointRadius = (int)Math.Max(1, _dotSize),
                }
        );

        // Add raw raman reference data
        Random rand = new Random(Seed: 7);
        foreach (string graph in rawRamanGraphs.Keys)
        {
            int red = (int)(rand.NextSingle() * 255);
            int green = (int)(rand.NextSingle() * 255);
            int blue = (int)(rand.NextSingle() * 255);

            if (rawRamanGraphs.ContainsKey(graph) && rawGraphVisibility[graph])
            {
                var chartPoints = rawRamanGraphs[graph]
                    .Select(point => new ScatterXYValue()
                    {
                        X = (decimal)point.Item1,
                        Y = (decimal)point.Item2
                    })
                    .ToList();

                RamanChartConfig.Data.Datasets.Add(
                    new ScatterDataset()
                        {
                            Label = graph,
                            Data = chartPoints,
                            BorderColor = $"rgba({red}, {green}, {blue}, 1)",
                            BackgroundColor = $"rgba({red}, {green}, {blue}, 0.5)",
                            PointRadius = (int)Math.Max(1, _dotSize),
                        }
                );
            }
        }

        RamanChart?.ClearData();
    }

    private async Task DownloadCSV()
    {
        byte[] file = Encoding.ASCII.GetBytes(String.Join("\n", _rawData.Select((x, i) => $"{i},{x}")));
        await _IJSRuntime.InvokeVoidAsync("DownloadFile", $"Raman_{_acquiredAt}.csv", "application/octet-stream", file);
    }

    string ramanGraphListVisibility = "none";
    private void ToggleRamanGraphListVisibility()
    {
        if (ramanGraphListVisibility == "none")
        {
            ramanGraphListVisibility = "block";
        }
        else
        {
            ramanGraphListVisibility = "none";
        }
    }

    private async Task UpdateGraphVisibility(string graph, string filePath, ChangeEventArgs e)
    {
        if (rawGraphVisibility.ContainsKey(graph))
        {
            if (e.Value is bool isChecked) {
                rawGraphVisibility[graph] = isChecked;
                await UpdateChartAsync();
            }
        } else
        {
            rawRamanGraphs.Add(graph, LoadRamanDataFromFile(filePath));
            rawGraphVisibility.Add(graph, true);
            await UpdateChartAsync();
        }
    }

    private static string GetFirstWord(string fileName)
    {
        if (string.IsNullOrEmpty(fileName))
            return string.Empty;

        int underscoreIndex = fileName.IndexOf('_');

        if (underscoreIndex > 0)
        {
            return fileName.Substring(0, underscoreIndex);
        }

        // If no underscore is found, return the whole filename
        return fileName;
    }

    // Extracts raman data from file with ruff.net formatting
    private static List<(double Wavenumber, double Intensity)> LoadRamanDataFromFile(string filePath)
    {
        try
        {
            var dataPoints = new List<(double Wavenumber, double Intensity)>();

            foreach (string line in File.ReadLines(filePath))
            {
                string trimmed = line.Trim();

                // Skip empty lines and header/comment lines
                if (string.IsNullOrEmpty(trimmed) || trimmed.StartsWith("##"))
                {
                    continue;
                }

                // Split the line by comma (data format: wavenumber,intensity)
                string[] parts = trimmed.Split(',');

                if (parts.Length >= 2)
                {
                    string wavenumberStr = parts[0].Trim();
                    string intensityStr = parts[1].Trim();

                    if (double.TryParse(wavenumberStr, System.Globalization.NumberStyles.Float,
                                        System.Globalization.CultureInfo.InvariantCulture, out double wavenumber) &&
                        double.TryParse(intensityStr, System.Globalization.NumberStyles.Float,
                                        System.Globalization.CultureInfo.InvariantCulture, out double intensity))
                    {
                        dataPoints.Add((wavenumber, intensity));
                    }
                    else
                    {
                        Console.WriteLine($"Warning: Could not parse data line: '{trimmed}' in {filePath}");
                    }
                }
                else
                {
                    Console.WriteLine($"Warning: Invalid format on line: '{trimmed}' in {filePath}");
                }
            }

            if (dataPoints.Count == 0)
            {
                Console.WriteLine($"Warning: No valid Raman data points found in {filePath}");
            }
            else
            {
                Console.WriteLine($"Successfully loaded {dataPoints.Count} Raman data points from {filePath}");
            }

            return dataPoints;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading Raman data from file {filePath}: {ex.Message}");
            return new List<(double, double)>();
        }
    }

    private void ResetBackground()
    {
        _rawBackgroundSampleCount = 0;
        Array.Clear(_rawBackground, 0, _rawBackground.Length);

        UpdateChartAsync();
    }


    private void SetBackground()
    {
        for (int i = 0; i < _rawBackground.Length; ++i)
        {
            _rawBackground[i] = (ushort)((_rawBackground[i] * _rawBackgroundSampleCount + _rawData[i]) / (_rawBackgroundSampleCount + 1));
        }
        ++_rawBackgroundSampleCount;

        UpdateChartAsync();
    }

    private ushort RemoveCosmicRaysAndBackground(ushort[] data, int index)
    {
        if (_cosmicRayRemovalEnabled)
        {
            ushort current = (ushort)(_backgroundSubtractionEnabled ? data[index] - _rawBackground[index] : data[index]);

            if (index == 0) // Remove cosmic ray on the left edge of the spectrum.
            {
                ushort next = (ushort)(_backgroundSubtractionEnabled ? data[index + 1] - _rawBackground[index + 1] : data[index + 1]);
                ushort next2 = (ushort)(_backgroundSubtractionEnabled ? data[index + 2] - _rawBackground[index + 2] : data[index + 2]);

                if (current - (next + next2) / 2 > _cosmicRayThreshold)
                {
                    current = (ushort)((next + next2) / 2);
                }

                return current;
            }
            else if (index == 2047) // Remove cosmic ray on the right edge of the spectrum.
            {
                ushort previous = (ushort)(_backgroundSubtractionEnabled ? data[index - 1] - _rawBackground[index - 1] : data[index - 1]);
                ushort previous2 = (ushort)(_backgroundSubtractionEnabled ? data[index - 2] - _rawBackground[index - 2] : data[index - 2]);

                if (current - (previous + previous2) / 2 > _cosmicRayThreshold)
                {
                    current = (ushort)((previous + previous2) / 2);
                }

                return current;
            }
            else // Remove cosmic rays on the interior of the spectrum.
            {
                ushort previous = (ushort)(_backgroundSubtractionEnabled ? data[index - 1] - _rawBackground[index - 1] : data[index - 1]);
                ushort next = (ushort)(_backgroundSubtractionEnabled ? data[index + 1] - _rawBackground[index + 1] : data[index + 1]);

                if (current - (previous + next)/2 > _cosmicRayThreshold)
                {
                    current = (ushort)((previous + next) / 2);
                }

                return current;
            }
        }
        else
        {
            return (ushort)(_backgroundSubtractionEnabled ? data[index] - _rawBackground[index] : data[index]);
        }
    }
}