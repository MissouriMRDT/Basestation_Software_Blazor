@inject RoveCommService _RoveCommService
<div class="card h-100">
    <div class="card-header">
        <h5>Raman Spectroscopy Graph</h5>
    </div>
    <div class="card-body w-100">
        <p style="color: #f00">TODO: Graph</p>
        <button @onclick=@(async () => await _RoveCommService.SendAsync<uint>("Raman", "RequestRamanReading", [_integrationTime]))>Request Data</button>
        <button @onclick=Export> <i class="bi bi-filetype-csv"></i> </button>
        <div class="d-flex">
            <p>Integration Time:</p>
            <input type="number" @bind=_integrationTime>
        </div>
        <div class="d-flex">
            <p>Dot Size: </p>
            <input type="number" @bind=_dotSize>
        </div>
        <div class="d-flex">
            <p>Show Lines: </p>
            <input type="checkbox" @bind=_showLines>
        </div>
    </div>
</div>


@code {
    private float _dotSize = 2f;
    private bool _showLines = false;
    private uint _integrationTime;
    private List<ushort> _data = new();

    private void Export()
    {
        File.WriteAllLines("RamanExport_" + ((DateTimeOffset)DateTime.Now).ToUnixTimeMilliseconds() + ".csv", _data.Select(x => string.Join(",", x)));
    }

    protected override void OnInitialized()
    {
        // Initialize ramanGraph
        for (int i = 0; i < 2048; i++)
        {
            _data.Add(0);
        }

        //Receiving RoveComm packets if they are sent in
        _RoveCommService.On<ushort>("Raman", "RamanReading_Part1", async (packet) =>
        {
            for (int i = 0; i < 512; i++) _data[i] = packet.Data[i];
            await InvokeAsync(StateHasChanged);
        });

        _RoveCommService.On<ushort>("Raman", "RamanReading_Part2", async (packet) =>
        {
            for (int i = 0; i < 512; i++) _data[i + 512] = packet.Data[i];
            await InvokeAsync(StateHasChanged);
        });

        _RoveCommService.On<ushort>("Raman", "RamanReading_Part3", async (packet) =>
        {
            for (int i = 0; i < 512; i++) _data[i + 1024] = packet.Data[i];
            await InvokeAsync(StateHasChanged);
        });

        _RoveCommService.On<ushort>("Raman", "RamanReading_Part4", async (packet) =>
        {
            for (int i = 0; i < 512; i++) _data[i + 1536] = packet.Data[i];
            await InvokeAsync(StateHasChanged);
        });
    }
}