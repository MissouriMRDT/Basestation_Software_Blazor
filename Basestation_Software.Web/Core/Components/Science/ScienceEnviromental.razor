@inject RoveCommService _RoveCommService
<div class="component-header">
    <h3>Science Enviromental</h3>
</div>
<div class="component-body" style="display: grid; grid-template-columns: auto auto; gap: 2px; height: unset">
    <p>Temperature</p>
    <p>@_temperature&deg</p>
    <p>Humidity</p>
    <p>@_humidity%</p>
</div>

@code {
    private float _temperature = -1;
    private float _humidity = -1;

    protected override void OnInitialized()
    {
        _RoveCommService.On<float>("Auger", "Environmental", async (packet) =>
        {
            _temperature = (float)Math.Round(packet.Data[0], 2);
            _humidity = (float)Math.Round(packet.Data[1], 2);
            await InvokeAsync(StateHasChanged);
        });
    }
}