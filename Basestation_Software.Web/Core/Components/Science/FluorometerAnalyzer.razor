@inject RoveCommService _RoveCommService

<div class="component-header">
    <h3>Fluorometer Analyzer</h3>
</div>
<div class="component-body" style="display: grid; grid-template-rows:0% 50% 50%; height: 100%;">
    <video id="videoFeed" width="320" height="240" style="border:1px solid var(--secondary); width: 0px; height:0px; display: none;"/>
    <div style="display: grid; grid-template-columns: 50% 0px calc(50% - 0px); height:100%;">
        <div style="height: 100%;">
            <canvas style="width:100%; height: 100%;" id="currentFrame" width="320" height="240" />
        </div>
        <div>
        </div>
        <div style="border:1px solid var(--secondary); display:grid; grid-template-rows: 10% calc(90% - 25px) 25px; height: 100%;">
            <canvas id="compressed" style="width: 100%; height: 100%;" width="320" height="20"/>
            <div style="width: 100%; height: 100%; position: relative;" >
                <div style="position: absolute; width: 100%; height: 100%; display: grid; grid-template-columns: repeat(8, 1fr);">
                    @for (int i = 0; i < 8; i++)
                    {
                        <div style="box-sizing: border-box; border-left:1px solid var(--secondary); display:grid; grid-template-rows:repeat(10, 1fr);">
                            @for (int a = 0; a < 10; a++)
                            {
                                <div style="box-sizing: border-box; border-bottom:1px solid var(--secondary);"/>
                            }
                        </div>
                    }
                </div>
                <canvas id="graph" style="position: absolute; width: 100%; height: 100%;" width="320" height="240"/>
            </div>
            <div style="display: grid; grid-template-columns: repeat(8, 1fr);">
                <div style="box-sizing: border-box; border-left:1px solid var(--secondary);">350</div>
                <div style="box-sizing: border-box; border-left:1px solid var(--secondary);">400</div>
                <div style="box-sizing: border-box; border-left:1px solid var(--secondary);">450</div>
                <div style="box-sizing: border-box; border-left:1px solid var(--secondary);">500</div>
                <div style="box-sizing: border-box; border-left:1px solid var(--secondary);">550</div>
                <div style="box-sizing: border-box; border-left:1px solid var(--secondary);">600</div>
                <div style="box-sizing: border-box; border-left:1px solid var(--secondary);">650</div>
                <div style="box-sizing: border-box; border-left:1px solid var(--secondary);">700</div>
            </div>
        </div>
    </div>
</div>

<script>
    var crop = [0, 0, 320, 240];
    var mpos = [0, 0];
    var down1 = false;
    var down2 = false;
    var down3 = false;
    var down4 = false;
    var co = document.getElementById("currentFrame");
    document.addEventListener('mousemove', (e) => {mpos = [(e.clientX - co.getBoundingClientRect().left)/co.getBoundingClientRect().width, (e.clientY - co.getBoundingClientRect().top)/co.getBoundingClientRect().height]});
    document.addEventListener('mousedown', () => {
        if (mpos[0] < 20 / 320)
        {
            if (mpos[1] > (crop[1] - 10) / 240 && mpos[1] < (crop[1] + 10) / 240)
                down1 = true;
            else if (mpos[1] > (crop[3] + crop[1] - 10) / 240 && mpos[1] < (crop[1] + crop[3] + 10) / 240)
                down2 = true;
        }
        if (mpos[1] < 20 / 320)
        {
            if (mpos[0] > (crop[0] - 10) / 320 && mpos[0] < (crop[0] + 10) / 320)
                down3 = true;
            else if (mpos[0] > (crop[2] + crop[0] - 10) / 320 && mpos[0] < (crop[0] + crop[2] + 10) / 320)
                down4 = true;
        }
    }); 
    document.addEventListener('mouseup', () => {
        down1 = false;
        down2 = false;
        down3 = false;
        down4 = false;
    }); 

    function handleCrop(crop, canvas)
    {
        if (down1)
        {
            let temp = crop[3];
            crop[3] = Math.min(Math.max(crop[3] + (crop[1] - Math.max(mpos[1], 0) * 240), 50), 240);
            crop[1] = Math.max(Math.min(mpos[1] * (240), crop[1] + (temp - 50)), 0);
        }  
        else if (down2)
        {
            crop[3] = Math.min(Math.max((mpos[1] * 240) - crop[1], 50), 240 - crop[1]);
        }   
        else if (down3)
        {
            let temp = crop[2];
            crop[2] = Math.min(Math.max(crop[2] + (crop[0] - Math.max(mpos[0], 0) * 320), 50), 320);
            crop[0] = Math.max(Math.min(mpos[0] * (320), crop[0] + (temp - 50)), 0);
        }  
        else if (down4)
        {
            crop[2] = Math.min(Math.max((mpos[0] * 320) - crop[0], 50), 320 - crop[0]);
        }  

        canvas.strokeRect(crop[0], crop[1], crop[2], crop[3]);

        canvas.beginPath();
        canvas.moveTo(0, crop[1] - 10);
        canvas.lineTo(0, crop[1] + 10);
        canvas.lineTo(10, crop[1]);
        canvas.lineTo(0, crop[1] - 10);
        canvas.closePath();
        canvas.fill();

        canvas.beginPath();
        canvas.moveTo(0, crop[3] + crop[1] - 10);
        canvas.lineTo(0, crop[3] + crop[1] + 10);
        canvas.lineTo(10, crop[3] + crop[1]);
        canvas.lineTo(0, crop[3] + crop[1] - 10);
        canvas.closePath();
        canvas.fill();
        
        canvas.beginPath();
        canvas.moveTo(crop[0] - 10, 0);
        canvas.lineTo(crop[0] + 10, 0);
        canvas.lineTo(crop[0], 10);
        canvas.lineTo(crop[0] - 10, 0);
        canvas.closePath();
        canvas.fill();

        canvas.beginPath();
        canvas.moveTo(crop[2] + crop[0] - 10, 0);
        canvas.lineTo(crop[2] + crop[0] + 10, 0);
        canvas.lineTo(crop[2] + crop[0], 10);
        canvas.lineTo(crop[2] + crop[0] - 10, 0);
        canvas.closePath();
        canvas.fill();
    }

    function startAnalyzer(video)
    {
        let cce = document.getElementById("compressed");
        let gce = document.getElementById("graph");

        let c = document.getElementById("currentFrame").getContext("2d");
        let cc = document.getElementById("compressed").getContext("2d");
        let gc = document.getElementById("graph").getContext("2d");

        gc.strokeStyle = "rgb(255, 255, 255)";
        gc.fillStyle = "rgb(255, 255, 255)";
        gc.font = "20px serif";

        setInterval(() => {
            c.drawImage(video, 0, 0, 320, 240);
            c.strokeStyle = 'white';
            c.fillStyle = 'white';
            c.lineWidth = 1;

            let imData = c.getImageData(0, 0, 320, 240).data;

            handleCrop(crop, c, document.getElementById("currentFrame"));

            cce.width = crop[2];
            gce.width = crop[2];

            gc.clearRect(0, 0, 320, 240);

            for (let x = 0; x < crop[2]; x += 1)
            {
                let av = [0, 0, 0];
                for (let y = 0; y < crop[3]; y += 1)
                {
                    av[0] += imData[(x + Math.floor(crop[0])) * 4 + (y + Math.floor(crop[1])) * 320 * 4]; 
                    av[1] += imData[(x + Math.floor(crop[0])) * 4 + (y + Math.floor(crop[1])) * 320 * 4 + 1]; 
                    av[2] += imData[(x + Math.floor(crop[0])) * 4 + (y + Math.floor(crop[1])) * 320 * 4 + 2]; 
                }

                console.log(crop[0]);

                cc.strokeStyle = `rgb(${av[0]/crop[2]}, ${av[1]/crop[2]}, ${av[2]/crop[2]})`;                
                cc.beginPath();
                cc.moveTo(x, 0);
                cc.lineTo(x, 20);
                cc.lineWidth = 1;
                cc.stroke();

                let intensity = (av[0]/crop[3]) * .299 + (av[1]/crop[3]) * .587 + (av[2]/crop[3]) * .114;

                gc.strokeStyle = wavelengthToHex(350 + 400 * (x / crop[2]));
                gc.beginPath();
                gc.moveTo(x, 240);
                gc.lineTo(x, 240 - (intensity / 255) * 240);
                gc.lineWidth = 1;
                gc.stroke();
            }
        }, 100);
    }

    function startVideo(src) {
        if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
            navigator.mediaDevices.getUserMedia({ video: true }).then(function (stream) {
                let video = document.getElementById(src);
                if ("srcObject" in video) {
                    video.srcObject = stream;
                } else {
                    video.src = window.URL.createObjectURL(stream);
                }
                video.onloadedmetadata = function (e) {
                    video.play();
                };

                startAnalyzer(video);

                video.style.webkitTransform = "scaleX(-1)";
                video.style.transform = "scaleX(-1)";
            });
        }
    }

    startVideo("videoFeed");

    function wavelengthToHex(wavelength) {
        let r = 1, g = 1, b = 1;

        // 1. Approximate RGB from wavelength (380 - 780 nm)
        if (wavelength >= 380 && wavelength < 440) {
            r = -(wavelength - 440) / (440 - 380);
            g = 0.0;
            b = 1.0;
        } else if (wavelength >= 440 && wavelength < 490) {
            r = 0.0;
            g = (wavelength - 440) / (490 - 440);
            b = 1.0;
        } else if (wavelength >= 490 && wavelength < 510) {
            r = 0.0;
            g = 1.0;
            b = -(wavelength - 510) / (510 - 490);
        } else if (wavelength >= 510 && wavelength < 580) {
            r = (wavelength - 510) / (580 - 510);
            g = 1.0;
            b = 0.0;
        } else if (wavelength >= 580 && wavelength < 645) {
            r = 1.0;
            g = -(wavelength - 645) / (645 - 580);
            b = 0.0;
        } else if (wavelength >= 645 && wavelength <= 780) {
            r = 1.0;
            g = 0.0;
            b = 0.0;
        }

        // 2. Adjust intensity near the edges of the visible spectrum
        let factor = 0.0;
        if (wavelength >= 380 && wavelength < 420) {
            factor = 0.3 + 0.7 * (wavelength - 380) / (420 - 380);
        } else if (wavelength >= 420 && wavelength <= 700) {
            factor = 1.0;
        } else if (wavelength > 700 && wavelength <= 780) {
            factor = 0.3 + 0.7 * (780 - wavelength) / (780 - 700);
        } else {
            factor = .5;
        }

        // Convert floating point RGB (0-1) to 0-255 integers
        const toRgbInt = (color) => Math.round(color * factor * 255);
        
        const red = toRgbInt(r);
        const green = toRgbInt(g);
        const blue = toRgbInt(b);

        // 3. Convert RGB integers to a HEX string
        const toHex = (c) => c.toString(16).padStart(2, '0');
        return `#${toHex(red)}${toHex(green)}${toHex(blue)}`;
    }

</script>

