@implements IDisposable
@inject RoveCommService _RoveCommService

<div class="component-header" style="display: flex">
    <h3>Science Controls</h3>
    <div class="vr">&nbsp;</div>
    <input type="checkbox" @bind=OutputDisabled>
    <GamepadSelector @ref=_gamepadSelector OnUpdate=Update />
</div>
<div class="component-body">
    <GamepadScheme @ref=_gamepadScheme AxisNames=_axisNames ControlScheme=_scheme />
</div>

@code {
    // Member variables
    private bool OutputDisabled = false;
    private GamepadSelector? _gamepadSelector;
    private bool LastProcessGamepadInputOK = false;
    private GamepadScheme? _gamepadScheme;
    private ControlScheme _scheme = new(); // TODO: Set a good default control scheme as done in Gimbals.razor.
    private static readonly string[] _axisNames = []; // TODO: Set axis names.

    private async Task Update(Gamepad gamepad, float deltaT)
    {
        bool ProcessGamepadInputOK = await ProcessGamepadInput(gamepad, deltaT);
        if (ProcessGamepadInputOK)
        {
            // Set teleop if controller being used.
            _RoveCommService.Boards.Core.StateDisplay(0);
        }
        else if (LastProcessGamepadInputOK)
        {
            // TODO: do something safe when no longer getting input
        }
        LastProcessGamepadInputOK = ProcessGamepadInputOK;
        await InvokeAsync(StateHasChanged);
    }

    // Process gamepad input and return true if rovecomm packets were sent.
    private async Task<bool> ProcessGamepadInput(Gamepad gamepad, float deltaT)
    {
        // TODO: implement
        return false;
    }

    private float _augerMult = -1f;
    private float _augerAxisMult = -0.4f;
    private float _instrumentAxisMult = 0.4f;

    void IDisposable.Dispose() { }
}