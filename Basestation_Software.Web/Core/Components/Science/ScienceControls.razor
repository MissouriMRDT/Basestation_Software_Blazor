@inject RoveCommService _RoveCommService

<div class="component-header" style="display: flex">
    <h3>Science Controls</h3>
    <input type="checkbox" class="output-enabled" @bind=_outputEnabled />
    <GamepadSelector @ref=_gamepadSelector OnUpdate=Update />
</div>
<div class="component-body">
    <GamepadScheme @ref=_gamepadScheme AxisNames=_axisNames ControlScheme=_scheme />
    <div style="display: grid; grid-template-columns: 180px repeat(6, min-content); place-items: center">
        <p>Calibrate</p>
        <p style="grid-column: 2 / 4">L+</p>
        <p style="grid-column: 4 / 6">L-</p>
        <p>(in)</p>
        <p>CAN</p>
        <button @onclick=@(() => _RoveCommService.Boards.Auger.CalibrateEncoder())>Auger Gantry</button>
        <div style="width: 16px; height: 16px; background-color: #@((_RoveCommService.Boards.Auger.LimitSwitch & (1 << 0)) != 0 ? "fb0" : "520")"></div>
        <input type="checkbox" class="danger" @bind=_limitOverrides[0] @bind:after=@(() => _RoveCommService.Boards.Auger.LimitSwitchOverride((byte)((_limitOverrides[0] ? 1 : 0) | (_limitOverrides[1] ? 2 : 0)))) />
        <div style="width: 16px; height: 16px; background-color: #@((_RoveCommService.Boards.Auger.LimitSwitch & (1 << 1)) != 0 ? "fb0" : "520")"></div>
        <input type="checkbox" class="danger" @bind=_limitOverrides[1] @bind:after=@(() => _RoveCommService.Boards.Auger.LimitSwitchOverride((byte)((_limitOverrides[0] ? 1 : 0) | (_limitOverrides[1] ? 2 : 0)))) />
        <p>@($"{_RoveCommService.Boards.Auger.Position:00.0}")</p>
        <p>@(_RoveCommService.Boards.Auger.SMOCOPing < 500 ? "OK" : "ERR")</p>
        <button @onclick=@(() => _RoveCommService.Boards.Raman.CalibrateEncoder())>Instruments Gantry</button>
        <div style="width: 16px; height: 16px; background-color: #@((_RoveCommService.Boards.Raman.LimitSwitch & (1 << 0)) != 0 ? "fb0" : "520")"></div>
        <input type="checkbox" class="danger" @bind=_limitOverrides[2] @bind:after=@(() => _RoveCommService.Boards.Raman.LimitSwitchOverride((byte)((_limitOverrides[2] ? 1 : 0) | (_limitOverrides[3] ? 2 : 0)))) />
        <div style="width: 16px; height: 16px; background-color: #@((_RoveCommService.Boards.Raman.LimitSwitch & (1 << 1)) != 0 ? "fb0" : "520")"></div>
        <input type="checkbox" class="danger" @bind=_limitOverrides[3] @bind:after=@(() => _RoveCommService.Boards.Raman.LimitSwitchOverride((byte)((_limitOverrides[2] ? 1 : 0) | (_limitOverrides[3] ? 2 : 0)))) />
        <p>@($"{_RoveCommService.Boards.Raman.Position_InstrumentsAxis:00.0}")</p>
        <p>@(_RoveCommService.Boards.Raman.SMOCOPing < 500 ? "OK" : "ERR")</p>
    </div>
    <p>Auger @($"{_RoveCommService.Boards.Auger.AugerCurrent:00.00}A {_RoveCommService.Boards.Auger.AugerSpeed:000}rpm")</p>
    <div style="display: grid; grid-template-columns: repeat(4, max-content); place-items: center">
        <p>Soil Trapdoor</p>
        <button checked=@(_soilTrapdoorPosition == SoilTrapdorPositions[0]) @onclick=@(() => SoilTrapdoor(false))>AF</button>
        <button checked=@(_soilTrapdoorPosition == SoilTrapdorPositions[1]) @onclick=@(() => SoilTrapdoor(true))>Cache</button>
        <p>@($"{_soilTrapdoorPosition:000}")</p>
        <p></p>
        <p style="grid-column: 1 / 5">Autofluorescence</p>
        <p>Brightness</p>
        <p>LED</p>
        <p>Filter</p>
        <p>@($"{_afFilterPosition:000}")</p>
        <p></p>
        <button checked=@(_activeLED == -1) @onclick=@(() => LED(-1, false))>Off</button>
        <button checked=@(_afFilterPosition == AFFilterPositions[0]) @onclick=@(() => AFFilter(0))>None</button>
        <p>None</p>
        <input @bind=_brightness[1] @bind:after=@(() => LED(1, true)) type="range" min="0" max="255" step="1" />
        <button checked=@(_activeLED == 1) @onclick=@(() => LED(1, false))>365nm</button>
        <button checked=@(_afFilterPosition == AFFilterPositions[1]) @onclick=@(() => AFFilter(1))>440nm</button>
        <p>NAD</p>
        <input @bind=_brightness[2] @bind:after=@(() => LED(2, true)) type="range" min="0" max="255" step="1" />
        <button checked=@(_activeLED == 2) @onclick=@(() => LED(2, false))>405nm</button>
        <button checked=@(_afFilterPosition == AFFilterPositions[2]) style="--btn-fill: #2af371" @onclick=@(() => AFFilter(2))>525nm</button>
        <p>FAD</p>
        <input @bind=_brightness[3] @bind:after=@(() => LED(3, true)) type="range" min="0" max="255" step="1" />
        <button checked=@(_activeLED == 3) @onclick=@(() => LED(3, false))>500nm</button>
        <button checked=@(_afFilterPosition == AFFilterPositions[3]) style="--btn-fill: #dc3545" @onclick=@(() => AFFilter(3))>600nm</button>
        <p>Carotenoids</p>
    </div>
</div>

@code {
    // Member variables
    private bool _outputEnabled = true;
    private GamepadSelector? _gamepadSelector;
    private bool LastProcessGamepadInputOK = false;
    private GamepadScheme? _gamepadScheme;
    private ControlScheme _scheme = new()
    {
        Binds = [Bind.LSY, Bind.Triggers, Bind.RSY, Bind.Bumpers],
        Inversions = [false, false, false, false]
    };
    private static readonly string[] _axisNames = ["Auger Gantry", "Auger", "Instruments Gantry", "AF Filter"];
    bool[] _limitOverrides = new bool[4];
    byte[] _brightness = [255, 255, 255, 255];
    public static readonly short[] AFFilterPositions = [155, 10, 120, 45]; // None, 440nm, 525nm, 600nm, 620nm
    public static readonly short[] SoilTrapdorPositions = [15, 150]; // AF, Soil Cache
    private float _afFilterPosition = 100;
    private short _soilTrapdoorPosition = 100;
    private int _activeLED = -2;

    private async Task Update(Gamepad gamepad, float deltaT)
    {
        bool ProcessGamepadInputOK = await ProcessGamepadInput(gamepad, deltaT);
        if (ProcessGamepadInputOK)
        {
            // Set teleop if controller being used.
            _RoveCommService.Boards.Core.StateDisplay(0);
        }
        else if (LastProcessGamepadInputOK)
        {
            // Stop motors when input stops.
            _RoveCommService.Boards.Auger.AugerAxis(0);
            _RoveCommService.Boards.Auger.RunAuger(0);
            _RoveCommService.Boards.Raman.InstrumentsAxis(0);
        }
        LastProcessGamepadInputOK = ProcessGamepadInputOK;
        await InvokeAsync(StateHasChanged);
    }

    // Process gamepad input and return true if rovecomm packets were sent.
    private async Task<bool> ProcessGamepadInput(Gamepad gamepad, float deltaT)
    {
        if (!gamepad.Connected || _gamepadScheme == null) return false;
        float[] inputs = _gamepadScheme.Update(gamepad);

        _afFilterPosition = Math.Clamp(_afFilterPosition + inputs[3] * 25 * deltaT, 0, 180);

        if (!_outputEnabled) return false;

        _RoveCommService.Boards.Auger.AugerAxis((short)Math.Clamp(inputs[0] * short.MaxValue, short.MinValue, short.MaxValue));
        _RoveCommService.Boards.Auger.RunAuger((short)Math.Clamp(inputs[1] * 1000, -1000, 1000));
        _RoveCommService.Boards.Raman.InstrumentsAxis((short)Math.Clamp(inputs[2] * short.MaxValue, short.MinValue, short.MaxValue));

        if (inputs[3] != 0) _RoveCommService.Boards.Auger.AugerServo((short)_afFilterPosition, _soilTrapdoorPosition);

        return true;
    }

    private void LED(int i, bool updateBrightness)
    {
        if (updateBrightness && _activeLED != i) return;
        _activeLED = i;
        switch (_activeLED)
        {
            case 0:
                _RoveCommService.Boards.Auger.LED(255, 0, 0, 0);
                break;
            case 1:
                _RoveCommService.Boards.Auger.LED(0, _brightness[1], 0, 0);
                break;
            case 2:
                _RoveCommService.Boards.Auger.LED(0, 0, _brightness[2], 0);
                break;
            case 3:
                _RoveCommService.Boards.Auger.LED(0, 0, 0, _brightness[3]);
                break;
            default:
                _RoveCommService.Boards.Auger.LED(0, 0, 0, 0);
                break;
        }
    }

    private void AFFilter(int i)
    {
        if (i < 0 || i >= AFFilterPositions.Length) return;
        _afFilterPosition = AFFilterPositions[i];
        if (_outputEnabled) _RoveCommService.Boards.Auger.AugerServo((short)_afFilterPosition, _soilTrapdoorPosition);
    }

    private void SoilTrapdoor(bool cache)
    {
        _soilTrapdoorPosition = SoilTrapdorPositions[cache ? 1 : 0];
        if (_outputEnabled) _RoveCommService.Boards.Auger.AugerServo((short)_afFilterPosition, _soilTrapdoorPosition);
    }
}