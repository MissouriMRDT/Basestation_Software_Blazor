@implements IDisposable
@inject RoveCommService _RoveCommService

<style>
    p {
    width: 110px;
    text-align: right;
    margin-bottom: 0;
    }

    .controlBox {
    display: flex;
    column-gap: 0.6rem;
    row-gap: 0.1rem;
    justify-items: center;
    flex: 0 1 160px;
    flex-wrap: wrap;
    border-radius: 10px;
    background-color: var(--bs-secondary-bg);
    margin: 0.2rem;
    padding: 0.3rem;
    }

    .break {
    flex-basis: 100%;
    height: 0;
    }

</style>

<div class="card full-height">
    <div class="card-header" style="display: flex">
        <h3>Science Controls</h3>
        <div class="vr">&nbsp;</div>
        <InputSelect @bind-Value=@SelectedScheme>
            @foreach (var value in Enum.GetValues<Scheme>())
            {
                <option value="@value">@value</option>
            }
        </InputSelect>
        <GamepadSelector @ref=GamepadSelector_ ChangedCallback=GamepadSelectionChanged />
    </div>
    <div class="card-body">
        <div class="rounded p-2 justify-items-center bg-body-secondary mb-2">
            <p style="width:auto; text-align: center"><b>Calibration</b></p>
            <div class="btn-group d-flex justify-items-center" role="group">
                <button class="btn btn-primary" @onclick=@(() => _RoveCommService.SendAsync<byte>("Auger", "CalibrateEncoder", [1]))>AugerAxis</button>
                <button class="btn btn-primary" @onclick=@(() => _RoveCommService.SendAsync<byte>("Raman", "CalibrateEncoder", [1]))>InstrumentsAxis</button>
            </div>
        </div>

        <div class="rounded p-2 justify-items-center bg-body-secondary mb-2">
            <p style="width:auto; text-align: center"><b>UV LED</b></p>
            <div class="btn-group d-flex justify-items-center" role="group">
                <button class="btn btn-primary" @onclick=@(() => _RoveCommService.SendAsync<byte>("Auger", "UVLED", [1]))>On</button>
                <button class="btn btn-primary" @onclick=@(() => _RoveCommService.SendAsync<byte>("Auger", "UVLED", [0]))>Off</button>
            </div>
        </div>

        <div class="rounded p-2 justify-items-center bg-body-secondary mb-2">
            <p style="width:auto; text-align: center"><b>Laser</b></p>
            <div class="btn-group d-flex justify-items-center" role="group">
                <button class="btn btn-primary" @onclick=@(() => _RoveCommService.SendAsync<byte>("Raman", "Laser", [1]))>On</button>
                <button class="btn btn-primary" @onclick=@(() => _RoveCommService.SendAsync<byte>("Raman", "Laser", [0]))>Off</button>
            </div>
        </div>

        <div class="rounded p-2 justify-items-center bg-body-secondary mb-2">
            <p style="width:auto; text-align: center"><b>Watchdog Override</b></p>
            <div class="btn-group d-flex justify-items-center" role="group">
                <button class="btn btn-primary" @onclick=@(() => _RoveCommService.SendAsync<byte>("Auger", "WatchdogOverride", [1]))>On</button>
                <button class="btn btn-primary" @onclick=@(() => _RoveCommService.SendAsync<byte>("Auger", "WatchdogOverride", [0]))>Off</button>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between;">
            <div style="display:flex; gap: 0.6rem">
                <p>Poll Interval (ms):</p>
                <RadzenTextBox Change="UpdateInterval" Value="50" Style="width: 25%"></RadzenTextBox>
            </div>
        </div>

        <div style="display:flex; gap:0.6rem; align-items: center; margin-block: 0.1rem 0.5rem">
            <p>Dead Zone: </p>
            <RadzenSlider @bind-Value=@DeadZone TValue="double" Min="0" Max="(decimal)0.5" Step="0.001" />
            <RadzenNumeric TValue="double" Min="0" Max="(decimal)0.5" Step="0.001" @bind-Value=@DeadZone></RadzenNumeric>
        </div>

        <div style="display: flex; flex-wrap: wrap; justify-content: center;">
            <div class="controlBox">
                <p>Invert AugerAxis</p>
                <RadzenCheckBox TValue="bool" />
                <div class="break"></div>
                <select class="form-select-sm w-100" @bind=AugerAxisBind name="ControlBind">
                    @foreach (Bind bind in Bind.GetValues(typeof(Bind)))
                    {
                        <option value="@bind">@bind</option>
                    }
                </select>
                <div style="display: flex; width:100%">
                    <meter value="@meterValues[0]" min="-1.0" max="1.0" style="width: 100%" />
                </div>

            </div>
            <div class="controlBox">
                <p>Invert InstrumentsAxis</p>
                <RadzenCheckBox TValue="bool" />
                <div class="break"></div>
                <select class="form-select-sm w-100" @bind=InstrumentsAxisBind name="ControlBind">
                    @foreach (Bind bind in Bind.GetValues(typeof(Bind)))
                    {
                        <option value="@bind">@bind</option>
                    }
                </select>
                <div style="display: flex; width:100%">
                    <meter value="@meterValues[1]" min="-1.0" max="1.0" style="width: 100%" />
                </div>

            </div>
            <div class="controlBox">
                <p>Invert Auger</p>
                <RadzenCheckBox TValue="bool" />
                <div class="break"></div>
                <select class="form-select-sm w-100" @bind=AugerBind name="ControlBind">
                    @foreach (Bind bind in Bind.GetValues(typeof(Bind)))
                    {
                        <option value="@bind">@bind</option>
                    }
                </select>
                <div style="display: flex; width:100%">
                    <meter value="@meterValues[2]" min="-1.0" max="1.0" style="width: 100%" />
                </div>

            </div>
            <div class="controlBox">
                <p>Invert Microscope</p>
                <RadzenCheckBox TValue="bool" />
                <div class="break"></div>
                <select class="form-select-sm w-100" @bind=MicroscopeBind name="ControlBind">
                    @foreach (Bind bind in Bind.GetValues(typeof(Bind)))
                    {
                        <option value="@bind">@bind</option>
                    }
                </select>
                <div style="display: flex; width:100%">
                    <meter value="@meterValues[3]" min="-1.0" max="1.0" style="width: 100%" />
                </div>

            </div>
            <div class="controlBox">
                <p>Invert Gimbal Pan</p>
                <RadzenCheckBox TValue="bool" />
                <div class="break"></div>
                <select class="form-select-sm w-100" @bind=GimbalPanBind name="ControlBind">
                    @foreach (Bind bind in Bind.GetValues(typeof(Bind)))
                    {
                        <option value="@bind">@bind</option>
                    }
                </select>
                <div style="display: flex; width:100%">
                    <meter value="@meterValues[4]" min="-1.0" max="1.0" style="width: 100%" />
                </div>

            </div>
            <div class="controlBox">
                <p>Invert Gimbal Tilt</p>
                <RadzenCheckBox TValue="bool" />
                <div class="break"></div>
                <select class="form-select-sm w-100" @bind=GimbalTiltBind name="ControlBind">
                    @foreach (Bind bind in Bind.GetValues(typeof(Bind)))
                    {
                        <option value="@bind">@bind</option>
                    }
                </select>
                <div style="display: flex; width:100%">
                    <meter value="@meterValues[5]" min="-1.0" max="1.0" style="width: 100%" />
                </div>

            </div>
        </div>

    </div>
</div>

@code {
    // Available arm control schemes
    enum Scheme
    {
        ScienceXbox,
    }

    // Gamepade inputs are put in a list for rebinding.
    enum Bind
    {
        LSX = 0,
        LSY,
        RSX,
        RSY,
        AB,
        XY,
        Bumpers,
        Triggers,
        DpadX,
        DpadY
    }

    private void UpdateInterval(string args)
    {
        Console.WriteLine(args);
        if (GamepadSelector_.SelectedGamepad == null)
            UpdateTimer.Change(-1, -1);
        else
            UpdateTimer.Change(0, int.Parse(args));
    }

    /// <summary>
    /// Returns an array of input values in range [-1, 1] for possible joint control setups on an xinput gamepad. Value indexes are based on the Bind enum
    /// </summary>
    /// <param name="gamepad"></param>
    /// <returns></returns>
    private double[] GetBindableGamepadInputs(Toolbelt.Blazor.Gamepad.Gamepad gamepad)
    {
        double[] gamepadInputs = [
            gamepad.Axes[0],
    gamepad.Axes[1],
    gamepad.Axes[2],
    gamepad.Axes[3],
    gamepad.Buttons[0].Value - gamepad.Buttons[1].Value,
    gamepad.Buttons[2].Value - gamepad.Buttons[3].Value,
    gamepad.Buttons[4].Value - gamepad.Buttons[5].Value,
    gamepad.Buttons[6].Value - gamepad.Buttons[7].Value,
    gamepad.Buttons[14].Value - gamepad.Buttons[15].Value,
    gamepad.Buttons[12].Value - gamepad.Buttons[13].Value

        ];

        return gamepadInputs;
    }

    // Member variables
    private GamepadSelector GamepadSelector_;
    private Scheme SelectedScheme;
    public const int UPDATE_INTERVAL = 100;
    private Timer UpdateTimer;
    private bool LastProcessGamepadInputOK = false;
    private double DeadZone = 0.5;
    Bind AugerAxisBind = Bind.LSY;
    Bind InstrumentsAxisBind = Bind.LSX;
    Bind AugerBind = Bind.Bumpers;
    Bind MicroscopeBind = Bind.Triggers;
    Bind GimbalPanBind = Bind.RSX;
    Bind GimbalTiltBind = Bind.RSY;
    double[] meterValues = [0d, 0d, 0d, 0d, 0d, 0d];
    private float _microscopeTilt = 0;

    public void GamepadSelectionChanged()
    {
        if (GamepadSelector_.SelectedGamepad == null)
            UpdateTimer.Change(-1, -1);
        else
            UpdateTimer.Change(0, UPDATE_INTERVAL);
    }

    protected override void OnInitialized()
    {
        // Run update function every 100ms
        UpdateTimer = new(Update);
    }

    private void Update(object? _)
    {
        bool ProcessGamepadInputOK = ProcessGamepadInput();
        if (ProcessGamepadInputOK)
        {
            // set teleop if controller being used
            _RoveCommService.Send<byte>("Core", "StateDisplay", new List<byte>() { 0 });
        }
        LastProcessGamepadInputOK = ProcessGamepadInputOK;
        InvokeAsync(StateHasChanged);
    }

    // Process gamepad input and return true if rovecomm packets were sent.
    private bool ProcessGamepadInput()
    {
        if (GamepadSelector_.SelectedGamepad is null) return false;
        switch (SelectedScheme)
        {
            case Scheme.ScienceXbox:
                {
                    // Controller check
                    if (GamepadSelector_.SelectedGamepad.Axes.Count < 4 || GamepadSelector_.SelectedGamepad.Buttons.Count < 17) return false;

                    double[] inputValues = GetBindableGamepadInputs(GamepadSelector_.SelectedGamepad);

                    float[] bindedInputs = [
                        (float)inputValues[(int)AugerAxisBind], 
            (float)inputValues[(int)InstrumentsAxisBind],
                (float)inputValues[(int)AugerBind], 
                (float)inputValues[(int)MicroscopeBind], 
                (float)inputValues[(int)GimbalPanBind],
                (float)inputValues[(int)GimbalTiltBind]
                    ];

                    // sanitize inputs
                    for (int i = 0; i < bindedInputs.Length; i++)
                    {
                        meterValues[i] = bindedInputs[i];
                        bindedInputs[i] = (Math.Abs(bindedInputs[i]) < DeadZone) ? 0f : bindedInputs[i];
                    }

                    // send rovecomm packets
                    if (bindedInputs[0] != 0) _ = _RoveCommService.SendAsync("Auger", "AugerAxis_IncrementPosition", [bindedInputs[0]]);
                    if (bindedInputs[1] != 0) _ = _RoveCommService.SendAsync("Raman", "InstrumentsAxis_IncrementPosition", [bindedInputs[1]]);
                    _ = _RoveCommService.SendAsync("Auger", "Auger", [(short)(bindedInputs[2] * 1000f)]);
                    _microscopeTilt = Math.Clamp(0, _microscopeTilt + bindedInputs[3] * 2.5f, 180);
                    // _ = _RoveCommService.SendAsync("Raman", "Microscope", [(byte)(_microscopeTilt)]);

                    if (bindedInputs[4] != 0 || bindedInputs[5] != 0) _ = _RoveCommService.SendAsync("Auger", "AugerGimbalIncrement", [(short)(bindedInputs[4]), (short)(bindedInputs[5])]);

                    break;
                }
            default: return false;
        }

        return true;
    }


    void IDisposable.Dispose() { }
}