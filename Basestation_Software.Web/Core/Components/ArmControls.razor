@using Basestation_Software.Models.Arm
@implements IDisposable
@inject RoveCommService _RoveCommService
@inject ArmSpeedState _ArmSpeedState

<style>
    p {
        width: 110px; 
        text-align: right; 
        margin-bottom: 0;
    }

    .jointBox {
        display: flex;
        gap: 0.6rem;
        justify-items: center;
        flex: 0 1 160px;
        border-radius: 10px;
        background-color: lightgray;
        margin: 0.2rem;
        padding: 0.3rem;
    }

</style>

<div class="card full-height">
    <div class="card-header" style="display: flex">
        <h3>Arm Controls</h3>
        <div class="vr">&nbsp;</div>
        <InputSelect @bind-Value=@SelectedScheme>
            @foreach (var value in Enum.GetValues<Scheme>())
            {
                <option value="@value">@value</option>
            }
        </InputSelect>
        <GamepadSelector @ref=GamepadSelector_ ChangedCallback=GamepadSelectionChanged />
    </div>
    <div class="card-body">
        <div style="display:flex; gap:0.6rem;">
            <RadzenCheckBox TValue="bool" Value="true" bind-Value=@UpdateIndividualJoints />
            <p style="width: auto">Control Joints Individually</p>
        </div>
        <div style="display:flex; gap:0.6rem; align-items: center; margin-block: 0.1rem 0.5rem">
            <p>Dead Zone: </p>
            <RadzenSlider @bind-Value=@DeadZone TValue="double" Min="0" Max="(decimal)0.5" Step="0.001" />
            <RadzenNumeric TValue="double" Min="0" Max="(decimal)0.5" Step="0.001" @bind-Value=@DeadZone></RadzenNumeric>
        </div>

        <div style="display: flex; flex-wrap: wrap; justify-content: center;">
            @foreach (JointNames joint in JointNames.GetValues(typeof(JointNames)))
            {
                <div class="jointBox">
                    <p>Invert @joint</p>
                    <RadzenCheckBox TValue="bool" @bind-value=@isJointInverted[(int)joint - 1]/>
                </div>
            }
        </div>

    </div>
</div>

@code {
    // Available arm control schemes
    enum Scheme
    {
        XboxDecipercents,
        XboxTargetAngles,
    }

    // Member variables
    private GamepadSelector GamepadSelector_;
    private Scheme SelectedScheme;
    public const int UPDATE_INTERVAL = 100;
    private Timer UpdateTimer;
    private bool LastProcessGamepadInputOK = false;
    private double DeadZone = 0.05;
    bool UpdateIndividualJoints = true;
    List<bool> isJointInverted = [false, false, false, false, false, false];


    public void GamepadSelectionChanged()
    {
        if (GamepadSelector_.SelectedGamepad == null)
            UpdateTimer.Change(-1, -1);
        else
            UpdateTimer.Change(0, UPDATE_INTERVAL);
    }

    protected override void OnInitialized()
    {
        // Run update function every 100ms
        UpdateTimer = new(Update);
    }

    private void Update(object? _)
    {
        bool ProcessGamepadInputOK = ProcessGamepadInput();
        if (ProcessGamepadInputOK)
        {
            // set teleop if controller being used
            _RoveCommService.Send<byte>("Core", "StateDisplay", new List<byte>() { 0 });
        }
        else if (LastProcessGamepadInputOK)
        {
            // Stop arm speeds
            _ = _RoveCommService.SendAsync<float>("Arm", "SetIndividualSpeeds", [0f, 0f, 0f, 0f, 0f, 0f]);
        }
        LastProcessGamepadInputOK = ProcessGamepadInputOK;
        InvokeAsync(StateHasChanged);
    }

    // Process gamepad input and return true if rovecomm packets were sent.
    private bool ProcessGamepadInput()
    {
        double[] jointInputs = [0, 0, 0, 0, 0, 0];
        if (GamepadSelector_.SelectedGamepad is null) return false;
        switch(SelectedScheme)
        {
            case Scheme.XboxDecipercents:
                {
                    // Controller check
                    if (GamepadSelector_.SelectedGamepad.Axes.Count < 4 || GamepadSelector_.SelectedGamepad.Buttons.Count < 17) return false;

                    // Left Stick X (Axis0): X
                    jointInputs[0] = GamepadSelector_.SelectedGamepad.Axes[0];
                    // Left Stick Y (Axis1): J2
                    jointInputs[1] = GamepadSelector_.SelectedGamepad.Axes[1];
                    // Right Stick X (Axis2): J3
                    jointInputs[2] = GamepadSelector_.SelectedGamepad.Axes[2];
                    // Right Stick Y (Axis3): J4
                    jointInputs[3] = GamepadSelector_.SelectedGamepad.Axes[2];
                    // Left Trigger (Button6): -Pitch
                    jointInputs[4] -= GamepadSelector_.SelectedGamepad.Buttons[6].Value;
                    // Right Trigger (Button7): +Pitch
                    jointInputs[4] += GamepadSelector_.SelectedGamepad.Buttons[7].Value;
                    // A (Button0): +Roll
                    jointInputs[5] += GamepadSelector_.SelectedGamepad.Buttons[0].Value;
                    // B (Button1): -Roll
                    jointInputs[5] -= GamepadSelector_.SelectedGamepad.Buttons[6].Value;

                    // sanitize based on dead zone and apply multipliers
                    for (int i = 0; i < jointInputs.Length; i++)
                    {
                        jointInputs[i] = (jointInputs[i] < DeadZone) ? 0d : 
                            jointInputs[i] * _ArmSpeedState.ArmSpeeds.Values.ToArray()[i] * (isJointInverted[i] ? -1f : 1f);
                    }

                    if (UpdateIndividualJoints)
                    {
                        for (int i = 0; i < jointInputs.Length; i++)
                        {
                           if (jointInputs[i] != 0d) _ = _RoveCommService.SendAsync<float>("Arm", "SetJointSpeed", [(float)i+1, (float)jointInputs[i]]);
                        }
                    }
                    else
                    {
                        _ = _RoveCommService.SendAsync<float>("Arm", "SetIndividualSpeeds", Array.ConvertAll(jointInputs, j => (float) j).ToList());
                    }

                    break;
                }
            case Scheme.XboxTargetAngles:
                {
                    // Controller check
                    if (GamepadSelector_.SelectedGamepad.Axes.Count < 4 || GamepadSelector_.SelectedGamepad.Buttons.Count < 17) return false;

                    // Left Stick X (Axis0): X
                    jointInputs[0] = GamepadSelector_.SelectedGamepad.Axes[0];
                    // Left Stick Y (Axis1): J2
                    jointInputs[1] = GamepadSelector_.SelectedGamepad.Axes[1];
                    // Right Stick X (Axis2): J3
                    jointInputs[2] = GamepadSelector_.SelectedGamepad.Axes[2];
                    // Right Stick Y (Axis3): J4
                    jointInputs[3] = GamepadSelector_.SelectedGamepad.Axes[2];
                    // Left Trigger (Button6): -Pitch
                    jointInputs[4] -= GamepadSelector_.SelectedGamepad.Buttons[6].Value;
                    // Right Trigger (Button7): +Pitch
                    jointInputs[4] += GamepadSelector_.SelectedGamepad.Buttons[7].Value;
                    // A (Button0): +Roll
                    jointInputs[5] += GamepadSelector_.SelectedGamepad.Buttons[0].Value;
                    // B (Button1): -Roll
                    jointInputs[5] -= GamepadSelector_.SelectedGamepad.Buttons[6].Value;

                    // sanitize based on dead zone and apply multipliers
                    for (int i = 0; i < jointInputs.Length; i++)
                    {
                        jointInputs[i] = (jointInputs[i] < DeadZone) ? 0d :
                            jointInputs[i] * (isJointInverted[i] ? -1f : 1f);
                    }

                    if (UpdateIndividualJoints)
                    {
                        for (int i = 0; i < jointInputs.Length; i++)
                        {
                            if (jointInputs[i] != 0d) _ = _RoveCommService.SendAsync<float>("Arm", "IncrementJointTargetAngle", [(float)i + 1, (float)jointInputs[i]]);
                        }
                    }
                    else
                    {
                        _ = _RoveCommService.SendAsync<float>("Arm", "IncrementIndividualTargetAngles", Array.ConvertAll(jointInputs, j => (float)j).ToList());
                    }

                    break;
                }
            default: return false;
        }

        return true;
    }


    void IDisposable.Dispose() { }
}
