@inject RoveCommService _RoveCommService

<style>
    .pair {
    display: flex;
    gap: 0.3rem;
    }

    p {
    align-self: center;
    }
</style>

<div class="card full-height">
    <div class="card-header">
        <h3>Lighting</h3>
    </div>
    <div class="card-body">
        <div style="display:flex; justify-content:center; gap: 0.75rem">
            <div class="pair">
                <p style="width: 20px; text-align: right">R</p>
                <input type="number" Min="0" Max="255" Width="50%" @bind-value=@colorComponents[0]></input>
            </div>

            <div class="pair">
                <p style="width: 20px; text-align: right">G</p>
                <input type="number" Min="0" Max="255" @bind-value=@colorComponents[1]></input>
            </div>        

            <div class="pair">
                <p style="width: 20px; text-align: right">B</p>
                <input type="number" Min="0" Max="255" @bind-value=@colorComponents[2]></input>
            </div>

            <div class="pair">
                <p style="width: 20px; text-align: right">A</p>
                <input type="number" Min="0" Max="255" @bind-value=@brightness></input>
            </div>
            <button class="btn btn-primary" style="justify-self:center;" @onclick="Send">Send</button>
			<div style="width: 50px; height: 50px; background-color: rgb(@colorComponents[0], @colorComponents[1], @colorComponents[2])"></div>
        </div>
    </div>
</div>

@code {
    private List<short> colorComponents = [0, 0, 0];
    private short brightness = 0;

    private void Send()
    {
		Console.WriteLine("ACK! LIGHTS!");
        _ = _RoveCommService.SendAsync<short>("Core", "LEDRGB", colorComponents);
        _ = _RoveCommService.SendAsync<short>("Core", "Brightness", [brightness]);
    }
}
