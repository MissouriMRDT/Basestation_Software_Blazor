@implements IDisposable
@using Basestation_Software.Web.Models;
@attribute [ComponentAttributes.Ignore]

<style>
    .component-options {
        position: absolute;
        top: 10vh;
        left: 10vh;
        right: 10vh;
        z-index: 2000;
        display: grid;
        grid-auto-rows: max-content;
        grid-template-columns: 1fr 9fr;
        font-size: 2vh;
        background-color: var(--bs-secondary-bg);
        color: var(--bs-body-color);
        border: 2px solid var(--bs-border-color);
        place-items: center left;
    }

    .component-options>* {
        font-size: 2vh;
        margin: 5px;
    }

    .component-options input {
        border: 2px solid var(--bs-border-color);
        place-self: stretch;
        color: var(--bs-body-color);
    }

    .component-options button {
        border: none;
        place-self: stretch;
    }

    .component-options-open {
        width: 30px;
        height: 30px;
        background: none;
        border: none;
        z-index: 20;
    }
</style>

<div style="display: flex; position: absolute;">
    <button @onclick=Open class="component-options-open" title="Component Options"><img src="/icons/pencil.svg"></button>

</div>
@if (Visible)
{
    <div class="component-options">
        <p>X</p>
        <input @bind=X>
        <p>Y</p>
        <input @bind=Y>
        <p>Width</p>
        <input @bind=Width>
        <p>Height</p>
        <input @bind=Height>
        <p>Type</p>
        <select @bind="@Type_">
            @foreach (var typename in GetComponentTypeNames())
            {
                <option value="@typename">@typename</option>
            }
        </select>
        <p>PlaceSelf</p>
        <input @bind=PlaceSelf>
        <button @onclick=Delete class="btn btn-danger" title="Delete Component"><img src="icons/trash.svg"></button>
        <button @onclick=Save class="btn btn-success" title="Save"><img src="icons/floppy.svg"></button>
    </div>
}

@code
{
    // Component parameters
    [Parameter]
    public List<Component> Components { get; set; } = [];
    [Parameter]
    public int ComponentIndex { get; set; }
    [Parameter]
    public EventCallback OnSaved { get; set; }

    // State
    private bool Visible = false;
    private int X, Y, Width, Height;
    private string Type_ = "", PlaceSelf = "";

    protected override void OnInitialized()
    {
    }

    private void Open()
    {
        X = (int)Components[ComponentIndex].X;
        Y = (int)Components[ComponentIndex].Y;
        Width = (int)Components[ComponentIndex].Width;
        Height = (int)Components[ComponentIndex].Height;
        Type_ = Components[ComponentIndex].Type;
        PlaceSelf = Components[ComponentIndex].PlaceSelf;
        Visible = true;
    }

    private async Task Delete()
    {
        Components.RemoveAt(ComponentIndex);
        Visible = false;
        await OnSaved.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task Save()
    {
        if (X >= 0) Components[ComponentIndex].X = (uint)X;
        if (Y >= 0) Components[ComponentIndex].Y = (uint)Y;
        if (Width >= 0) Components[ComponentIndex].Width = (uint)Width;
        if (Height >= 0) Components[ComponentIndex].Height = (uint)Height;
        Components[ComponentIndex].Type = Type_;
        Components[ComponentIndex].PlaceSelf = PlaceSelf;
        Visible = false;
        await OnSaved.InvokeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private static List<string> GetComponentTypeNames()
    {
        List<string> names = Assembly.GetExecutingAssembly()
        .GetTypes()
        .Where(
        type => type.FullName != null && type.FullName.StartsWith("Basestation_Software.Web.Core.Components")
        && type.IsSubclassOf(typeof(ComponentBase))
        && !type.IsDefined(typeof(ComponentAttributes.Ignore))
        ).Select(type => type.FullName!.Substring("Basestation_Software.Web.Core.Components".Length + 1)).ToList();
        names.Sort();
        return names;
    }

    void IDisposable.Dispose() { }
}