<div class="component-header">
    <h3>ThemeChanger</h3>
</div>
<div class="component-body">
   <button class="success" @onclick=@DarkMode><i class="bi-moon" /></button>
</div>

<style>
    body {
        --bg-color: @bgColor;
        --text-color: @textColor;
        --border: @border
    }
</style>


@code{
    private string bgColor = "#FFF";
    private string textColor = "#000";
    private string border = "#000";
    protected async Task DarkMode(){
        bgColor = (bgColor=="#FFF"? "#000": "#FFF");
        textColor = (textColor=="#000"? "#FFF": "#000");
        border = (border=="#000"? "blue": "#000"); 
    }
}


