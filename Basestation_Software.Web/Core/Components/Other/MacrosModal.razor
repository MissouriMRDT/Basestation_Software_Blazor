@using Microsoft.EntityFrameworkCore
@using Basestation_Software.Web.Core.Services
@using Basestation_Software.Web.Models

@inject DatabaseContext DbContext
@inject DatabaseService DatabaseService

@attribute [ComponentAttributes.Ignore]


<div class="macros-modal" tabindex="-1" @onkeydown="CaptureKey">
    <Modal @ref="_modal">
        <Header>
            <h5 class="modal-title">Set Keybinds</h5>
        </Header>

        <Body>
            <div class="Keybinds">
                <div class="keybind">
                    <p>moveLeft</p>
                    <button type="button" class="update-button" @onclick="() => BeginKeybind(KeybindAction.MoveLeft)" aria-label="Set move-left keybind">
                        <i class="bi-arrow-left" aria-hidden="true"></i>
                    </button>
                    @GetKeybindDisplay(KeybindAction.MoveLeft)
                </div>

                <div class="keybind">
                    <p>moveRight</p>
                    <button type="button" class="update-button" @onclick="() => BeginKeybind(KeybindAction.MoveRight)" aria-label="Set move-right keybind">
                        <i class="bi-arrow-right" aria-hidden="true"></i>
                    </button>
                    @GetKeybindDisplay(KeybindAction.MoveRight)
                </div>

                <div class="keybind">
                    <p>packetToggle</p>
                    <button type="button" class="update-button" @onclick="() => BeginKeybind(KeybindAction.PacketToggle)" aria-label="Set packet-toggle keybind">
                        <i class="bi-toggle-on" aria-hidden="true"></i>
                    </button>
                    @GetKeybindDisplay(KeybindAction.PacketToggle)
                </div>

                <div class="keybind">
                    <p>newComponent</p>
                    <button type="button" class="update-button" @onclick="() => BeginKeybind(KeybindAction.NewComponent)" aria-label="Set new-component keybind">
                        <i class="bi-node-plus" aria-hidden="true"></i>
                    </button>
                    @GetKeybindDisplay(KeybindAction.NewComponent)
                </div>

                <div class="keybind">
                    <p>resubscribe</p>
                    <button type="button" class="update-button" @onclick="() => BeginKeybind(KeybindAction.Resubscribe)" aria-label="Set resubscribe keybind">
                        <img src="/images/rovecomm-sil.png" alt="" style="height: 8px">
                    </button>
                    @GetKeybindDisplay(KeybindAction.Resubscribe)
                </div>

                <div class="keybind">
                    <p>newPage</p>
                    <button type="button" class="update-button" @onclick="() => BeginKeybind(KeybindAction.NewPage)" aria-label="Set new-page keybind">
                        <i class="bi-file-earmark-plus" aria-hidden="true"></i>
                    </button>
                    @GetKeybindDisplay(KeybindAction.NewPage)
                </div>

                <div class="keybind">
                    <p>deletePage</p>
                    <button type="button" class="update-button" @onclick="() => BeginKeybind(KeybindAction.DeletePage)" aria-label="Set delete-page keybind">
                        <i class="bi-trash" aria-hidden="true"></i>
                    </button>
                    @GetKeybindDisplay(KeybindAction.DeletePage)
                </div>

                <div class="keybind">
                    <p>openCopyArea</p>
                    <button type="button" class="update-button" @onclick="() => BeginKeybind(KeybindAction.OpenCopyArea)" aria-label="Set edit-page keybind">
                        <i class="bi-pencil" aria-hidden="true"></i>
                    </button>
                    @GetKeybindDisplay(KeybindAction.OpenCopyArea)
                </div>

                <div class="keybind">
                    <p>openMacrosModal</p>
                    <button type="button" class="update-button" @onclick="() => BeginKeybind(KeybindAction.OpenMacrosModal)" aria-label="Set edit-macros keybind">
                        <i class="bi-pencil" aria-hidden="true"></i>
                    </button>
                    @GetKeybindDisplay(KeybindAction.OpenMacrosModal)
                </div>

                <div class="keybind">
                    <p>savePage</p>
                    <button type="button" class="update-button" @onclick="() => BeginKeybind(KeybindAction.SavePage)" aria-label="Set save-page keybind">
                        <i class="bi-floppy" aria-hidden="true"></i>
                    </button>
                    @GetKeybindDisplay(KeybindAction.SavePage)
                </div>

                <div class="keybind">
                    <p>luna</p>
                    <button type="button" class="update-button" @onclick="() => BeginKeybind(KeybindAction.Luna)" aria-label="Set Luna keybind">
                        <i class="bi-moon" aria-hidden="true"></i>
                    </button>
                    @GetKeybindDisplay(KeybindAction.Luna)
                </div>

                <div class="keybind">
                    <p>toggleLightMode</p>
                    <button type="button" class="update-button" @onclick="() => BeginKeybind(KeybindAction.ToggleLightMode)" aria-label="Set light-mode keybind">
                        <i class="bi-sun" aria-hidden="true"></i>
                    </button>
                    @GetKeybindDisplay(KeybindAction.ToggleLightMode)
                </div>
            </div>
        </Body>

        <Footer>
            <button type="button" class="success" @onclick="SaveAndClose">Save</button>
            <button type="button" class="danger" @onclick="CloseAsync">Close</button>
        </Footer>
    </Modal>
</div>

@code {
    private Modal _modal = default!;

    private string GetKeybindDisplay(KeybindAction action) =>
    string.IsNullOrEmpty(_keybinds[action]) ? "Set key" : _keybinds[action];

    public enum KeybindAction { MoveLeft, MoveRight, PacketToggle, NewComponent, Resubscribe, NewPage, DeletePage, OpenCopyArea, OpenMacrosModal, SavePage, Luna, ToggleLightMode }
    private KeybindAction? _pendingKeybind;

    private void BeginKeybind(KeybindAction action) => _pendingKeybind = action;
    private readonly Dictionary<KeybindAction, string> _keybinds =
        Enum.GetValues<KeybindAction>()
            .ToDictionary(action => action, _ => string.Empty);
    
    private void CaptureKey(KeyboardEventArgs e)
    {
        if (_pendingKeybind is not { } action)
            return;

        if (e.Key == "Escape")
            UnbindPendingKey();
        else
        {
            _keybinds[action] = e.Key;
            _pendingKeybind = null;
        }
    }

    public async Task OpenAsync()
    {
        var settings = await DbContext.Keybinds.FirstOrDefaultAsync();

        if (settings != null)
        {
            _keybinds[KeybindAction.MoveLeft] = settings.MoveLeft;
            _keybinds[KeybindAction.MoveRight] = settings.MoveRight;
            _keybinds[KeybindAction.PacketToggle] = settings.PacketToggle;
            _keybinds[KeybindAction.NewComponent] = settings.NewComponent;
            _keybinds[KeybindAction.Resubscribe] = settings.Resubscribe;
            _keybinds[KeybindAction.NewPage] = settings.NewPage;
            _keybinds[KeybindAction.DeletePage] = settings.DeletePage;
            _keybinds[KeybindAction.OpenCopyArea] = settings.OpenCopyArea;
            _keybinds[KeybindAction.OpenMacrosModal] = settings.OpenMacrosModal;
            _keybinds[KeybindAction.SavePage] = settings.SavePage;
            _keybinds[KeybindAction.Luna] = settings.Luna;
            _keybinds[KeybindAction.ToggleLightMode] = settings.ToggleLightMode;
        }

        _modal.Open();
    }

    private async Task SaveAndClose()
    {
        var settings = await DbContext.Keybinds.FirstOrDefaultAsync();

        if (settings == null)
        {
            settings = new Keybind();
            DbContext.Keybinds.Add(settings);
        }

        settings.MoveLeft = _keybinds[KeybindAction.MoveLeft];
        settings.MoveRight = _keybinds[KeybindAction.MoveRight];
        settings.PacketToggle = _keybinds[KeybindAction.PacketToggle];
        settings.NewComponent = _keybinds[KeybindAction.NewComponent];
        settings.Resubscribe = _keybinds[KeybindAction.Resubscribe];
        settings.NewPage = _keybinds[KeybindAction.NewPage];
        settings.DeletePage = _keybinds[KeybindAction.DeletePage];
        settings.OpenCopyArea = _keybinds[KeybindAction.OpenCopyArea];
        settings.OpenMacrosModal = _keybinds[KeybindAction.OpenMacrosModal];
        settings.SavePage = _keybinds[KeybindAction.SavePage];
        settings.Luna = _keybinds[KeybindAction.Luna];
        settings.ToggleLightMode = _keybinds[KeybindAction.ToggleLightMode];

        await DbContext.SaveChangesAsync(DatabaseService);

        await _modal.Close();
    }

    private async Task CloseAsync()
    {
        await _modal.Close();
    }

    public void UnbindPendingKey()
    {
        if (_pendingKeybind is not { } action)
            return;

        _keybinds[action] = string.Empty;
        _pendingKeybind = null;
    }
}
