@implements IDisposable
@inject IJSRuntime _IJSRuntime
@attribute [ComponentAttributes.Ignore]

<button @onclick=Update>Update</button>
<select @bind=_selectedIndex>
    <option value="-1">None</option>
    @for (int i = 0; i < _ids.Count; i++)
    {
        <option value="@i">@_ids[i]</option>
    }
</select>

@code
{
    // State
    private List<string> _ids = new();
    private int _selectedIndex = -1;
    private Gamepad _selectedGamepad = new();
    private Dictionary<int, bool> LastPressed = new Dictionary<int, bool>();

    // Returns true if the button is pressed now and wasn't the last time this was called.
    // Uses the state of the gamepad from the last time GetGamepad was called.
    public bool SoftwareDebounce(int buttonIndex)
    {
        if (buttonIndex < 0 || buttonIndex >= _selectedGamepad.Pressed.Length) return false;
        bool pressed = _selectedGamepad.Pressed[buttonIndex];
        if (pressed && !LastPressed.GetValueOrDefault(buttonIndex, false))
        {
            LastPressed[buttonIndex] = pressed;
            return true;
        }
        LastPressed[buttonIndex] = pressed;
        return false;
    }

    private async Task Update()
    {
        await GetGamepad();
        await InvokeAsync(StateHasChanged);
    }

    private class GetGamepadReturn
    {
        public List<string> IDs { get; set; } = [];
        public Gamepad Gamepad { get; set; } = new();
    }

    // Must be called from within OnAfterRenderAsync.
    public async Task<Gamepad> GetGamepad()
    {
        try
        {
            GetGamepadReturn value = await _IJSRuntime.InvokeAsync<GetGamepadReturn>("window.gamepads.getGamepad", _selectedIndex);
            _ids = value.IDs;
            _selectedGamepad = value.Gamepad;
        }
        catch
        {
            _ids.Clear();
            _selectedGamepad.Connected = false;
        }
        return _selectedGamepad;
    }

    void IDisposable.Dispose() { }

}