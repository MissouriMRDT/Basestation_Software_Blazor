<div class="component-header">
    <h3>Gamepad Test</h3>
    <div class="vr">&nbsp;</div>
    <GamepadSelector @ref=_gamepadSelector />
</div>
<div class="component-body">
    <p>Connected: @_gamepad.Connected</p>
    <table>
        <tr>
            <th>Axis</th>
            <th>Value</th>
        </tr>
        @for (int i = 0; i < _gamepad.Axes.Length; i++)
        {
            <tr>
                <td>@i</td>
                <td>@_gamepad.Axes[i]</td>
            </tr>
        }
        <tr>
            <th>Button</th>
            <th>Value</th>
            <th>Pressed</th>
        </tr>
        @for (int i = 0; i < _gamepad.Values.Length; i++)
        {
            <tr>
                <td>@i</td>
                <td>@_gamepad.Values[i]</td>
                <td>@_gamepad.Pressed[i]</td>
            </tr>
        }
    </table>
</div>

@code
{
    private GamepadSelector? _gamepadSelector;
    private Gamepad _gamepad = new();

    Timer _updateTimer;

    public GamepadTest()
    {
        _updateTimer = new(async _ =>
        {
            if (_gamepadSelector != null)
                _gamepad = await _gamepadSelector.GetGamepad();
            await InvokeAsync(StateHasChanged);
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            _updateTimer.Change(0, 100);
    }
}