<div class="component-header">
    <h3>Gamepad Test</h3>
    <div class="vr">&nbsp;</div>
    <GamepadSelector @ref=_gamepadSelector />
</div>
<div class="component-body">
    @if (_gamepadSelector?.SelectedGamepad != null)
    {
        <table>
            <tr>
                <th>Axis</th>
                <th>Value</th>
            </tr>
            @for (int i = 0; i < _gamepadSelector.SelectedGamepad.Axes.Count; i++)
            {
                <tr>
                    <td>@i</td>
                    <td>@_gamepadSelector.SelectedGamepad.Axes[i]</td>
                </tr>
            }
            <tr>
                <th>Button</th>
                <th>Value</th>
                <th>Pressed</th>
            </tr>
            @for (int i = 0; i < _gamepadSelector.SelectedGamepad.Buttons.Count; i++)
            {
                <tr>
                    <td>@i</td>
                    <td>@_gamepadSelector.SelectedGamepad.Buttons[i].Value</td>
                    <td>@_gamepadSelector.SelectedGamepad.Buttons[i].Pressed</td>
                </tr>
            }
        </table>
    }
</div>

@code
{
    // State
    private GamepadSelector? _gamepadSelector;

    Timer _updateTimer;

    public GamepadTest()
    {
        _updateTimer = new(_ =>
        {
            InvokeAsync(StateHasChanged);
        });
    }

    protected override void OnInitialized()
    {
        _updateTimer.Change(0, 100);
    }
}