@using System.Diagnostics
<div class="component-header">
    <h3>Gamepad Test</h3>
    <div class="vr">&nbsp;</div>
    <GamepadSelector @ref=_gamepadSelector OnUpdate=Update />
</div>
<div class="component-body">
    <p>DeltaT (s): @_deltaT</p>
    <p>Connected: @_gamepad.Connected</p>
    <table>
        <tr>
            <th>Axis</th>
            <th>Value</th>
        </tr>
        @for (int i = 0; i < _gamepad.Axes.Length; i++)
        {
            <tr>
                <td>@i</td>
                <td>@_gamepad.Axes[i]</td>
            </tr>
        }
        <tr>
            <th>Button</th>
            <th>Value</th>
            <th>Pressed</th>
        </tr>
        @for (int i = 0; i < _gamepad.Values.Length; i++)
        {
            <tr>
                <td>@i</td>
                <td>@_gamepad.Values[i]</td>
                <td>@_gamepad.Pressed[i]</td>
            </tr>
        }
    </table>
</div>

@code
{
    private GamepadSelector? _gamepadSelector;
    private Gamepad _gamepad = new();
    float _deltaT;

    private async Task Update(Gamepad gamepad, float deltaT)
    {
        _gamepad = gamepad;
        _deltaT = deltaT;
        await InvokeAsync(StateHasChanged);
    }
}