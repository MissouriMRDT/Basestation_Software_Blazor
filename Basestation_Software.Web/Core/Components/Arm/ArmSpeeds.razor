@inject RoveCommService _RoveCommService
@inject ArmService _armService

<div class="component-header">
    <h3>Arm Speeds</h3>
</div>
<div class="component-body">
    <button class="danger" @onclick=EStopArm>ESTOP</button>
    <button class="danger" @onclick=UnEStopArm>UNESTOP</button>
    <div style="display: grid; align-items: center; grid-template-columns: min-content auto 40px">
        @foreach (string joint in _armService.ArmSpeeds.Keys)
        {
            <p style="align-self: right">@joint</p>
            <input type="range" min="0.0" max="20.0" step="0.1" @bind=_armService.ArmSpeeds[joint]>
            <input @bind=@_armService.ArmSpeeds[joint]>
        }
    </div>
</div>

@code {

    protected override async Task OnInitializedAsync()
    {
        _armService.SubscribeToArmSpeedChanged(OnSpeedsChanged);
        await InvokeAsync(StateHasChanged);
    }

    private async void OnSpeedsChanged(Dictionary<string, float> speeds)
    {
        await InvokeAsync(StateHasChanged);
    }

    private void EStopArm()
    {
        _RoveCommService.Boards.Arm.EStop(1);
    }
    private void UnEStopArm()
    {
        _RoveCommService.Boards.Arm.ClosedLoopOverride(0);
    }
}