@using Microsoft.EntityFrameworkCore
@using System.Diagnostics
@implements IDisposable
@inject RoveCommService _RoveCommService
@inject DatabaseService _databaseService
@inject IDbContextFactory<DatabaseContext> _dbContextFactory
@inject OpService _opService

<div class="component-header">
    <h3>Arm Controls</h3>
    <div class="vr">&nbsp;</div>
    <input type="checkbox" @bind=OutputDisabled>
    <select @bind=_controlMode>
        @foreach (ControlMode mode in Enum.GetValues<ControlMode>())
        {
            <option value="@mode">@mode</option>
        }
    </select>
    <GamepadSelector @ref=_gamepadSelector OnUpdate=Update />
</div>
<div class="component-body">
    <div>
        <label>Preset:</label>
        <select @bind:get=@(_preset.ID) @bind:set=LoadPreset>
            @foreach (ArmPreset preset in _presets)
            {
                <option value=@preset.ID>@preset.Name</option>
            }
        </select>
        <input @bind=_preset.Name>
        <button class="success" @onclick=NewPreset><i class="bi-plus" /></button>
        <button class="success" @onclick=SavePreset><i class="bi-floppy" /></button>
        <button class="danger" @onclick=DeletePreset><i class="bi-trash" /></button>
    </div>
    <button class="warning" @onclick=@(() => _controlMode = ControlMode.Stop)>STOP</button>
    <button class="danger" @onclick=@(() => _RoveCommService.Boards.PMS.DisableBus(1 << 3))>ESTOP</button>
    <button class="warning" @onclick=@(() => _RoveCommService.Boards.PMS.EnableBus(1 << 3))>UNESTOP</button>
    <div style="display: grid; align-items: center; grid-template-columns: min-content auto 40px">
        <p style="align-self: right">X</p><input type="range" min="0.0" max="20.0" step="0.1" @bind=_preset.XSpeed><input @bind=_preset.XSpeed>
        <p style="align-self: right">Y</p><input type="range" min="0.0" max="20.0" step="0.1" @bind=_preset.YSpeed><input @bind=_preset.YSpeed>
        <p style="align-self: right">Z</p><input type="range" min="0.0" max="20.0" step="0.1" @bind=_preset.ZSpeed><input @bind=_preset.ZSpeed>
        <p style="align-self: right">J2</p><input type="range" min="0.0" max="20.0" step="0.1" @bind=_preset.J2Speed><input @bind=_preset.J2Speed>
        <p style="align-self: right">J3</p><input type="range" min="0.0" max="20.0" step="0.1" @bind=_preset.J3Speed><input @bind=_preset.J3Speed>
        <p style="align-self: right">J4</p><input type="range" min="0.0" max="20.0" step="0.1" @bind=_preset.J4Speed><input @bind=_preset.J4Speed>
        <p style="align-self: right">Pitch</p><input type="range" min="0.0" max="20.0" step="0.1" @bind=_preset.PitchSpeed><input @bind=_preset.PitchSpeed>
        <p style="align-self: right">Roll</p><input type="range" min="0.0" max="20.0" step="0.1" @bind=_preset.RollSpeed><input @bind=_preset.RollSpeed>
        <p style="align-self: right">Gripper</p><input type="range" min="0.0" max="20.0" step="0.1" @bind=_preset.GripperSpeed><input @bind=_preset.GripperSpeed>
        <p style="align-self: right">Linear Servo</p><input type="range" min="0.0" max="20.0" step="0.1" @bind=_preset.LinearServoSpeed><input @bind=_preset.LinearServoSpeed>
        <p style="align-self: right">Cache</p><input type="range" min="0.0" max="20.0" step="0.1" @bind=_preset.CacheSpeed><input @bind=_preset.CacheSpeed>
    </div>
    <GamepadScheme @ref=_gamepadScheme AxisNames=_axisNames ControlScheme=_preset />
    <div style="display: grid; grid-template-columns: repeat(9, min-content); place-items: stretch; text-align: center">
        <p style="grid-column: 1 / 10">Limit Status and Override</p>
        <p></p>
        <p style="grid-column: 2 / 6; border-right: 1px solid black">Limit Switch</p>
        <p style="grid-column: 6 / 10">Soft Limit</p>
        <p></p>
        <p style="grid-column: 2 / 4; border-right: 1px solid black">+</p>
        <p style="grid-column: 4 / 6; border-right: 1px solid black">-</p>
        <p style="grid-column: 6 / 8; border-right: 1px solid black">+</p>
        <p style="grid-column: 8 / 10">-</p>
        @for (int _i = 0; _i < _limitNames.Length; _i++)
        {
            int i = _i;
            <p style="width:30px">@_limitNames[i]</p>
            <div style="width: 16px; height: 16px; background-color: #@(_limitSwitchDepressed[i * 2] ? "990" : "888")"></div>
            <input type="checkbox" @bind=@(_hardLimitOverrides[i * 2])>
            <div style="width: 16px; height: 16px; background-color: #@(_limitSwitchDepressed[i * 2 + 1] ? "990" : "888")"></div>
            <input type="checkbox" @bind=@(_hardLimitOverrides[i * 2 + 1])>
            <div style="width: 16px; height: 16px; background-color: #@(_softLimitTriggered[i * 2] ? "990" : "888")"></div>
            <input type="checkbox" @bind=@(_softLimitOverrides[i * 2])>
            <div style="width: 16px; height: 16px; background-color: #@(_softLimitTriggered[i * 2 + 1] ? "990" : "888")"></div>
            <input type="checkbox" @bind=@(_softLimitOverrides[i * 2 + 1])>
        }
        <button class="success" style="grid-column: 2 / 6" @onclick=@(() => { ushort mask = 0; for (int i = 0; i < _hardLimitOverrides.Length; i++) { mask |= (ushort)((_hardLimitOverrides[i] ? 1 : 0) << i); } _RoveCommService.Boards.Arm.LimitSwitchOverride(mask); })><i class="bi-send" /></button>
        <button class="success" style="grid-column: 6 / 10" @onclick=@(() => { ushort mask = 0; for (int i = 0; i < _softLimitOverrides.Length; i++) { mask |= (ushort)((_softLimitOverrides[i] ? 1 : 0) << i); } _RoveCommService.Boards.Arm.SoftLimitOverride(mask); })><i class="bi-send" /></button>
    </div>
</div>

@code {
    enum ControlMode
    {
        Stop,
        OpenLoop,
        TargetAngles,
        InverseKinematics
    }

    // Member variables
    private bool OutputDisabled = false;
    private GamepadSelector? _gamepadSelector;
    private GamepadScheme? _gamepadScheme;
    private static readonly string[] _axisNames = ["X", "Y", "Z", "J2", "J3", "J4", "Pitch", "Roll", "Gripper", "Linear Servo", "Laser", "Cache"];
    private ControlMode _controlMode;

    private bool _lastProcessGamepadInputOK = false;
    private bool[] _hardLimitOverrides = new bool[10];
    private bool[] _softLimitOverrides = new bool[10];
    private bool[] _limitSwitchDepressed = new bool[10];
    private bool[] _softLimitTriggered = new bool[10];
    private static readonly string[] _limitNames = ["X", "J2", "J3", "J4", "P"];

    private bool _laser = false;
    private float _linearServo = 0;
    private float _cache = 0;
    private float[] _lastInputs = new float[12];
    private ArmAxes _target = new();
    private ArmAxes _position = new();

    private List<ArmPreset> _presets = [];
    private ArmPreset _preset = new();

    protected override async Task OnInitializedAsync()
    {
        _databaseService.SubscribeToTableChanges(typeof(ArmPreset), UpdatePresets);
        _RoveCommService.Boards.Arm.OnPosition(packet =>
        {
            _position.SetFromArm(_RoveCommService.Boards.Arm);
            // Set target to non-controlled axes so the target matches the current position when the control mode changes.
            switch (_controlMode)
            {
                case ControlMode.TargetAngles:
                    _target.Y = _position.Y;
                    _target.Z = _position.Z;
                    break;
                case ControlMode.InverseKinematics:
                    _target.J4 = _position.J4;
                    _target.Pitch = _position.Pitch;
                    _target.Roll = _position.Roll;
                    break;
                default:
                    _target.X = _position.X;
                    _target.J2 = _position.J2;
                    _target.J3 = _position.J3;
                    _target.J4 = _position.J4;
                    _target.Pitch = _position.Pitch;
                    _target.Roll = _position.Roll;
                    _target.Y = _position.Y;
                    _target.Z = _position.Z;
                    break;
            }

            return Task.CompletedTask;
        });
        await UpdatePresets();
    }

    private async Task Update(Gamepad gamepad, float deltaT)
    {
        bool ProcessGamepadInputOK = await ProcessGamepadInput(gamepad, deltaT);
        if (ProcessGamepadInputOK)
        {
            // Set teleop if controller being used
            _opService.SetTeleop();
        }
        else if (_lastProcessGamepadInputOK)
        {
            // Stop Arm
            _RoveCommService.Boards.Arm.OpenLoop(0, 0, 0, 0, 0, 0);
            _RoveCommService.Boards.Arm.GripperOpenLoop(0);
        }
        _lastProcessGamepadInputOK = ProcessGamepadInputOK;
        await InvokeAsync(StateHasChanged);
    }

    // Process gamepad input and return true if rovecomm packets were sent.
    private async Task<bool> ProcessGamepadInput(Gamepad gamepad, float deltaT)
    {
        if (!gamepad.Connected || _gamepadScheme == null) return false;
        float[] inputs = _gamepadScheme.Update(gamepad);

        if (OutputDisabled) return false;

        _RoveCommService.Boards.Arm.GripperOpenLoop(inputs[8] * _preset.LinearServoSpeed);
        _linearServo += inputs[9] * _preset.LinearServoSpeed * deltaT;
        if (Math.Abs(inputs[9]) > 0) _RoveCommService.Boards.Arm.LinearServo((byte)_linearServo);
        // Toggle the laser if the axis rises above 0.5.
        if (inputs[10] > 0.5 && _lastInputs[10] <= 0.5)
        {
            _laser = !_laser;
            _RoveCommService.Boards.Arm.Laser(_laser ? (byte)0 : (byte)1);
        }
        _cache += inputs[11] * _preset.CacheSpeed * deltaT;
        if (Math.Abs(inputs[11]) > 0) _RoveCommService.Boards.Arm.Cache((byte)_cache);

        switch (_controlMode)
        {
            case ControlMode.OpenLoop:
                {
                    _RoveCommService.Boards.Arm.OpenLoop(
                    (short)Math.Clamp(inputs[0] * _preset.XSpeed * short.MaxValue, short.MinValue, short.MaxValue),
                    (short)Math.Clamp(inputs[3] * _preset.J2Speed * short.MaxValue, short.MinValue, short.MaxValue),
                    (short)Math.Clamp(inputs[4] * _preset.J3Speed * short.MaxValue, short.MinValue, short.MaxValue),
                    (short)Math.Clamp(inputs[5] * _preset.J4Speed * short.MaxValue, short.MinValue, short.MaxValue),
                    (short)Math.Clamp(inputs[6] * _preset.PitchSpeed * short.MaxValue, short.MinValue, short.MaxValue),
                    (short)Math.Clamp(inputs[7] * _preset.RollSpeed * short.MaxValue, short.MinValue, short.MaxValue)
                    );
                    break;
                }
            case ControlMode.TargetAngles:
                {
                    _target.X += inputs[0] * _preset.XSpeed * deltaT;
                    _target.J2 += inputs[3] * _preset.J2Speed * deltaT;
                    _target.J3 += inputs[4] * _preset.J3Speed * deltaT;
                    _target.J4 += inputs[5] * _preset.J4Speed * deltaT;
                    _target.Pitch += inputs[6] * _preset.PitchSpeed * deltaT;
                    _target.Roll += inputs[7] * _preset.RollSpeed * deltaT;
                    _RoveCommService.Boards.Arm.TargetAngle(_target.X, _target.J2, _target.J3, _target.J4, _target.Pitch, _target.Roll);
                    break;
                }
            case ControlMode.InverseKinematics:
                {
                    _target.X += inputs[0] * _preset.XSpeed * deltaT;
                    _target.Y += inputs[1] * _preset.YSpeed * deltaT;
                    _target.Z += inputs[2] * _preset.ZSpeed * deltaT;
                    _target.J4 += inputs[5] * _preset.J4Speed * deltaT;
                    _target.Pitch += inputs[6] * _preset.PitchSpeed * deltaT;
                    _target.Roll += inputs[7] * _preset.RollSpeed * deltaT;
                    _RoveCommService.Boards.Arm.IKPosition(_target.X, _target.Y, _target.Z, _target.J4, _target.Pitch, _target.Roll);
                    break;
                }
            default: return false;
        }
        return true;
    }

    private async Task UpdatePresets()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        _presets = await databaseContext.ControlPresets.ToListAsync();
        await LoadPreset(_preset.ID);
    }

    private async Task NewPreset()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        _preset.ID = Guid.NewGuid();
        databaseContext.ControlPresets.Add(_preset);
        await databaseContext.SaveChangesAsync(_databaseService);
    }

    private async Task SavePreset()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        databaseContext.ControlPresets.Update(_preset);
        await databaseContext.SaveChangesAsync(_databaseService);
    }

    private async Task DeletePreset()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        databaseContext.ControlPresets.Remove(_preset);
        await databaseContext.SaveChangesAsync(_databaseService);
    }

    private async Task LoadPreset(Guid value)
    {
        ArmPreset? preset = _presets.Find(preset => preset.ID == value);
        if (preset == null)
        {
            if (_presets.Count == 0) { await NewPreset(); return; }
            preset = _presets[0];
        }
        _preset = preset;
        await InvokeAsync(StateHasChanged);
    }

    void IDisposable.Dispose()
    {
        _databaseService.UnsubscribeFromTableChanges(typeof(ArmPreset), UpdatePresets);
    }
}