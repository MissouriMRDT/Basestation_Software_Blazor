﻿@using System.Diagnostics
@inject RoveCommService _RoveCommService
@inject OpService _OpService
@using System.Numerics

<div class="component-header">
    <h3>Advanced Autonomous Typing</h3>
</div>

<div class="component-body">
    <div style="display: flex; flex-direction: column; justify-content: center; align-items: center">
        <p class="font-monospace fs-3">@_phrase</p>
        <p>@_statusMessage</p>
        <progress max="1" value=@_charStatusMeter class="progress"></progress>
    </div>

    <div style="display: flex; gap: 2px; justify-content: center">
        <input @bind:get=_phrase @bind:set=@(value => { _phrase = value.ToUpper(); }) />
        <button @onclick=@(async () => { if (!_running) await Start(); else await Stop(); }) checked=@_running>@(_running ? "Stop" : "Start")</button>
        <button @onclick=ResetCache>Reset Cache</button>
    </div>

    <div style="display: grid; grid-template-columns: auto auto auto; text-align: center; padding: 0.5rem;">
        <button @onclick=CacheQ checked=@(_keyCacheQ != null)>@(_keyCacheQ == null ? "Cache" : "Cached") Q</button>
        <button @onclick=CacheP checked=@(_keyCacheP != null)>@(_keyCacheP == null ? "Cache" : "Cached") P</button>
        <button @onclick=CacheZ checked=@(_keyCacheZ != null)>@(_keyCacheZ == null ? "Cache" : "Cached") Z</button>
    </div>
</div>

@code {
    private CancellationTokenSource _cts = new();
    private bool _running = false;
    private string _phrase = "";
    private string _statusMessage = "Idle";
    private float _charStatusMeter = 0;

    private Dictionary<char, Vector2> _keyPositions = new();

    // X, Pitch
    private Vector2? _keyCacheQ = null;
    private Vector2? _keyCacheP = null;
    private Vector2? _keyCacheZ = null;

    private void CacheQ() => _keyCacheQ = new Vector2(_RoveCommService.Boards.Arm.Position_X, _RoveCommService.Boards.Arm.Position_J5);
    private void CacheP() => _keyCacheP = new Vector2(_RoveCommService.Boards.Arm.Position_X, _RoveCommService.Boards.Arm.Position_J5);
    private void CacheZ() => _keyCacheZ = new Vector2(_RoveCommService.Boards.Arm.Position_X, _RoveCommService.Boards.Arm.Position_J5);

    private void ResetCache()
    {
        _keyCacheQ = null;
        _keyCacheP = null;
        _keyCacheZ = null;
    }

    private async Task Start()
    {
        if (_running) Stop();
        try
        {
            _cts = new();
            _running = true;
            _charStatusMeter = 0;
            await InvokeAsync(StateHasChanged);
            _OpService.SetAutonomy();
            // Make sure watchdog is disabled
            _RoveCommService.Boards.Arm.WatchdogOverride(1);
            await Task.Run(PlayPhrase, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            _statusMessage = "Stopped";
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _OpService.SetNone();
            _RoveCommService.Boards.Arm.WatchdogOverride(0);
            _running = false;
            _charStatusMeter = 0;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Stop()
    {
        _cts.Cancel();
        _statusMessage = "Stopped";
        _OpService.SetNone();
        _RoveCommService.Boards.Arm.WatchdogOverride(0);
        _running = false;
        _charStatusMeter = 0;
        await InvokeAsync(StateHasChanged);
    }

    private async Task PlayPhrase()
    {
        // Start with linear servo retracted
        _RoveCommService.Boards.Arm.LinearServo(100);
        await Task.Delay(3000, _cts.Token);
        // Check that reference keys are cached
        if (_keyCacheQ == null || _keyCacheP == null || _keyCacheZ == null)
        {
            _statusMessage = "Not All Keys Cached";
            await InvokeAsync(StateHasChanged);
            return;
        }

        CalculateKeyPositions();
        // Store positions of all other joints besides X and J5
        ArmAxes startPosition = new()
        {
            X = _RoveCommService.Boards.Arm.Target_X,
            J2 = _RoveCommService.Boards.Arm.Target_J2,
            J3 = _RoveCommService.Boards.Arm.Target_J3,
            J4 = _RoveCommService.Boards.Arm.Target_J4,
            J5 = _RoveCommService.Boards.Arm.Target_J5,
            J6 = _RoveCommService.Boards.Arm.Target_J6,
        };

        foreach (char letter in _phrase)
        {
            if (!_keyPositions.ContainsKey(letter)) continue;
            _charStatusMeter = 0;
            _statusMessage = "Moving to " + letter;
            await InvokeAsync(StateHasChanged);

            Vector2 currentPos = new(_RoveCommService.Boards.Arm.Position_X, _RoveCommService.Boards.Arm.Position_J5);
            Vector2 nextPos = _keyPositions[letter];
            //float delta = (nextPos - currentPos).Length();
            float delta = Math.Abs(nextPos.X - currentPos.X);
            float initialDelta = delta;

            // Send command to move to next position
            _RoveCommService.Boards.Arm.TargetAngle(nextPos.X, startPosition.J2, startPosition.J3, startPosition.J4, nextPos.Y, startPosition.J6);

            // Wait until the arm gets close and update the progress bar in the meantime
            using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            // using var timeout = CancellationTokenSource.CreateLinkedTokenSource(_cts.Token, timeoutCts.Token);
            while (delta > 0.1 && !timeout.Token.IsCancellationRequested)
            {
                if (initialDelta != 0) _charStatusMeter = 1 - (delta / initialDelta);
                await InvokeAsync(StateHasChanged);
                await Task.Delay(100, _cts.Token);
                currentPos = new(_RoveCommService.Boards.Arm.Position_X, _RoveCommService.Boards.Arm.Position_J5);
                delta = Math.Abs(nextPos.X - currentPos.X);
            }

            await Task.Delay(1000, _cts.Token); // A little more time to settle

            _statusMessage = "Extending Servo";
            _RoveCommService.Boards.Arm.LinearServo(180);
            _charStatusMeter = 0;
            for (int j = 0; j < 30; j++)
            {
                _charStatusMeter += 1.0f / 30;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(100, _cts.Token);
            }

            _statusMessage = "Retracting Servo";
            _RoveCommService.Boards.Arm.LinearServo(100);
            _charStatusMeter = 0;
            for (int j = 0; j < 30; j++)
            {
                _charStatusMeter += 1.0f / 30;
                await InvokeAsync(StateHasChanged);
                await Task.Delay(100, _cts.Token);
            }
        }

        _statusMessage = "Done";
        await InvokeAsync(StateHasChanged);
    }

    private void CalculateKeyPositions()
    {
        if (_keyCacheQ == null || _keyCacheP == null || _keyCacheZ == null)
        {
            throw new InvalidOperationException("Not all keys cached.");
        }

        Vector2 Q = _keyCacheQ ?? new();
        Vector2 P = _keyCacheP ?? new();
        Vector2 Z = _keyCacheZ ?? new();
        // Calculate keyboard measurements based on cached keys
        Vector2 QP = P - Q;
        Vector2 QZ = Z - Q;
        Vector2 basisX = QP / 9;
        Vector2 basisY = QZ / 2;

        string rowQ = "QWERTYUIOP";
        string rowA = "ASDFGHJKL";
        string rowZ = "ZXCVBNM";

        for (int i = 0; i < rowQ.Length; i++)
        {
            _keyPositions[rowQ[i]] = Q + basisX * i;
        }

        for (int i = 0; i < rowA.Length; i++)
        {
            _keyPositions[rowA[i]] = Q + basisX * i + basisY;
        }

        for (int i = 0; i < rowZ.Length; i++)
        {
            _keyPositions[rowZ[i]] = Q + basisX * i + 2 * basisY;
        }

    }

}