@inject RoveCommService _RoveCommService
@inject OpService _OpService

<div class="component-header">
    <h3>Advanced Autonomous Typing</h3>
</div>

<div class="component-body">
    <div style="display: flex; flex-direction: column; justify-content: center; align-items: center">
        <p class="font-monospace fs-3">@_phrase</p>
        <p>@_statusMessage</p>
        <p>@(delay * 10)ms</p>
        <progress max="5000" value=@_charStatusMeter class="progress"></progress>
    </div>

    <div style="display: flex; gap: 2px; justify-content: center">
        <input @bind:get=_phrase @bind:set=@(value => { _phrase = value.ToUpper(); }) />
        <button @onclick=PlayPhrase>Start</button>
        <button @onclick=Flip>180 Pitch</button>
        <button @onclick=ResetCache>Reset Cache</button>
    </div>

    <div style="display: grid; grid-template-columns: auto auto auto; text-align: center; padding: 0.5rem;">
        <button @onclick=CacheQ>Cache Q</button>
        <button @onclick=CacheP>Cache P</button>
        <button @onclick=CacheA>Cache A</button>
        <p>@(_isCached[0] ? "Cached!" : "Not Cached")</p>
        <p>@(_isCached[1] ? "Cached!" : "Not Cached")</p>
        <p>@(_isCached[2] ? "Cached!" : "Not Cached")</p>
    </div>
</div>

@code {
    private string _phrase = "";
    private string _statusMessage = "Idle";
    private int _currentCharIndex = 0;
    private int _charStatusMeter = 0;

    private int delay = 0;

    private Dictionary<char, List<float>> keys = new();
    private float[] _lastPosTelemetry = new float[7];

    // X, Pitch
    private float[] _keyCacheQ = new float[2];
    private float[] _keyCacheP = new float[2];
    private float[] _keyCacheA = new float[2];

    // Q, P, A
    private bool[] _isCached = new bool[3];

    private void CacheQ()
    {
        _keyCacheQ[0] = _lastPosTelemetry[0];
        _keyCacheQ[1] = _lastPosTelemetry[4];
        _isCached[0] = true;
    }

    private void CacheP()
    {
        _keyCacheP[0] = _lastPosTelemetry[0];
        _keyCacheP[1] = _lastPosTelemetry[4];
        _isCached[1] = true;

    }

    private void CacheA()
    {
        _keyCacheA[0] = _lastPosTelemetry[0];
        _keyCacheA[1] = _lastPosTelemetry[4];
        _isCached[2] = true;

    }

    private void ResetCache()
    {
        _isCached[0] = false;
        _isCached[1] = false;
        _isCached[2] = false;
    }



    protected override void OnInitialized()
    {
        _RoveCommService.Boards.Arm.OnPositions(async packet =>
        {
            for (int i = 0; i < packet.DataCount; i++)
            {
                _lastPosTelemetry[i] = packet.Data[i];
            }

            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task PlayPhrase()
    {
        _OpService.SetAutonomy();
        CalculateKeyPositions();
        ResetCache();
        List<float> totalOffset = [0f, 0f];
        for (int i = 0; i < _phrase.Length; i++)
        {
            _currentCharIndex = i;
            if (!keys.ContainsKey(_phrase[i])) continue;
            List<float> pos = keys[_phrase[i]];
            pos[0] -= keys['Q'][0];
            pos[1] -= keys['Q'][1];
            _charStatusMeter = 0;
            _statusMessage = "Moving to " + _phrase[i];
            if (pos != null)
            {
                // X
                _RoveCommService.Boards.Arm.IncrementJointTargetAngle(0, pos[0] - totalOffset[0]);

                // Pitch
                _RoveCommService.Boards.Arm.IncrementJointTargetAngle(4, pos[1] - totalOffset[1]);

                delay = (int)Math.Ceiling(Math.Abs(pos[0] - totalOffset[0])) * 100 + 100;

                totalOffset[0] = pos[0];
                totalOffset[1] = pos[1];

                await InvokeAsync(StateHasChanged);
                for (int j = 0; j < delay; j++)
                {
                    _charStatusMeter += 1 / delay;
                    _ = InvokeAsync(StateHasChanged);
                    await Task.Delay(10);
                }
            }

            _statusMessage = "Running solenoid";
            _ = InvokeAsync(StateHasChanged);
            _RoveCommService.Boards.Arm.Solenoid(1);
            await Task.Delay(100);
            _RoveCommService.Boards.Arm.Solenoid(0);
            await Task.Delay(100);
        }

        _statusMessage = "Done";
        _ = InvokeAsync(StateHasChanged);
        await Task.Delay(2000);
        _OpService.SetTeleop();
    }

    private void CalculateKeyPositions()
    {
        // Calculate keyboard measurements based on cached keys
        float keydx = _keyCacheQ[0] - _keyCacheP[0];
        float keydp = _keyCacheQ[1] - _keyCacheP[1];
        if (!_isCached[1] || !_isCached[0])
        {
            keydx = -(10.67f - 4.03f);
            keydp = 0f;
        }

        float rowxd = _keyCacheQ[0] - _keyCacheA[0];
        float rowxp = _keyCacheQ[0] - _keyCacheA[0];
        if (!_isCached[2])
        {
            rowxp = 4f;
            rowxd = -(11.49f - 11.28f);
        }

        // Define X and Pitch positional diffs based on Q
        // TODO look at this stupid bullshit. Refactor post URC
        keys['Q'] = [0, 0f];
        keys['W'] = [keydx * (1f / 9f), keydp * (1f / 9f)];
        keys['E'] = [keydx * (2f / 9f), keydp * (2f / 9f)];
        keys['R'] = [keydx * (3f / 9f), keydp * (3f / 9f)];
        keys['T'] = [keydx * (4f / 9f), keydp * (4f / 9f)];
        keys['Y'] = [keydx * (5f / 9f), keydp * (5f / 9f)];
        keys['U'] = [keydx * (6f / 9f), keydp * (6f / 9f)];
        keys['I'] = [keydx * (7f / 9f), keydp * (7f / 9f)];
        keys['O'] = [keydx * (8f / 9f), keydp * (8f / 9f)];
        keys['P'] = [keydx * (9f / 9f), keydp * (9f / 9f)];
        keys['A'] = [rowxd + keydx * (0f / 9f), rowxp + keydp * (0f / 9f)];
        keys['S'] = [rowxd + keydx * (1f / 9f), rowxp + keydp * (1f / 9f)];
        keys['D'] = [rowxd + keydx * (2f / 9f), rowxp + keydp * (2f / 9f)];
        keys['F'] = [rowxd + keydx * (3f / 9f), rowxp + keydp * (3f / 9f)];
        keys['G'] = [rowxd + keydx * (4f / 9f), rowxp + keydp * (4f / 9f)];
        keys['H'] = [rowxd + keydx * (5f / 9f), rowxp + keydp * (5f / 9f)];
        keys['J'] = [rowxd + keydx * (6f / 9f), rowxp + keydp * (6f / 9f)];
        keys['K'] = [rowxd + keydx * (7f / 9f), rowxp + keydp * (7f / 9f)];
        keys['L'] = [rowxd + keydx * (8f / 9f), rowxp + keydp * (8f / 9f)];
        keys['Z'] = [rowxd * 2f + keydx * (0f / 9f), rowxp * 2f + keydp * (0f / 9f)];
        keys['X'] = [rowxd * 2f + keydx * (1f / 9f), rowxp * 2f + keydp * (1f / 9f)];
        keys['C'] = [rowxd * 2f + keydx * (2f / 9f), rowxp * 2f + keydp * (2f / 9f)];
        keys['V'] = [rowxd * 2f + keydx * (3f / 9f), rowxp * 2f + keydp * (3f / 9f)];
        keys['B'] = [rowxd * 2f + keydx * (4f / 9f), rowxp * 2f + keydp * (4f / 9f)];
        keys['N'] = [rowxd * 2f + keydx * (5f / 9f), rowxp * 2f + keydp * (5f / 9f)];
        keys['M'] = [rowxd * 2f + keydx * (6f / 9f), rowxp * 2f + keydp * (6f / 9f)];
    }

    private void Flip()
    {
        _RoveCommService.Boards.Arm.IncrementIndividualTargetAngles(0, 0, 0, 0, 180f, 0);
    }
}