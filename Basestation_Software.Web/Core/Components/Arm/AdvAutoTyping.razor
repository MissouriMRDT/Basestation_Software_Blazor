@using System.Diagnostics
@inject RoveCommService _RoveCommService
@inject OpService _OpService

<div class="component-header">
    <h3>Advanced Autonomous Typing</h3>
</div>

<div class="component-body">
    <div style="display: flex; flex-direction: column; justify-content: center; align-items: center">
        <p class="font-monospace fs-3">@_phrase</p>
        <p>@_statusMessage</p>
        <p>@_elapsed / @_delay ms</p>
        <progress max="1" value=@((float)_elapsed / _delay) class="progress"></progress>
    </div>

    <div style="display: flex; gap: 2px; justify-content: center">
        <input @bind:get=_phrase @bind:set=@(value => { _phrase = value.ToUpper(); }) />
        <button @onclick=Start>Start</button>
        <button @onclick=@(() => _running = false)>Stop</button>
    </div>
    <div style="display: grid; grid-template-columns: max-content 100px 100px 100px 100px">
        <p>X</p>
        <input @bind=_start.X />
        <input @bind=_start.J2 />
        <input @bind=_start.J3 />
        <p></p>
        <p>J4</p>
        <input @bind=_start.J4 />
        <input @bind=_start.J5 />
        <input @bind=_start.J6 />
        <p></p>
        <p></p>
        <p>X</p>
        <p>J5</p>
        <p>Servo</p>
        <p>Delay</p>
        <p>M</p>
        <input @bind=_mrdt[0] />
        <input @bind=_mrdt[1] />
        <input @bind=_mrdt[2] />
        <input @bind=_mrdt[3] />
        <p>R</p>
        <input @bind=_mrdt[4] />
        <input @bind=_mrdt[5] />
        <input @bind=_mrdt[6] />
        <input @bind=_mrdt[7] />
        <p>D</p>
        <input @bind=_mrdt[8] />
        <input @bind=_mrdt[9] />
        <input @bind=_mrdt[10] />
        <input @bind=_mrdt[11] />
        <p>T</p>
        <input @bind=_mrdt[12] />
        <input @bind=_mrdt[13] />
        <input @bind=_mrdt[14] />
        <input @bind=_mrdt[15] />
    </div>
</div>

@code {
    private string _phrase = "MRDT";
    private string _statusMessage = "Idle";
    private long _elapsed = 0;
    private int _delay = 0;

    bool _running = false;

    private ArmAxes _start = new()
    {
        X = 0f,
        J2 = 11.97f,
        J3 = -78.00f,
        J4 = -173.49f,
        J5 = 49.95f,
        J6 = 0f
    };

    // (x, j5, servo pressed)
    /*private List<float> _mrdt = [
       5.04f, 63.99f, 82f, 5000,
       2.16f, 49.5f, 65.54f, 5000,
       1.9f, 57.06f, 71.51f, 5000,
       3.18f, 49.23f, 66.5f, 5000,
    ];*/

    private List<float> _mrdt = [
       4.97f, 63.99f, 83f, 3500f,
       2.09f, 49.5f, 66f, 2000f,
       1.78f, 57.06f, 71.51f, 500f,
       3.11f, 49.23f, 67f, 1200f,
    ];


    protected override void OnInitialized()
    {
        _RoveCommService.Boards.Arm.OnPosition(async packet => await InvokeAsync(StateHasChanged));
    }

    private async Task<bool> Delay(int ms)
    {
        _delay = ms;
        Stopwatch stopwatch = new();
        stopwatch.Start();
        while (stopwatch.ElapsedMilliseconds < ms && _running)
        {
            _elapsed = stopwatch.ElapsedMilliseconds;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(10);
        }
        return _running;
    }

    private async Task Start()
    {
        _running = true;
        _OpService.SetAutonomy();
        await Run();
        await InvokeAsync(StateHasChanged);
        _statusMessage = "Idle";
        _delay = 0;
        _elapsed = 0;
        _OpService.SetTeleop();
        _RoveCommService.Boards.Arm.OpenLoop(0, 0, 0, 0, 0, 0);
        _running = false;
    }

    private async Task Run()
    {
        _statusMessage = "Moving to start";
        _RoveCommService.Boards.Arm.TargetAngle(_start.X, _start.J2, _start.J3, _start.J4, _start.J5, _start.J6);
        if (!await Delay(5000)) return;
        // servo range: 40 - 115
        for (int i = 0; i + 3 < _mrdt.Count; i += 4)
        {
            float x = _mrdt[i];
            float j5 = _mrdt[i + 1];
            byte servo = (byte)_mrdt[i + 2];
            int delay = (int)_mrdt[i + 3];
            _statusMessage = "Moving to " + "MRDT"[i / 4];
            _RoveCommService.Boards.Arm.TargetAngle(x, _start.J2, _start.J3, _start.J4, j5, _start.J6);
            if (!await Delay(delay)) return;
            _statusMessage = "Pressing";
            _RoveCommService.Boards.Arm.LinearServo(servo);
            if (!await Delay(1800)) return;
            _statusMessage = "Releasing";
            _RoveCommService.Boards.Arm.LinearServo(40); //82
            if (!await Delay(2000)) return;
        }
    }
}