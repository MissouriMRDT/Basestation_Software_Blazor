@using System.Diagnostics
@inject RoveCommService _RoveCommService
@inject OpService _OpService
@using System.Numerics

<div class="component-header">
    <h3>Advanced Autonomous Typing</h3>
</div>

<div class="component-body">
    <div style="display: flex; flex-direction: column; justify-content: center; align-items: center">
        <p class="font-monospace fs-3">@_phrase</p>
        <p>@_statusMessage</p>
        <p>@delay ms</p>
        <progress max="1" value=@_charStatusMeter class="progress"></progress>
    </div>

    <div style="display: flex; gap: 2px; justify-content: center">
        <input @bind:get=_phrase @bind:set=@(value => { _phrase = value.ToUpper(); }) />
        <button @onclick=StartStop>@(_running ? "Stop" : "Start")</button>
        <button @onclick=ResetCache>Reset Cache</button>
    </div>

    <div style="display: grid; grid-template-columns: auto auto auto; text-align: center; padding: 0.5rem;">
        <button @onclick=CacheQ>Cache Q</button>
        <button @onclick=CacheP>Cache P</button>
        <button @onclick=CacheZ>Cache Z</button>
        <p>@(_keyCacheQ != null ? "Cached!" : "Not Cached")</p>
        <p>@(_keyCacheP != null ? "Cached!" : "Not Cached")</p>
        <p>@(_keyCacheZ != null ? "Cached!" : "Not Cached")</p>
    </div>
</div>

@code {
    private readonly CancellationTokenSource _cts = new();
    private bool _running = false;
    private string _phrase = "";
    private string _statusMessage = "Idle";
    private int _currentCharIndex = 0;
    private float _charStatusMeter = 0;

    private const int InchesPerSecond = 4;
    private int delay = 0;

    private Dictionary<char, Vector3> _keyPositions = new();
    private Matrix4x4 _keyPositionsPose = Matrix4x4.Identity;

    // X, Pitch
    private Vector3? _keyCacheQ = null;
    private Vector3? _keyCacheP = null;
    private Vector3? _keyCacheZ = null;

    // Q, P, A
    private bool[] _isCached = new bool[3];

    private void CacheQ()
    {
        _keyCacheQ = new Vector3(_RoveCommService.Boards.Arm.Position_GX, _RoveCommService.Boards.Arm.Position_GY, _RoveCommService.Boards.Arm.Position_GZ);
    }

    private void CacheP()
    {
        _keyCacheP = new Vector3(_RoveCommService.Boards.Arm.Position_GX, _RoveCommService.Boards.Arm.Position_GY, _RoveCommService.Boards.Arm.Position_GZ);

    }

    private void CacheZ()
    {
        _keyCacheZ = new Vector3(_RoveCommService.Boards.Arm.Position_GX, _RoveCommService.Boards.Arm.Position_GY, _RoveCommService.Boards.Arm.Position_GZ);
    }

    private void ResetCache()
    {
        _keyCacheQ = null;
        _keyCacheP = null;
        _keyCacheZ = null;
    }

    protected override void OnInitialized()
    {
        _RoveCommService.Boards.Arm.OnPosition(async packet => await InvokeAsync(StateHasChanged));
    }

    private async Task StartStop() {
        if (!_running) await Start();
        else Stop();
        await Task.CompletedTask;
    }

    private async Task Start() {
        _running = true;
        try {
            await Task.Run(PlayPhrase, _cts.Token);
        } catch (OperationCanceledException) {
            _statusMessage = "Stopped";
            _OpService.SetTeleop();
            _running = false;
            await InvokeAsync(StateHasChanged);
        }
        _running = false;
    }

    private void Stop() {
        _cts.Cancel();
        _running = false;
    }

    private async Task PlayPhrase() {
        _running = true;
        _OpService.SetAutonomy();
        CalculateKeyPositions();
        //ResetCache();
        for (int i = 0; i < _phrase.Length; i++)
        {
            _currentCharIndex = i;
            if (!_keyPositions.ContainsKey(_phrase[i])) continue;
            _charStatusMeter = 0;
            _statusMessage = "Moving to " + _phrase[i];
            await InvokeAsync(StateHasChanged);
    
            Vector3 currentPos = new(_RoveCommService.Boards.Arm.Position_GX, _RoveCommService.Boards.Arm.Position_GY, _RoveCommService.Boards.Arm.Position_GZ);
            Vector3 nextPos = _keyPositions[_phrase[i]];
            Vector3 delta = nextPos - currentPos;
            for (int k = 0; k < 10; k++) {
                _RoveCommService.Boards.Arm.IKWorldIncrement(delta.X/10, delta.Y/10, delta.Z/10, 0, 0, 0);
                await Task.Delay(500);
            }

            @* delay = Math.Max((int)(Math.Abs(delta.X) * 1000 / InchesPerSecond), 1000);

            await InvokeAsync(StateHasChanged);
            for (int j = 0; j < delay; j+=10)
            {
                _charStatusMeter = (float)(j * 10) / delay;
                _ = InvokeAsync(StateHasChanged);
                await Task.Delay(millisecondsDelay: 10);
            } *@

            _statusMessage = "Running solenoid";
            await InvokeAsync(StateHasChanged);
            _RoveCommService.Boards.Arm.LinearServo(180);
            await Task.Delay(2000);
            _RoveCommService.Boards.Arm.LinearServo(30);
            await Task.Delay(2000);
        }

        _statusMessage = "Done";
        await Task.Delay(1000);
        _OpService.SetTeleop();
        _running = false;
        await InvokeAsync(StateHasChanged);
    }

    private void CalculateKeyPositions()
    {
        if (_keyCacheQ == null || _keyCacheP == null || _keyCacheZ == null) return;
        Vector3 Q = _keyCacheQ ?? new();
        Vector3 P = _keyCacheP ?? new();
        Vector3 Z = _keyCacheZ ?? new();
        // Calculate keyboard measurements based on cached keys
        Vector3 QP = P - Q;
        Vector3 QZ = Z - Q;
        Vector3 basisX = QP / 9;
        Vector3 basisY = QZ / 2;

        string rowQ = "QWERTYUIOP";
        string rowA = "ASDFGHJKL";
        string rowZ = "ZCVBNM";

        for (int i = 0; i < rowQ.Length; i++) {
            _keyPositions[rowQ[i]] = Q + basisX * i;
        }
        for (int i = 0; i < rowA.Length; i++) {
            _keyPositions[rowA[i]] = Q + basisX * i + basisY;
        }
        for (int i = 0; i < rowZ.Length; i++) {
            _keyPositions[rowZ[i]] = Q + basisX * i + 2*basisY;
        }
    }

    private void Flip()
    {
        float[] position = (float[])_RoveCommService.Boards.Arm.Position;
        if (position[4] > 0)
            _RoveCommService.Boards.Arm.TargetAngle(position[0], position[1], position[2], position[3], position[4] - 180f, position[5]);
        else
            _RoveCommService.Boards.Arm.TargetAngle(position[0], position[1], position[2], position[3], position[4] + 180f, position[5]);
    }
}