@implements IDisposable
@using Basestation_Software.Web.Utils;
@using System.Data
@using System.Diagnostics
@inject RoveCommService _roveCommService;
@inject OpService _opService;

<div class="component-header">
    <h3>Arm Controller</h3>
    <input type="checkbox" class="output-enabled" @bind=_outputEnabled title="Disable Output" />
    <GamepadSelector @ref=GamepadSelector_ OnUpdate=Update />
</div>
<div class="component-body" style="flex-grow: 0; display: grid; grid-template-columns: repeat(4, max-content) 100px 100px; place-items: stretch">
    <p></p>
    <p>|Ctrl</p>
    <p>|Target</p>
    <p>|Arm</p>
    <p>Max Delta</p>
    <p>Speed</p>
    <p>J2</p>
    <p>|@($"{_controller.J2:+000.0;-000.0}")</p>
    <p>|@($"{_target.J2:+000.0;-000.0}")</p>
    <p>|@($"{_arm?.J2:+000.0;-000.0}")</p>
    <input style=@(_overDelta[1] ? "background-color: #ff0" : "") @bind="RoverControllerDelta.J2" />
    <input style=@(_overSpeed[1] ? "background-color: #ff0" : "") @bind="Speed.J2" />
    <p>J3</p>
    <p>|@($"{_controller.J3:+000.0;-000.0}")</p>
    <p>|@($"{_target.J3:+000.0;-000.0}")</p>
    <p>|@($"{_arm?.J3:+000.0;-000.0}")</p>
    <input style=@(_overDelta[2] ? "background-color: #ff0" : "") @bind="RoverControllerDelta.J3" />
    <input style=@(_overSpeed[2] ? "background-color: #ff0" : "") @bind="Speed.J3" />
    <p>J4</p>
    <p>|@($"{_controller.J4:+000.0;-000.0}")</p>
    <p>|@($"{_target.J4:+000.0;-000.0}")</p>
    <p>|@($"{_arm?.J4:+000.0;-000.0}")</p>
    <input style=@(_overDelta[3] ? "background-color: #ff0" : "") @bind="RoverControllerDelta.J4" />
    <input style=@(_overSpeed[3] ? "background-color: #ff0" : "") @bind="Speed.J4" />
    <p>J5</p>
    <p>|@($"{_controller.J5:+000.0;-000.0}")</p>
    <p>|@($"{_target.J5:+000.0;-000.0}")</p>
    <p>|@($"{_arm?.J5:+000.0;-000.0}")</p>
    <input style=@(_overDelta[4] ? "background-color: #ff0" : "") @bind="RoverControllerDelta.J5" />
    <input style=@(_overSpeed[4] ? "background-color: #ff0" : "") @bind="Speed.J5" />
    <p></p>
    <p></p>
    <p></p>
    <p></p>
    <p>|Reverse</p>
    <p>|Forward</p>
    <p></p>
    <p></p>
    <p></p>
    <p>|J6-Axis</p>
    <input style=@(_pressed[0] ? "background-color: #008000" : "background-color: #FF0000")/>
    <input style=@(_pressed[1] ? "background-color: #008000" : "background-color: #FF0000" ) />
    <p></p>
    <p></p>
    <p></p>
    <p>|G-Axis</p>
    <input style=@(_pressed[2] ? "background-color: #008000" : "background-color: #FF0000")/>
    <input style=@(_pressed[3] ? "background-color: #008000" : "background-color: #FF0000" ) />
    <p></p>
    <p></p>
    <p></p>
    <p>|X-Axis</p>
    <input style=@(_pressed[4] ? "background-color: #008000" : "background-color: #FF0000")/>
    <input style=@(_pressed[5] ? "background-color: #008000" : "background-color: #FF0000" ) />
</div>

@code
{
    // State
    private GamepadSelector? GamepadSelector_;
    private bool _outputEnabled = false;
    private ArmAxes _controller = new();
    private ArmAxes _target = new();
    private ArmAxes? _arm;
    private Gamepad _gamepad = new();
    

    public ArmAxes RoverControllerDelta = new ArmAxes()
    {
        J2 = 10,
        J3 = 10,
        J4 = 10,
        J5 = 10,
    };
    public ArmAxes Speed = new ArmAxes() // Angle Per Second
    {
        J2 = 30,
        J3 = 30,
        J4 = 30,
        J5 = 30
    };
    public ArmAxes OffSet = new ArmAxes()
    {
        J2 = 0F,
        J3 = 00.5F,
        J4 = -0.5F,
        J5 = 0.8F,
    };
    private bool[] _overDelta = new bool[5];
    private bool[] _overSpeed = new bool[5];
    private bool[] _pressed = new bool[7];
    private short moveX;
    private short moveG;
    private short moveJ6;


    public ArmController()
    {
    }

    protected override void OnInitialized()
    {
        _roveCommService.Boards.Arm.OnPosition(async packet =>
        {
            if (_arm == null) _arm = new();
            _arm.SetFromArm(_roveCommService.Boards.Arm);
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task Update(Gamepad gamepad, float deltaT)
    {
        if (await ProcessGamepadInput(gamepad, deltaT))
            // Set teleop if controller being used.
            _opService.SetTeleop();
        // It is safe for this component to take no action when the controller is disconnected.
        await InvokeAsync(StateHasChanged);
    }

    private float AddOffset(double axis, float offset)
    {
        float axisSum = (float)axis + offset;
        if (axisSum > 1)
        {
            return (axisSum) - 2;
        }
        if (axisSum < -1)
        {
            return 2 + (axisSum);
        }
        return axisSum;
    }

    private void ResetMaxDelta()
    { // Resets Angle Delta in order to Sync Arm and Arm Controller
        RoverControllerDelta.J2 = 10;
        RoverControllerDelta.J3 = 10;
        RoverControllerDelta.J4 = 10;
        RoverControllerDelta.J5 = 10;
    }
    private async Task<bool> ProcessGamepadInput(Gamepad gamepad, float deltaT)
    {
        if (!gamepad.Connected)
        { // If Controller is Physically Disconnected, Delta is Reset
            ResetMaxDelta();
            return false;
        }

        if (gamepad.Axes.Length < 5 || gamepad.Pressed.Length < 7) return false; 
        if (_arm == null) return false;

        // Update Button Pressed
        for (int i = 0; i < 7;i++){
            _pressed[i]=gamepad.Pressed[i];
        }

        // Update controller position from selected gamepad's axes.
        _controller.J2 = (float)Utils.ClampMap(AddOffset(-gamepad.Axes[1], OffSet.J2), -1.0, 1.0, -180.0, 180.0);
        _controller.J3 = (float)Utils.ClampMap(AddOffset(-gamepad.Axes[2], OffSet.J3), -1.0, 1.0, -180.0, 180.0);
        _controller.J4 = (float)Utils.ClampMap(AddOffset(gamepad.Axes[3], OffSet.J4), -1.0, 1.0, 0.0, 360.0);
        _controller.J5 = (float)Utils.ClampMap(AddOffset(gamepad.Axes[4], OffSet.J5), -1.0, 1.0, -180.0, 180.0);

        // Update target to the arm's position if the controller is further than RoverControllerDelta otherwise follow controller up to Speed maximum speed.
        _overDelta[1] = Math.Abs(_controller.J2 - _arm.J2) > RoverControllerDelta.J2;
        _overDelta[2] = Math.Abs(_controller.J3 - _arm.J3) > RoverControllerDelta.J3;
        _overDelta[3] = Math.Abs(_controller.J4 - _arm.J4) > RoverControllerDelta.J4;
        _overDelta[4] = Math.Abs(_controller.J5 - _arm.J5) > RoverControllerDelta.J5;

        // If Angle of Encoder is in Range, Sets Over Delta to 360 Degrees
        if (!_overDelta[1]) { RoverControllerDelta.J2 = 360; }
        if (!_overDelta[2]) { RoverControllerDelta.J3 = 360; }
        if (!_overDelta[3]) { RoverControllerDelta.J4 = 360; }
        if (!_overDelta[4]) { RoverControllerDelta.J5 = 360; }

        // Sets Target to Controller Angle or Arm Angle based on OverDelta
        _target.J2 = _overDelta[1] ? _arm.J2 : LimitSpeed(_target.J2, _controller.J2, Speed.J2, deltaT, out _overSpeed[1]);
        _target.J3 = _overDelta[2] ? _arm.J3 : LimitSpeed(_target.J3, _controller.J3, Speed.J3, deltaT, out _overSpeed[2]);
        _target.J4 = _overDelta[3] ? _arm.J4 : LimitSpeed(_target.J4, _controller.J4, Speed.J4, deltaT, out _overSpeed[3]);
        _target.J5 = _overDelta[4] ? _arm.J5 : LimitSpeed(_target.J5, _controller.J5, Speed.J5, deltaT, out _overSpeed[4]);

        // Sets Open Loops via which buttons are being pressed (J6,Gripper,X-Axis)
        if (_pressed[0]){moveJ6=(int)(-32768*0.25);}
        if (_pressed[1]){moveJ6=(int)(32768*0.25);}
        if ((_pressed[0]&&_pressed[1])||(!(_pressed[1]||_pressed[1]))){moveJ6=0;}

        if (_pressed[2]){moveG=(int)(-32768*0.25);}
        if (_pressed[3]){moveG=(int)(32768*0.25);}
        if ((_pressed[2]&&_pressed[3])||(!(_pressed[2]||_pressed[3]))){moveG=0;}

        if (_pressed[4]){moveX=(int)(-32768*0.25);}
        if (_pressed[5]){moveX=(int)(32768*0.25);}
        if ((_pressed[4]&&_pressed[5])||(!(_pressed[4]||_pressed[5]))){moveX=0;}


        if (!_outputEnabled || !gamepad.Pressed[7]) // Resets Angle Delta if Basestation App is not Enabled or Enable Switch is disabled
        {
            ResetMaxDelta();
            return false;
        }
        //Sends all the Collected data to the Arm
        _roveCommService.Boards.Arm.TargetAngle(_arm.X, _target.J2, _target.J3, _target.J4, _target.J5, _arm.J6);
        _roveCommService.Boards.Arm.GripperOpenLoop(moveJ6);
        _roveCommService.Boards.Arm.OpenLoop(moveX,0,0,0,0,moveJ6);
        return true;
    }

    private float LimitSpeed(float lastTarget, float controller, float speed, float deltaT, out bool overSpeed)
    {
        if (Math.Abs(controller - lastTarget) / deltaT > speed)
        {
            overSpeed = true;
            return lastTarget + Math.Sign(controller - lastTarget) * speed * deltaT;
        }
        else
        {
            overSpeed = false;
            return controller;
        }
    }

    void IDisposable.Dispose() { }
}