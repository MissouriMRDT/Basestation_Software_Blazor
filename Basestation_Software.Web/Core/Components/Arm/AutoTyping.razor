@inject RoveCommService _RoveCommService
@inject OpService _OpService

<div class="component-header">
    <h3>Autonomous Typing</h3>
</div>

<div class="component-body">
    <div style="display: flex; flex-direction: column; justify-content: center; align-items: center">
        <p class="font-monospace fs-3">@_phrase</p>
        <p>@_statusMessage</p>
        <p>@(delay * 10)ms</p>
        <progress max="5000" value=@_charStatusMeter class="progress"></progress>
    </div>

    <div style="display: flex; gap: 2px; justify-content: center">
        <input @bind:get=_phrase @bind:set=@(value => { _phrase = value.ToUpper(); }) />
        <button @onclick=PlayPhrase>Start</button>
        <button @onclick=Flip>180 Pitch</button>
    </div>
</div>

@code {
    private string _phrase = "";
    private string _statusMessage = "Placeholder";
    private int _currentCharIndex = 0;
    private int _charStatusMeter = 0;

    private const float r1 = 4f;
    private const float r2 = 8f;
    private const float keydx = -(10.67f - 4.03f);
    private const float r1xo = -(11.49f - 11.28f);

    private const float r2xo = -(11.49f - 10.87f);

    private int delay = 0;

    // X and Pitch positional diffs based on Q
    private Dictionary<char, List<float>> keys = new()
{
{ 'Q', [0, 0f]},
{ 'W', [keydx * (1f/9f), 0f]},
{ 'E', [keydx * (2f/9f), 0f]},
{ 'R', [keydx * (3f/9f), 0f]},
{ 'T', [keydx * (4f/9f), 0f]},
{ 'Y', [keydx * (5f/9f), 0f]},
{ 'U', [keydx * (6f/9f), 0f]},
{ 'I', [keydx * (7f/9f), 0f]},
{ 'O', [keydx * (8f/9f), 0f]},
{ 'P', [keydx * (9f/9f), 0f]},
{ 'A', [r1xo + keydx * (0f/9f), r1]},
{ 'S', [r1xo + keydx * (1f/9f), r1]},
{ 'D', [r1xo + keydx * (2f/9f), r1]},
{ 'F', [r1xo + keydx * (3f/9f), r1]},
{ 'G', [r1xo + keydx * (4f/9f), r1]},
{ 'H', [r1xo + keydx * (5f/9f), r1]},
{ 'J', [r1xo + keydx * (6f/9f), r1]},
{ 'K', [r1xo + keydx * (7f/9f), r1]},
{ 'L', [r1xo + keydx * (8f/9f), r1]},
{ 'Z', [r2xo + keydx * (0f/9f), r2]},
{ 'X', [r2xo + keydx * (1f/9f), r2]},
{ 'C', [r2xo + keydx * (2f/9f), r2]},
{ 'V', [r2xo + keydx * (3f/9f), r2]},
{ 'B', [r2xo + keydx * (4f/9f), r2]},
{ 'N', [r2xo + keydx * (5f/9f), r2]},
{ 'M', [r2xo + keydx * (6f/9f), r2]},
};

    private async Task PlayPhrase()
    {
        _OpService.SetAutonomy();
        List<float> totalOffset = [0f, 0f];
        for (int i = 0; i < _phrase.Length; i++)
        {
            _currentCharIndex = i;
            if (!keys.ContainsKey(_phrase[i])) continue;
            List<float> pos = keys[_phrase[i]];
            pos[0] -= keys['Q'][0];
            pos[1] -= keys['Q'][1];
            _charStatusMeter = 0;
            _statusMessage = "Moving to " + _phrase[i];
            if (pos != null)
            {
                // X
                _RoveCommService.Boards.Arm.IncrementJointTargetAngle(0, pos[0] - totalOffset[0]);

                // Pitch
                _RoveCommService.Boards.Arm.IncrementJointTargetAngle(4, pos[1] - totalOffset[1]);

                delay = (int)Math.Ceiling(Math.Abs(pos[0] - totalOffset[0])) * 100 + 100;

                totalOffset[0] = pos[0];
                totalOffset[1] = pos[1];

                await InvokeAsync(StateHasChanged);
                for (int j = 0; j < delay; j++)
                {
                    _charStatusMeter += 1 / delay;
                    _ = InvokeAsync(StateHasChanged);
                    await Task.Delay(10);
                }
            }

            _statusMessage = "Running solenoid";
            _ = InvokeAsync(StateHasChanged);
            _RoveCommService.Boards.Arm.Solenoid(1);
            await Task.Delay(100);
            _RoveCommService.Boards.Arm.Solenoid(0);
            await Task.Delay(100);
        }

        _statusMessage = "Done";
        _ = InvokeAsync(StateHasChanged);
        await Task.Delay(2000);
        _OpService.SetTeleop();
    }

    private void Flip()
    {
        _RoveCommService.Boards.Arm.IncrementIndividualTargetAngles(0, 0, 0, 0, 180f, 0);
    }

    private void OnPhraseChanged(ChangeEventArgs e)
    {
        _phrase = e.Value?.ToString()?.ToUpper() ?? "NULL";
        StateHasChanged();
    }
}