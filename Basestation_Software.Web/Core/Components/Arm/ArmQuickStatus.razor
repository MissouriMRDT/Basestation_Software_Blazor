@inject RoveCommService _RoveCommService

<div class="component-header">
    <h3>Arm Quick Status</h3>
</div>
<div class="component-body arm-quick-status">
    <p>X</p>
    <p>@($"{_RoveCommService.Boards.Arm.Position_X:+000.000;-000.000}")</p>
    <p>J2</p>
    <p>@($"{_RoveCommService.Boards.Arm.Position_J2:+000.000;-000.000}")</p>
    <p>J3</p>
    <p>@($"{_RoveCommService.Boards.Arm.Position_J3:+000.000;-000.000}")</p>
    <p>J4</p>
    <p>@($"{_RoveCommService.Boards.Arm.Position_J4:+000.000;-000.000}")</p>
    <p>Pitch</p>
    <p>@($"{_RoveCommService.Boards.Arm.Position_P:+000.000;-000.000}")</p>
    <p>PFG</p>
    <p>@($"{_pitchFromGround:+000.000;-000.000}")</p>
    <p>Roll</p>
    <p>@($"{_RoveCommService.Boards.Arm.Position_R:+000.000;-000.000}")</p>
    <p>Y</p>
    <p>@($"{_RoveCommService.Boards.Arm.Position_Y:+000.000;-000.000}")</p>
    <p>Z</p>
    <p>@($"{_RoveCommService.Boards.Arm.Position_Z:+000.000;-000.000}")</p>
</div>

@code {
    private float _pitchFromGround { get => _RoveCommService.Boards.Arm.Position_P + (float)Math.Cos(_RoveCommService.Boards.Arm.Position_J4 * Math.PI / 180f) + _RoveCommService.Boards.Arm.Position_J2 + _RoveCommService.Boards.Arm.Position_J3; }
    protected override void OnInitialized()
    {
        _RoveCommService.Boards.Arm.OnPosition(async packet => await InvokeAsync(StateHasChanged));
    }
}