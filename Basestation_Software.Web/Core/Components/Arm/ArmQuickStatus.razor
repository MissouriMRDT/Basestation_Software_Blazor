@inject RoveCommService _RoveCommService
@inject ArmService _armService

<div class="component-header">
    <h3>Arm Quick Status</h3>
</div>
<div class="component-body arm-quick-status">
    <p>X</p>
    <p>@($"{_lastTelemetry[0]:+000.000;-000.000}")</p>
    <p>J2</p>
    <p>@($"{_lastTelemetry[1]:+000.000;-000.000}")</p>
    <p>J3</p>
    <p>@($"{_lastTelemetry[2]:+000.000;-000.000}")</p>
    <p>J4</p>
    <p>@($"{_lastTelemetry[3]:+000.000;-000.000}")</p>
    <p>Pitch</p>
    <p>@($"{_lastTelemetry[4]:+000.000;-000.000}")</p>
    <p>Roll</p>
    <p>@($"{_lastTelemetry[5]:+000.000;-000.000}")</p>
    <p>PFG</p>
    <p>@($"{_lastTelemetry[6]:+000.000;-000.000}")</p>
    <p>Gripper</p>
    <p>@(_armService.IsAlternateGripper ? "Valk" : "Talos")</p>
</div>

@code {
    private float[] _lastTelemetry = new float[7];
    protected override void OnInitialized()
    {
        _armService.SubscribeToGripperChanged(OnGripperChanged);
        _RoveCommService.Boards.Arm.OnPositions(async packet =>
        {
            for (int i = 0; i < packet.DataCount; i++) _lastTelemetry[i] = packet.Data[i];
            await InvokeAsync(StateHasChanged);
        });
    }
    private async void OnGripperChanged(bool isAlternateGripper) { await InvokeAsync(StateHasChanged); }
}