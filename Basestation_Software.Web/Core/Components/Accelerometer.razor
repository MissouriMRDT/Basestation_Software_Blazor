@implements IAsyncDisposable

@inject RoveCommService _RoveCommService
@inject IJSRuntime _IJSRuntime

<div class="card h-100">
    <div class="card-header">
        <h5 class="mr-auto">3D Rover</h5>
    </div>
    <div class="card-body" style="padding: 0">
        @if (!_dataLoaded)
        {
            <div class="row">
                <div class="spinner-border " role="status"></div>
                <div class="col">
                    <h3>Loading...</h3>
                </div>
            </div>
        }
        <div id="rover-view-@ID" style="width: 100%; height:100%" hidden="@(!_dataLoaded)"></div>
    </div>
</div>

@code
{

    [Parameter]
    public string ID { get; set; } = "";

    // In radians
    private double Pitch = 0, Yaw = 0, Roll = 0;
    private static readonly double DEG_TO_RAD = Math.PI / 180;

    private IJSObjectReference? jsModule;
    private string jsInteropName = "";
    private bool _dataLoaded = false;

    protected override void OnInitialized()
    {
        jsInteropName = $"roverViews.{ID}";
        // TODO: fix this when CoreBoard's accelerometer is fixed
        _RoveCommService.On<float>("Nav", "IMUData", async (packet) =>
        {
            // Pitch relative to upright [-90D,90U]
            Pitch = Math.Clamp(packet.Data[0], -90, 90) * DEG_TO_RAD;
            Yaw = packet.Data[1] * DEG_TO_RAD;
            // Roll relative to upright [-180L, 180R]
            Roll = Math.Clamp(packet.Data[2], -180, 180) * DEG_TO_RAD;
            await jsModule!.InvokeVoidAsync($"{jsInteropName}.updateAngles", [Pitch, Yaw, Roll]);
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            jsModule = await _IJSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/rover-3d-view.js");
            await jsModule.InvokeVoidAsync("createRoverView", [ID, DotNetObjectReference.Create(this)]);
            _dataLoaded = true;
            await InvokeAsync(StateHasChanged);
            // component will resize once unhidden
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        try
        {
            if (jsModule is not null)
            {
                await jsModule.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

}
