@inject RoveCommService _RoveCommService

<div class="component-header">
    <h3>Autonomy Drive Power</h3>
</div>
<div class="component-body" style="display: grid; grid-template-columns: auto min-content 200px min-content; align-items: center">
    <p>Max Speed</p>
    <p>@(_maxSpeed * 100)%</p>
    <input @bind=_maxSpeed type="range" min="0" max="1" step="0.01">
    <button class="success" @onclick=@(() => _RoveCommService.Boards.Autonomy.SetMaxSpeed(_maxSpeed))><i class="bi-send"></i></button>

    <p>Min Traversal Score</p>
    <p>@(_minTravScore * 100)%</p>
    <input @bind=_minTravScore type="range" min="0" max="1" step="0.01">
    <button class="success" @onclick=@(() => _RoveCommService.Boards.Autonomy.SetMinTravScore(_minTravScore))><i class="bi-send"></i></button>

    <p>Beta Bias</p>
    <p>@(_betaBias * 100)%</p>
    <input @bind=_betaBias type="range" min="0" max="1" step="0.01">
    <button class="success" @onclick=@(() => _RoveCommService.Boards.Autonomy.SetBetaBias(_betaBias))><i class="bi-send"></i></button>

    <button style="grid-column: 1 / 3" class="secondary" @onclick="() => _RoveCommService.Boards.Core.SetWatchdogMode(0)">Teleop Watchdog</button>
    <button style="grid-column: 3 / 5" class="secondary" @onclick="() => _RoveCommService.Boards.Core.SetWatchdogMode(1)">Autonomy Watchdog</button>
</div>

@code {
    private float _maxSpeed = 0;
    private float _minTravScore = 0;
    private float _betaBias = 0;
}