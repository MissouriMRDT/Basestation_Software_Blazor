<div class="component-header">
    <h3>Autonomy Detection</h3>
</div>
<div class="component-body auto-detection">
    <div style="position: absolute; display: flex; gap: 3px">
        <button onclick="this.parentElement.parentElement.children[1].replaceChildren();">Clear</button>
        <button onclick="this.parentElement.parentElement.children[1].replaceChildren(); window.autoDetectionsList = []; ">Fetch All</button>
    </div>
    <div style="display: flex; flex-direction: column; overflow-y: auto; height: 100%; gap: 3px; background-color: #000"></div>
</div>

<script>
    // Don't start the interval if it already exists (perhaps there are two AutoDetection components on the page).
    if (window.refreshAutoDetections === undefined) {
        window.autoDetectionsList = [];
        window.refreshAutoDetections = setInterval(async () => {
            const containers = [...document.getElementsByClassName("auto-detection")].map(component => component.children[1]);
            if (containers.length === 0) {
                // All AutoDetection components have been removed. Clear this interval.
                clearInterval(window.refreshAutoDetections);
                window.refreshAutoDetections = undefined;
                window.autoDetectionsList = undefined;
            } else {
                const api = "http://@(RoveCommManifest.Boards["Autonomy"].IP):3284/api";
                (await (await fetch(`${api}/detection_list`, { "cache": "no-store" })).json()).forEach(filename => {
                    if (window.autoDetectionsList.indexOf(filename) < 0) {
                        // Detection is new. Add this image to every container.
                        const image = document.createElement("img");
                        image.setAttribute("src", `${api}/detections/${filename}`)
                        containers.forEach(container => container.prepend(image));
                        window.autoDetectionsList.push(filename);
                    }
                });
            }
        }, 1000);
    }
</script>