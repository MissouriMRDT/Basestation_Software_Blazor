@inject RoveCommService _RoveCommService
@using static RoveComm.Boards.Autonomy

<div class="component-header">
    <h3>Autonomy Log</h3>
</div>
<div class="component-body" style="display: grid; overflow-y: scroll; grid: repeat(2, min-content) / auto repeat(4, min-content)">
    <p style="place-self: center right">Log Level</p>
    <select @bind=ll1>
        @foreach (AUTONOMYLOG level in Enum.GetValues<AUTONOMYLOG>())
        {
            <option value=@level>@level</option>
        }
    </select>
    <select @bind=ll2>
        @foreach (AUTONOMYLOG level in Enum.GetValues<AUTONOMYLOG>())
        {
            <option value=@level>@level</option>
        }
    </select>
    <select @bind=ll3>
        @foreach (AUTONOMYLOG level in Enum.GetValues<AUTONOMYLOG>())
        {
            <option value=@level>@level</option>
        }
    </select>
    <button class="success" @onclick=@(() => _RoveCommService.Boards.Autonomy.SetLoggingLevels((byte)ll1, (byte)ll2, (byte)ll3))><i class="bi-send"></i></button>
    <table style="grid-column: 1 / 6">
        @foreach (Log log in logs)
        {
            <tr>
                <td>@log.timestamp</td>
                <td>@log.message</td>
            </tr>
        }
    </table>
</div>

@code {

    AUTONOMYLOG ll1 = 0;
    AUTONOMYLOG ll2 = 0;
    AUTONOMYLOG ll3 = 0;

    struct Log
    {
        public string message;
        public DateTime timestamp;
    }
    List<Log> logs = new();

    protected override void OnInitialized()
    {
        _RoveCommService.Boards.Autonomy.OnCurrentLog(async packet =>
        {
            logs.Add(new Log
            {
                message = packet.Data.ToString() ?? "",
                timestamp = DateTime.Now
            });

            await InvokeAsync(StateHasChanged);
        });

        /* _RoveCommService.On<byte>("Autonomy", "ReachedGoal", async packet =>
        {
        logs.Add(new Log
        {
        message = "ReachedGoal",
        timestamp = DateTime.Now
        });

        await InvokeAsync(StateHasChanged);
        });*/
    }
}