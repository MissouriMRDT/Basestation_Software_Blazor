@using Microsoft.EntityFrameworkCore
@implements IDisposable
@inject DatabaseService _databaseService
@inject RoveCommService _roveCommService
@inject IDbContextFactory<DatabaseContext> _dbContextFactory
@using static RoveComm.Boards.Autonomy
@inject GPSWaypointState _GPSWaypointState

<div class="component-header">
    <h3>Waypoints</h3>
    <button @onclick=New><i class="bi-plus" /></button>
</div>
<div class="component-body" style="display: grid; overflow-y: scroll; flex-grow: 0; grid-template-columns: min-content 60px 55px 55px 15px 15px 70px 15px min-content">
    <p></p>
    <p>Name</p>
    <p>Latitude</p>
    <p>Longitude</p>
    <p></p>
    <p>r</p>
    <p style="grid-column: 7 / 9">ID</p>
    <p></p>
    @for (int _i = 0; _i < _waypoints.Count(); _i++)
    {
        int i = _i;
        GPSWaypoint waypoint = _waypoints[i];
        <button checked=@(_GPSWaypointState.SelectedWaypoint?.ID == waypoint.ID) onclick=@(() => Select(i)) title="Select Waypoint"><i class="bi-check" /></button>
        <input style="padding: 0" @bind=waypoint.Name @bind:after=@(async () => await Save(i)) />
        <input style="padding: 0" @bind:get=@(waypoint.Latitude.ToString("000.000000;-000.000000")) @bind:set=@(async value => { waypoint.Latitude = GPSWaypoint.ConvertDMSToDegrees(value); await Save(i); }) />
        <input style="padding: 0" @bind:get=@(waypoint.Longitude.ToString("000.000000;-000.000000")) @bind:set=@(async value => { waypoint.Longitude = GPSWaypoint.ConvertDMSToDegrees(value); await Save(i); }) />
        <input style="padding: 0; width: 100%; height: 100%" type="color" @bind:get=@($"#{waypoint.Color:X6}") @bind:set=@(async value => { waypoint.Color = int.Parse(value.Substring(1), System.Globalization.NumberStyles.HexNumber); await Save(i); }) />
        <input style="padding: 0" @bind=waypoint.SearchRadius @bind:after=@(async () => await Save(i)) />
        <select style="padding: 0" @bind=waypoint.TagID @bind:after=@(async () => await Save(i))>
            <option value=-10>None</option>
            @foreach (AUTONOMYWAYPOINTTYPES waypointType in Enum.GetValues<AUTONOMYWAYPOINTTYPES>())
            {
                <option value=@((int)waypointType)>@waypointType</option>
            }
        </select>
        <div style=@($"background-color: #{waypoint.Color:X6}")>
            @if (waypoint.TagID >= (int)AUTONOMYWAYPOINTTYPES.Tag0)
            {
                <ArucoTagDisplay ID="@waypoint.TagID" Style="padding: 0; width: 100%" />
            }
            else if (WaypointImages.ContainsKey(waypoint.TagID))
            {
                <img style="width: 100%" src=@(WaypointImages[waypoint.TagID]) />
            }
        </div>
        <button class="danger" @onclick=@(async () => await Delete(i)) title="Delete Waypoint"><i class="bi-trash" /></button>
    }
</div>

@code
{
    static public Dictionary<int, string> WaypointImages = new() {
{(int)AUTONOMYWAYPOINTTYPES.Any, "/images/any.png"},
{(int)AUTONOMYWAYPOINTTYPES.Mallet, "/images/mallet.png"},
{(int)AUTONOMYWAYPOINTTYPES.WaterBottle, "/images/bottle.png"},
{(int)AUTONOMYWAYPOINTTYPES.RockPick, "/images/pick.png"},
{(int)AUTONOMYWAYPOINTTYPES.ContinuousNavigate, "/images/continuousNavigate.png"}};
    private List<GPSWaypoint> _waypoints = new();

    protected override async Task OnInitializedAsync()
    {
        _databaseService.SubscribeToTableChanges(typeof(GPSWaypoint), UpdateWaypoints);
        _GPSWaypointState.SubscribeToWaypointSelected(OnWaypointSelected);
        await UpdateWaypoints();
    }

    private async Task UpdateWaypoints()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        _waypoints = await databaseContext.Waypoints.ToListAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task New()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        databaseContext.Waypoints.Add(new() { ID = Guid.NewGuid(), Latitude = _roveCommService.Boards.Nav.GPSLatLonAlt_Lat, Longitude = _roveCommService.Boards.Nav.GPSLatLonAlt_Lon, TagID = -10, Color = 0xffffff });
        await databaseContext.SaveChangesAsync(_databaseService);
    }

    private async Task Save(int i)
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        databaseContext.Waypoints.Update(_waypoints[i]);
        await databaseContext.SaveChangesAsync(_databaseService);
    }

    private async Task Delete(int i)
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        GPSWaypoint? waypoint = await databaseContext.Waypoints.FindAsync(_waypoints[i].ID);
        if (waypoint == null)
            _waypoints.Remove(_waypoints[i]);
        else
        {
            databaseContext.Waypoints.Remove(waypoint);
            await databaseContext.SaveChangesAsync(_databaseService);
        }
    }

    private void Select(int i)
    {
        if (_GPSWaypointState.SelectedWaypoint?.ID == _waypoints[i].ID)
            _GPSWaypointState.SelectedWaypoint = null;
        else
            _GPSWaypointState.SelectedWaypoint = _waypoints[i];
    }

    private async Task OnWaypointSelected(GPSWaypoint? waypoint)
    {


        await InvokeAsync(StateHasChanged);
    }

    void IDisposable.Dispose()
    {
        _databaseService.UnsubscribeFromTableChanges(typeof(GPSWaypoint), UpdateWaypoints);
        _GPSWaypointState.UnsubscribeFromWaypointSelected(OnWaypointSelected);
    }
}