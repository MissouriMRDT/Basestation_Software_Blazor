@implements IDisposable
@inject RoveCommService _RoveCommService
@inject IJSRuntime _IJSRuntime

<div class="component-header">
    <h3>PMS</h3>
</div>
<div class="component-body pms">
    <div style="grid-area: motors; background-color: @(BusStatus[0] == BusState.Enabled ? "yellow" : "grey")">Motors<button @onclick="() => toggleBus(0)">@(BusStatus[0] == BusState.Enabled ? "Disable" : (BusStatus[0] == BusState.Disabled ? "Enable" : "Pending..."))</button></div>
    <div style="grid-area: core; background-color: @(BusStatus[1] == BusState.Enabled ? "yellow" : "grey")">Core<button @onclick="() => toggleBus(1)">@(BusStatus[1] == BusState.Enabled ? "Disable" : (BusStatus[1] == BusState.Disabled ? "Enable" : "Pending..."))</button></div>
    <div style="grid-area: aux; background-color: @(BusStatus[2] == BusState.Enabled ? "yellow" : "grey")">Aux<button @onclick="() => toggleBus(2)">@(BusStatus[2] == BusState.Enabled ? "Disable" : (BusStatus[2] == BusState.Disabled ? "Enable" : "Pending..."))</button></div>
    <div style="grid-area: core-current; background-color: @Utils.ClampMap(PackCurrent - AuxCurrent, 7.2, 30, COLOR_OK, COLOR_ERROR)">Core Current<span>@($"{PackCurrent - AuxCurrent:0.00}") A</span></div>
    <div style="grid-area: aux-current; background-color: @Utils.ClampMap(AuxCurrent, 5, 15, COLOR_OK, COLOR_ERROR)">Aux Current<span>@($"{AuxCurrent:0.00}") A</span></div>
    <div style="grid-area: pack-current; background-color: @Utils.ClampMap(PackCurrent, 9.5, 45, COLOR_OK, COLOR_ERROR)">Pack Current<span>@($"{PackCurrent:0.00}") A</span></div>
    <div style="grid-area: pack-capacity; background-color: @Utils.ClampMap(PackCapacity, 1, 2.3, COLOR_ERROR, COLOR_OK)">Pack Capactity<span>@($"{PackCapacity:0.00}") J</span></div>
    <div style="grid-area: cs1-current; background-color: #fff">CS1<span>@($"{MiscCurrent[0]:0.00}") A</span></div>
    <div style="grid-area: cs2-current; background-color: #fff">CS2<span>@($"{MiscCurrent[1]:0.00}") A</span></div>
    <div style="grid-area: cs3-current; background-color: #fff">CS3<span>@($"{MiscCurrent[2]:0.00}") A</span></div>
    <div style="grid-area: c1-voltage; background-color: @Utils.ClampMap(CellVoltage[0], 2.5, 4.2, COLOR_ERROR, COLOR_OK)">C1<span>@($"{CellVoltage[0]:0.00}") V</span></div>
    <div style="grid-area: c2-voltage; background-color: @Utils.ClampMap(CellVoltage[1], 2.5, 4.2, COLOR_ERROR, COLOR_OK)">C2<span>@($"{CellVoltage[1]:0.00}") V</span></div>
    <div style="grid-area: c3-voltage; background-color: @Utils.ClampMap(CellVoltage[2], 2.5, 4.2, COLOR_ERROR, COLOR_OK)">C3<span>@($"{CellVoltage[2]:0.00}") V</span></div>
    <div style="grid-area: c4-voltage; background-color: @Utils.ClampMap(CellVoltage[3], 2.5, 4.2, COLOR_ERROR, COLOR_OK)">C4<span>@($"{CellVoltage[3]:0.00}") V</span></div>
    <div style="grid-area: c5-voltage; background-color: @Utils.ClampMap(CellVoltage[4], 2.5, 4.2, COLOR_ERROR, COLOR_OK)">C5<span>@($"{CellVoltage[4]:0.00}") V</span></div>
    <div style="grid-area: c6-voltage; background-color: @Utils.ClampMap(CellVoltage[5], 2.5, 4.2, COLOR_ERROR, COLOR_OK)">C6<span>@($"{CellVoltage[5]:0.00}") V</span></div>
    <div style="grid-area: pack-voltage; background-color: @Utils.ClampMap(PackVoltage, 15, 25, COLOR_ERROR, COLOR_OK)">Pack Voltage<span>@($"{PackVoltage:0.00}") V</span></div>
    <button style="grid-area: reboot" @onclick=Reboot>REBOOT</button>
    <button style="grid-area: e-stop" @onclick=EStop>E-STOP</button>
    <button style="grid-area: suicide" @onclick=Suicide>SUICIDE</button>
</div>

@code
{
    enum BusState
    {
        Disabled,
        Enabled,
        Unknown,
    }

    // Constants
    public const uint TELEMETRY_TIMEOUT = 10_000; // ms
    public static Color COLOR_ERROR = Color.FromArgb(255, 255, 0, 0);
    public static Color COLOR_OK = Color.FromArgb(255, 0, 255, 0);

    // State
    private List<BusState> BusStatus = new List<BusState>() { BusState.Unknown, BusState.Unknown, BusState.Unknown }; // Motors, Core, Aux
    private float PackCurrent = 0, PackVoltage = 0, AuxCurrent = 0;
    private List<float> CellVoltage = new List<float>() { 0, 0, 0, 0, 0, 0 }; // C1 ... C6
    private List<float> MiscCurrent = new List<float>() { 0, 0, 0 }; // CS1 ... CS3
    private System.Threading.Timer TelemetryWatchdog;
    private double PackCapacity = 0;

    PMS()
    {
        TelemetryWatchdog = new System.Threading.Timer(WatchdogTimeout);
    }

    protected override void OnInitialized()
    {
        ResetWatchdog();

        _RoveCommService.Boards.PMS.OnCurrentAndVoltage(async packet =>
        {
            // TODO: Update current and voltage from telemetry
            PackVoltage = _RoveCommService.Boards.PMS.CurrentAndVoltage[6..12].Sum();
            double x = PackVoltage / 6;

            if (x < 2.8)
                PackCapacity = 0;
            else if (x < 3.45)
                PackCapacity = -144081.925 + 235284.736 * x - 153537.325 * x * x + 50048.2469 * x * x * x - 8149.57918 * x * x * x * x + 530.359797 * x * x * x * x * x;
            else if (x < 3.81)
                PackCapacity = 6198350.17 - 8453983.154 * x + 4610248.291 * x * x - 1256560.878 * x * x * x + 171177.5361 * x * x * x * x - 9324.159109 * x * x * x * x * x;
            else if (x < 4.12)
                PackCapacity = -2608191.44 + 3247156.22 * x - 1615884.19 * x * x + 401745.658 * x * x * x - 49900.4554 * x * x * x * x + 2477.08634 * x * x * x * x * x;
            else
                PackCapacity = 30.453;

            ResetWatchdog();
            await InvokeAsync(StateHasChanged);
        });

        _RoveCommService.Boards.PMS.OnBusStatus(async packet =>
        {
            for (int i = 0; i < 3; i++)
                BusStatus[i] = (_RoveCommService.Boards.PMS.BusStatus & (1 << i)) == 0 ? BusState.Disabled : BusState.Enabled;
            ResetWatchdog();
            await InvokeAsync(StateHasChanged);
        });
    }

    async void WatchdogTimeout(object? _)
    {
        AuxCurrent = 0;
        PackCurrent = 0;
        PackVoltage = 0;
        CellVoltage = [0, 0, 0, 0, 0, 0];
        BusStatus = [BusState.Unknown, BusState.Unknown, BusState.Unknown];
        MiscCurrent = [0, 0, 0];
        await InvokeAsync(StateHasChanged);
    }

    void ResetWatchdog()
    {
        TelemetryWatchdog.Change(TELEMETRY_TIMEOUT, Timeout.Infinite);
    }

    void toggleBus(int i)
    {
        if (BusStatus[i] == BusState.Disabled)
            _RoveCommService.Boards.PMS.EnableBus((byte)(1 << i));
        else if (BusStatus[i] == BusState.Enabled)
            _RoveCommService.Boards.PMS.DisableBus((byte)(1 << i));
        BusStatus[i] = BusState.Unknown;
    }

    async Task Reboot()
    {
        if (await _IJSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to do this? It will take a few minutes to reboot the network switch."))
            _RoveCommService.Boards.PMS.Reboot();
    }

    void EStop()
    {
        _RoveCommService.Boards.PMS.EStop();
    }

    async Task Suicide()
    {
        if (await _IJSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to do this? You must pull the physical E Stop to turn the rover on again!"))
            _RoveCommService.Boards.PMS.Suicide();
    }

    void IDisposable.Dispose() { }
}