@inject RoveCommService roveCommService
@using RoveComm
@using System.Collections.Generic
@using System.Text.Json
@using System.IO

<div class="component-header">
    <h3>Manual Packet Sender</h3>
</div>
<div class="component-body" style="display: grid; grid-template-columns: min-content auto; align-items: center">
    <p>Device</p>
    <select @bind=selectedDevice>
        @foreach (string device in RoveCommManifest.Boards.Keys)
        {
            <option value=@device>@device</option>
        }
    </select>
    <p>Command</p>
    <select @bind=selectedCommand @bind:after=UpdateComment>
        @if (RoveCommManifest.Boards.ContainsKey(selectedDevice))
        {
            @foreach (string command in RoveCommManifest.Boards[selectedDevice].Commands.Keys)
            {
                <option value=@command>@command</option>
            }
        }
    </select>
    <p>Parameter(s)</p>
    <input @bind=CommandParameters placeholder="1.23 -4.56 789">
    <p style="grid-column: 1 / 3">@Info</p>
    <p style="color: red; grid-column: 1 / 3">@Error</p>
    <button class="success" style="grid-column: 1 / 3" @onclick=RunCommand>Run</button>
</div>

@code {

    private string selectedDevice = "";
    private List<DropDownItem> deviceDropdownItems = new List<DropDownItem> { };

    private string selectedCommand = "";
    private List<DropDownItem> commandDropdownItems = new List<DropDownItem> { };

    private string CommandParameters = ""; // The command parameter(s) value(s) input by user
    private string Info = ""; // The message to assist user in setting the command parameter(s)
    private string Error = "";
    private string CommandParameterType = ""; // The type of the command parameters
    private short NumCommandParameters = 0; // The number of parameters required for the given command


    private Dictionary<string, JsonElement> data = new();

    public class DropDownItem
    {
        public required string Value { get; set; }
        public required string Text { get; set; }
    }

    protected async Task RunCommand()
    {
        short numParameters;
        if (CommandParameters != "")
        {
            numParameters = Convert.ToInt16(CommandParameters.Split(' ').Length);
        }
        else
        {
            numParameters = 0;
        }

        Error = "";
        if (selectedDevice == "")
            Error += "Please select a device. ";
        if (selectedCommand == "")
            Error += "Please select a command. ";
        if (numParameters != NumCommandParameters)
            Error += $"The selected command requires {NumCommandParameters} parameter(s) of type {CommandParameterType}. ";

        if (Error == "")
        {
            try
            {
                switch (CommandParameterType)
                {
                    case "INT8_T":
                        List<sbyte> data_sbyte = CommandParameters.Split(' ').Select(x => Convert.ToSByte(x)).ToList();
                        await roveCommService.SendAsync<sbyte>(
                        boardName: selectedDevice,
                        commandName: selectedCommand,
                        data: data_sbyte
                        );
                        break;
                    case "UINT8_T":
                        List<byte> data_byte = CommandParameters.Split(' ').Select(x => Convert.ToByte(x)).ToList();
                        await roveCommService.SendAsync<byte>(
                        boardName: selectedDevice,
                        commandName: selectedCommand,
                        data: data_byte
                        );
                        break;
                    case "INT16_T":
                        List<Int16> data_int16 = CommandParameters.Split(' ').Select(x => Convert.ToInt16(x)).ToList();
                        await roveCommService.SendAsync<Int16>(
                        boardName: selectedDevice,
                        commandName: selectedCommand,
                        data: data_int16
                        );
                        break;
                    case "UINT16_T":
                        List<UInt16> data_uint16 = CommandParameters.Split(' ').Select(x => Convert.ToUInt16(x)).ToList();
                        await roveCommService.SendAsync<UInt16>(
                        boardName: selectedDevice,
                        commandName: selectedCommand,
                        data: data_uint16
                        );
                        break;
                    case "INT32_T":
                        List<Int32> data_int32 = CommandParameters.Split(' ').Select(x => Convert.ToInt32(x)).ToList();
                        await roveCommService.SendAsync<Int32>(
                        boardName: selectedDevice,
                        commandName: selectedCommand,
                        data: data_int32
                        );
                        break;
                    case "UINT32_T":
                        List<UInt32> data_uint32 = CommandParameters.Split(' ').Select(x => Convert.ToUInt32(x)).ToList();
                        await roveCommService.SendAsync<UInt32>(
                        boardName: selectedDevice,
                        commandName: selectedCommand,
                        data: data_uint32
                        );
                        break;
                    case "FLOAT_T":
                        List<float> data_float = CommandParameters.Split(' ').Select(x => Convert.ToSingle(x)).ToList();
                        await roveCommService.SendAsync<float>(
                        boardName: selectedDevice,
                        commandName: selectedCommand,
                        data: data_float
                        );
                        break;
                    case "DOUBLE_T":
                        List<double> data_double = CommandParameters.Split(' ').Select(x => Convert.ToDouble(x)).ToList();
                        await roveCommService.SendAsync<double>(
                        boardName: selectedDevice,
                        commandName: selectedCommand,
                        data: data_double
                        );
                        break;
                    case "CHAR":
                        List<char> data_char = CommandParameters.Split(' ').Select(x => Convert.ToChar(x)).ToList();
                        await roveCommService.SendAsync<char>(
                        boardName: selectedDevice,
                        commandName: selectedCommand,
                        data: data_char
                        );
                        break;
                }

                Info = "Command Successful";
            }
            catch
            {
                Error = $"Check that all values are of type {CommandParameterType}.";
            }
        }
    }

    protected override void OnInitialized()
    {
        var json = File.ReadAllText("../RoveComm_CSharp/data/RoveComm/manifest.json");
        data = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json) ?? [];
    }

    private void UpdateComment()
    {
        CommandParameters = "";
        Error = "";
        // Get command comments
        if (data.TryGetValue("RovecommManifest", out var rovecommManifest) &&
        rovecommManifest.TryGetProperty(selectedDevice, out var device) &&
        device.TryGetProperty("Commands", out var commands) &&
        commands.TryGetProperty(selectedCommand, out var command) &&
        command.TryGetProperty("comments", out var comments))
        {
            Info = "Parameter Format: " + comments.GetString();

            // Get command parameter type
            if (command.TryGetProperty("dataType", out var paramType))
                CommandParameterType = paramType.ToString();
            else
                Error = "Command data type not found.";

            // Get number of command parameters
            if (command.TryGetProperty("dataCount", out var numParams))
                NumCommandParameters = Convert.ToInt16(numParams.ToString());
            else
                Error = "Command data count not found.";
        }
        else
        {
            Info = "Command parameter specs not found.";
        }
        StateHasChanged();
    }
}