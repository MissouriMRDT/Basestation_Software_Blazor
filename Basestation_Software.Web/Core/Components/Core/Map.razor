    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await using var jsModule = await _IJSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/rover-map.js");
            // Create leaflet map.
            Uri baseUri = new Uri(_NavigationManager.BaseUri);
            _objectReference = DotNetObjectReference.Create(this);
            _jsMap = await jsModule.InvokeAsync<IJSObjectReference>("createRoverMap", [_mapContainer, _objectReference, $"{baseUri.Scheme}://{baseUri.Host}:{baseUri.Port}/MapTiles/{{z}}/{{y}}/{{x}}.png", $"{baseUri.Scheme}://{baseUri.Host}:{baseUri.Port}/LidarTiles/{{z}}/{{y}}/{{x}}.png", InitialLat, InitialLong, InitialZoomLevel]);

            // Plot waypoints and keep them updated.
            await PlotWaypoints();
            _databaseService.SubscribeToTableChanges(typeof(GPSWaypoint), UpdateWaypoints);
            _GPSWaypointState.SubscribeToWaypointSelected(OnWaypointSelected);
        }
    }

    public async Task SetETA(double ETA)
    {
        await _jsMap!.InvokeVoidAsync("setETA", ETA);
    }

    public async Task DisplayRoverPath(List<double> points)
    {
        await _jsMap!.InvokeVoidAsync("displayRoverPath", points);
    }

    public async Task DisplayPath(List<double> points)
    {
        await _jsMap!.InvokeVoidAsync("displayPath", points);
    }

    public async Task RemovePath()
    {
        await _jsMap!.InvokeVoidAsync("removePath");
    }

    public async Task RemoveRoverPath()
    {
        await _jsMap!.InvokeVoidAsync("removeRoverPath");
    }

    private async Task UpdateWaypoints()
    {
        // Update waypoint markers.
        await _jsMap!.InvokeVoidAsync("clearWaypointMarkers");
        await PlotWaypoints();
    }

    private async Task PlotWaypoints()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        List<GPSWaypoint> waypoints = await databaseContext.Waypoints.ToListAsync();
        await Task.WhenAll(waypoints.ConvertAll<Task>(waypoint => _jsMap!.InvokeVoidAsync("addWaypointMarker", [waypoint.Name, waypoint.Latitude, waypoint.Longitude, waypoint.SearchRadius, ColorTranslator.ToHtml(Color.FromArgb(waypoint.Color)), waypoint.TagID]).AsTask()));
    }

    [JSInvokable]
    public async Task AddWaypoint(double lat, double lon)
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        databaseContext.Waypoints.Add(new()
        {
            ID = Guid.NewGuid(),
            Latitude = lat,
            Longitude = lon,
            TagID = -10,
            Color = 0xffffff
        });
        await databaseContext.SaveChangesAsync(_databaseService);
    }

    private async Task OnWaypointSelected(GPSWaypoint? waypoint)
    {
        if (waypoint != null) await PanToCoordinates(waypoint.Latitude, waypoint.Longitude);
    }

    public async Task PanToCoordinates(double lat, double lon)
    {
        await _jsMap!.InvokeVoidAsync("panToCoordinates", [lat, lon]);
    }

    [JSInvokable]
    public async Task SetRange(double lat1, double lon1, double lat2, double lon2, int zoom)
    {
        _rangeSet = true;
        _zoom = zoom;
        _region[0] = lon1;
        _region[1] = lat1;
        _region[2] = lon2;
        _region[3] = lat2;
        int x1 = LonToTileX(_region[0], _zoom);
        int y1 = LatToTileY(_region[1], _zoom);
        int x2 = LonToTileX(_region[2], _zoom);
        int y2 = LatToTileY(_region[3], _zoom);
        int minX = Math.Min(x1, x2);
        int maxX = Math.Max(x1, x2);
        int minY = Math.Min(y1, y2);
        int maxY = Math.Max(y1, y2);
        _totalDownloadingTiles = 0;
        for (int z = _zoom; z <= 18; z++)
        {
            if (z >= 13)
                for (int y = minY; y <= maxY; y++)
                    for (int x = minX; x <= maxX; x++)
                        _totalDownloadingTiles += 1;
            minX *= 2;
            maxX = maxX * 2 + 1;
            minY *= 2;
            maxY = maxY * 2 + 1;
        }
        await InvokeAsync(StateHasChanged);
    }

    public async Task Download()
    {
        if (_downloading || !_rangeSet) return;
        _downloading = true;

        Timer updateUI = new(_ => InvokeAsync(StateHasChanged), null, 0, 1000);

        using HttpClient client = new HttpClient();
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        client.DefaultRequestHeaders.UserAgent.ParseAdd("Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:147.0) Gecko/20100101 Firefox/147.0");
        client.DefaultRequestHeaders.Referrer = new Uri("http://mt1.google.com");

        int x1 = LonToTileX(_region[0], _zoom);
        int y1 = LatToTileY(_region[1], _zoom);
        int x2 = LonToTileX(_region[2], _zoom);
        int y2 = LatToTileY(_region[3], _zoom);
        int minX = Math.Min(x1, x2);
        int maxX = Math.Max(x1, x2);
        int minY = Math.Min(y1, y2);
        int maxY = Math.Max(y1, y2);
        _currentlyDownloadingTile = 0;
        for (int z = _zoom; z <= 18; z++)
        {
            if (z >= 13)
            {
                for (int y = minY; y <= maxY; y++)
                {
                    for (int x = minX; x <= maxX; x++)
                    {
                        if (!_downloading) { updateUI.Change(Timeout.Infinite, Timeout.Infinite); return; }

                        _currentlyDownloadingTile += 1;
                        // Skip downloaded tiles.
                        if (_isLidar ? databaseContext.LidarTiles.Count(tile => tile.X == x && tile.Y == y && tile.Z == z) != 0 : databaseContext.MapTiles.Count(tile => tile.X == x && tile.Y == y && tile.Z == z) != 0)
                            continue;

                        // Determine download URL for tile.
                        string url;
                        if (_isLidar)
                        {
                            double lat1_ = LatToEPSG3857(TileYToLat(y, z));
                            double lon1_ = LonToEPSG3857(TileXToLon(x, z));
                            double lat2_ = LatToEPSG3857(TileYToLat(y + 1, z));
                            double lon2_ = LonToEPSG3857(TileXToLon(x + 1, z));
                            url = $"https://elevation.nationalmap.gov/arcgis/services/3DEPElevation/ImageServer/WMSServer?&service=WMS&request=GetMap&layers=3DEPElevation%3AHillshade%20Gray&styles=&format=image%2Fjpeg&transparent=false&version=1.1.1&width=256&height=256&srs=EPSG%3A3857&bbox={lon1_},{lat2_},{lon2_},{lat1_}";
                        }
                        else
                        {
                            url = $"http://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={z}";
                        }
                        Console.WriteLine($"Downloading tile {_currentlyDownloadingTile} / {_totalDownloadingTiles} ({(double)_currentlyDownloadingTile / _totalDownloadingTiles * 100:000.00}%) from {url}.");

                        // Download tile and ensure success.
                        var response = await client.GetAsync(url);
                        if (!response.IsSuccessStatusCode)
                        {
                            Console.WriteLine($"Error {response.StatusCode}.");
                            updateUI.Change(Timeout.Infinite, Timeout.Infinite);
                            _downloading = false;
                            return;
                        }
                        byte[] data = await response.Content.ReadAsByteArrayAsync();
                        if (_isLidar)
                            databaseContext.LidarTiles.Add(new LidarTile { X = x, Y = y, Z = z, ImageData = data });
                        else
                            databaseContext.MapTiles.Add(new MapTile { X = x, Y = y, Z = z, ImageData = data });
                        await databaseContext.SaveChangesAsync(_databaseService);
                    }
                }
            }
            minX *= 2;
            maxX = maxX * 2 + 1;
            minY *= 2;
            maxY = maxY * 2 + 1;
        }
        updateUI.Change(Timeout.Infinite, Timeout.Infinite);
        _downloading = false;
        Console.WriteLine("Done downloading tiles.");
        await InvokeAsync(StateHasChanged);
    }

    // Coordinate conversion functions
    private double TileXToLon(int tileX, int zoom)
    {
        return tileX / Math.Pow(2, zoom) * 360 - 180;
    }

    private double TileYToLat(int tileY, int zoom)
    {
        return Math.Atan(Math.Sinh(Math.PI * (1 - 2 * tileY / Math.Pow(2, zoom)))) * 180.0 / Math.PI;
    }

    private int LonToTileX(double lon, int zoom)
    {
        return (int)Math.Floor((lon + 180.0) / 360.0 * Math.Pow(2.0, zoom));
    }

    private int LatToTileY(double lat, int zoom)
    {
        return (int)Math.Floor((1 - Math.Log(Math.Tan(lat * Math.PI / 180.0) + 1 / Math.Cos(lat * Math.PI / 180.0)) / Math.PI) / 2.0 * Math.Pow(2.0, zoom));
    }

    private double LonToEPSG3857(double lon)
    {
        return (lon * 20037508.34) / 180f;
    }

    private double LatToEPSG3857(double lat)
    {
        return (Math.Log(Math.Tan((lat + 90) * (Math.PI / 360f))) / (Math.PI / 180f)) * (20037508.34 / 180);
    }

    [JSInvokable]
    public async Task OnWaypointSelected(double lat, double lon)
    {
        // Find closest match by lat and lon
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        List<GPSWaypoint> waypoints = await databaseContext.Waypoints.ToListAsync();
        if (waypoints.Count > 0)
        {
            GPSWaypoint closestWaypoint = waypoints.OrderBy(w => Math.Abs(Math.Pow(w.Latitude - lat, 2) + Math.Pow(w.Longitude - lon, 2))).First();
            _GPSWaypointState.SelectedWaypoint = closestWaypoint;
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        _databaseService.UnsubscribeFromTableChanges(typeof(GPSWaypoint), UpdateWaypoints);
        _GPSWaypointState.UnsubscribeFromWaypointSelected(OnWaypointSelected);
        _objectReference?.Dispose();
        try
        {
            if (_jsMap != null)
            {
                await _jsMap.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}