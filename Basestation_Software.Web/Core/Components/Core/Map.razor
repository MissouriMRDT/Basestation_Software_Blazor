@using Microsoft.EntityFrameworkCore
@using System.Diagnostics
@implements IAsyncDisposable
@inject DatabaseService _databaseService
@inject IDbContextFactory<DatabaseContext> _dbContextFactory
@inject GPSWaypointState _GPSWaypointState
@inject NavigationManager _NavigationManager
@inject IJSRuntime _IJSRuntime
@inject RoveCommService _RoveCommService

<style>
    .rover-map-icon:after {
        background-image: url(images/marker.png);
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
        height: 50px;
        width: 50px;
        content: "";
        display: inline-block;
        transform:
            @($"rotateZ({_RoveCommService.Boards.Nav.CompassData}deg);")
    }

    .drone-map-icon:after {
        background-image: url(images/droneMarker.png);
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
        height: 50px;
        width: 50px;
        content: "";
        display: inline-block;
        transform:
            @($"rotateZ({_RoveCommService.Boards.DroneGPS.DronePose_Heading}deg);")
    }

    .tile-hover-border {
        pointer-events: none;
        stroke: #ff7800;
        stroke-width: 3;
        fill: none;
    }
</style>

<div class="component-header">
    <h3>Map</h3>
    <input type="checkbox" @bind=_isLidar>
        @if (_downloading)
        {
            <button class="danger" @onclick=@(() => _downloading = false)><i class="bi-stop" /></button>
            <p style="display: inline">@($"Downloading {_currentlyDownloadingTile} / {_totalDownloadingTiles} ({(float)_currentlyDownloadingTile / _totalDownloadingTiles * 100:000.00}%) {(_isLidar ? "lidar" : "map")} tiles {Math.Clamp(_zoom, 13, 18)}z - 18z")</p>
        }
        else
        {
            <button class="success" @onclick=Download><i class="bi-play" /></button>
            <p style="display: inline">@($"Download {_totalDownloadingTiles} {(_isLidar ? "lidar" : "map")} tiles {Math.Clamp(_zoom, 13, 18)}z - 18z")</p>
        }
    </div>
<button style="position: absolute; left: 10px; top: 100px;" @onclick=@(async () => {await _jsMap!.InvokeVoidAsync("panToMarker", 0);})>
    <img src="/images/marker.png" style="width: 25px;"/>
</button>
<button style="position: absolute; left: 10px; top: 140px; display: @(_dronePresent ? "auto" : "none");" @onclick=@(async () => {await _jsMap!.InvokeVoidAsync("panToMarker", 1);})>
    <img src="/images/droneMarker.png" style="width: 25px;"/>
</button>
<div @ref=_mapContainer class="component-body"></div>

@code
{
    [Parameter]
