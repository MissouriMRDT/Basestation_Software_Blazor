@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable
@inject DatabaseService _databaseService
@inject IDbContextFactory<DatabaseContext> _dbContextFactory
@inject GPSWaypointState _GPSWaypointState
@inject NavigationManager _NavigationManager
@inject IJSRuntime _IJSRuntime
@inject RoveCommService _RoveCommService

<style>
    .rover-map-icon:after {
        background-image: url(images/marker.png);
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
        height: 50px;
        width: 50px;
        content: "";
        display: inline-block;
        transform: rotateZ(
                @(_heading)
                deg);
    }
</style>

<div class="component-header">
    <h3>Map</h3>
</div>
<div @ref=_mapContainer class="component-body"></div>

@code
{
    [Parameter]
    public double InitialLat { get; set; } = 37.951764;
    [Parameter]
    public double InitialLong { get; set; } = -91.778441;
    [Parameter]
    public int InitialZoomLevel { get; set; } = 18;

    private float _heading = 0;
    private ElementReference _mapContainer;
    private IJSObjectReference? _jsMap;
    private DotNetObjectReference<Map>? _objectReference;

    protected override void OnInitialized()
    {
        _RoveCommService.Boards.Nav.OnGPSLatLonAlt(async packet =>
        {
            await _jsMap!.InvokeVoidAsync("addRoverIcon", [packet.Data[0], packet.Data[1]]);
        });

        _RoveCommService.Boards.Nav.OnCompassData(async packet =>
        {
            _heading = packet.Data[1];
            await InvokeAsync(StateHasChanged);
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await using var jsModule = await _IJSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/rover-map.js");
            // Create leaflet map.
            Uri baseUri = new Uri(_NavigationManager.BaseUri);
            _objectReference = DotNetObjectReference.Create(this);
            _jsMap = await jsModule.InvokeAsync<IJSObjectReference>("createRoverMap", [_mapContainer, _objectReference, $"{baseUri.Scheme}://{baseUri.Host}:5000/api/MapTiles/{{z}}/{{y}}/{{x}}.png", $"{baseUri.Scheme}://{baseUri.Host}:5000/api/LidarTiles/{{z}}/{{y}}/{{x}}.png", InitialLat, InitialLong, InitialZoomLevel]);

            // Plot waypoints and keep them updated.
            await PlotWaypoints();
            _databaseService.SubscribeToTableChanges(typeof(GPSWaypoint), UpdateWaypoints);
            _GPSWaypointState.SubscribeToWaypointSelected(OnWaypointSelected);
        }
    }

    private async Task UpdateWaypoints()
    {
        // Update waypoint markers.
        await _jsMap!.InvokeVoidAsync("clearWaypointMarkers");
        await PlotWaypoints();
    }

    private async Task PlotWaypoints()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        List<GPSWaypoint> waypoints = await databaseContext.Waypoints.ToListAsync();
        await Task.WhenAll(waypoints.ConvertAll<Task>(waypoint => _jsMap!.InvokeVoidAsync("addWaypointMarker", [waypoint.Latitude, waypoint.Longitude, waypoint.SearchRadius, ColorTranslator.ToHtml(Color.FromArgb(waypoint.Color)), waypoint.TagID]).AsTask()));
    }

    [JSInvokable]
    public async Task AddWaypoint(double lat, double lon)
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        await databaseContext.Waypoints.AddAsync(new()
        {
            ID = Guid.NewGuid(),
            Latitude = lat,
            Longitude = lon,
        });
        await databaseContext.SaveChangesAsync(_databaseService);
    }

    private async Task OnWaypointSelected(GPSWaypoint? waypoint)
    {
        if (waypoint != null) await PanToCoordinates(waypoint.Latitude, waypoint.Longitude);
    }

    public async Task PanToCoordinates(double lat, double lon)
    {
        await _jsMap!.InvokeVoidAsync("panToCoordinates", [lat, lon]);
    }

    [JSInvokable]
    public async Task OnWaypointSelected(double lat, double lon)
    {
        // Find closest match by lat and lon
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        List<GPSWaypoint> waypoints = await databaseContext.Waypoints.ToListAsync();
        if (waypoints.Count > 0)
        {
            GPSWaypoint closestWaypoint = waypoints.OrderBy(w => Math.Abs(Math.Pow(w.Latitude - lat, 2) + Math.Pow(w.Longitude - lon, 2))).First();
            _GPSWaypointState.SelectedWaypoint = closestWaypoint;
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        _databaseService.UnsubscribeFromTableChanges(typeof(GPSWaypoint), UpdateWaypoints);
        _GPSWaypointState.UnsubscribeFromWaypointSelected(OnWaypointSelected);
        _objectReference?.Dispose();
        try
        {
            if (_jsMap != null)
            {
                await _jsMap.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}