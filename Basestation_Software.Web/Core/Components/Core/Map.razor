    bool _dronePresent = false;
    bool _rangeSet = false;
    int _totalDownloadingTiles = 0;
    int _currentlyDownloadingTile = 0;
    double[] _region = new double[4];
    bool _isLidar = false;
    int _zoom = 18;
    bool _downloading = false;
    // private bool _pathTrackingActive = false;

    // private int _pathTrackingTimeout = 120 * 1000;

