@using System.Diagnostics
@inject RoveCommService _RoveCommService
@inject OpService _opService

<div class="component-header">
    <h3>Gimbals</h3>
    <input type="checkbox" class="output-enabled" @bind=_outputEnabled title="Disable Output" />
    <GamepadSelector @ref=_gamepadSelector OnUpdate=Update />
</div>
<div class="component-body">
    <GamepadScheme @ref=_gamepadScheme AxisNames=_axisNames ControlScheme=_controlScheme />
    <div style="display: flex">
        @for (int i = 0; i < 12; i++)
        {
            <p>@($"{_axisNames[i]}: {_angles[i]:000}")</p>
        }
    </div>
</div>

@code {
    // Declare member variables
    private bool _outputEnabled = true;
    private GamepadSelector? _gamepadSelector;
    private GamepadScheme? _gamepadScheme;
    private ControlScheme _controlScheme = new()
    {
        Binds = [Bind.LSX, Bind.LSY, Bind.RSX, Bind.RSY, Bind.DPadX, Bind.DPadY, Bind.LBumpTrig, Bind.RBumpTrig, Bind.XB, Bind.AY, Bind.None, Bind.None],
        Inversions = [true, true, true, true, false, true, false, false, false, true, false, false]
    };
    public double GIMBAL_SPEED = 80; // deg/s

    private static readonly string[] _axisNames = ["Left Pan", "Left Tilt", "Right Pan", "Right Tilt", "Back Pan", "Back Tilt", "Arm 1 Pan", "Arm 1 Tilt", "Arm 2 Pan", "Arm 2 Tilt", "Auger Pan", "Auger Tilt"];
    private static double[] _angles = [270, 205, 65, 123, 72, 170, 0, 0, 0, 0, 0, 0];

    private async Task Update(Gamepad gamepad, float deltaT)
    {
        if (await ProcessGamepadInput(gamepad, deltaT))
            // Set teleop if controller being used.
            _opService.SetTeleop();
        // It is safe for this component to take no action when the controller is disconnected.
        await InvokeAsync(StateHasChanged);
    }

    // Process gamepad input and return true if rovecomm packets were sent.
    private async Task<bool> ProcessGamepadInput(Gamepad gamepad, float deltaT)
    {
        if (!gamepad.Connected || _gamepadScheme == null) return false;
        float[] inputs = _gamepadScheme.Update(gamepad);

        if (!_outputEnabled) return false;

        for (int i = 0; i < _angles.Length; i++)
            _angles[i] = Math.Clamp(_angles[i] + inputs[i] * GIMBAL_SPEED * deltaT, 0, 270);
        if (Math.Abs(inputs[0]) > 0 || Math.Abs(inputs[1]) > 0) _RoveCommService.Boards.Core.LeftGimbal((short)_angles[0], (short)_angles[1]);
        if (Math.Abs(inputs[2]) > 0 || Math.Abs(inputs[3]) > 0) _RoveCommService.Boards.Core.RightGimbal((short)_angles[2], (short)_angles[3]);
        if (Math.Abs(inputs[4]) > 0 || Math.Abs(inputs[5]) > 0) _RoveCommService.Boards.Core.BackGimbal((short)_angles[4], (short)_angles[5]);
        if (Math.Abs(inputs[6]) > 0 || Math.Abs(inputs[7]) > 0) _RoveCommService.Boards.Arm.ArmGimbal1((short)_angles[6], (short)_angles[7]);
        if (Math.Abs(inputs[8]) > 0 || Math.Abs(inputs[9]) > 0) _RoveCommService.Boards.Arm.ArmGimbal2((short)_angles[8], (short)_angles[9]);
        if (Math.Abs(inputs[10]) > 0 || Math.Abs(inputs[11]) > 0) _RoveCommService.Boards.Auger.AugerGimbal((short)_angles[10], (short)_angles[11]);
        return true;
    }
}