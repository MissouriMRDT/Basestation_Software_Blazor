@using System.Diagnostics
@inject RoveCommService _RoveCommService
@inject OpService _opService

<div class="component-header">
    <h3>Gimbals</h3>
    <div class="vr">&nbsp;</div>
    <input type="checkbox" @bind=OutputDisabled title="Disable Output">
    <GamepadSelector @ref=_gamepadSelector ChangedCallback=GamepadSelectionChanged />
</div>
<div class="component-body">
    <GamepadScheme @ref=_gamepadScheme AxisNames=_axisNames ControlScheme=_controlScheme />
</div>

@code {
    // Declare member variables
    private bool OutputDisabled = false;
    private GamepadSelector _gamepadSelector;
    private GamepadScheme _gamepadScheme;
    private ControlScheme _controlScheme = new()
    {
        Binds = [Bind.LSX, Bind.LSY, Bind.RSX, Bind.RSY, Bind.DPadX, Bind.DPadY, Bind.LBumpTrig, Bind.RBumpTrig, Bind.XB, Bind.AY, Bind.None, Bind.None],
        Inversions = [false, true, false, true, false, true, false, false, false, true, false, false]
    };
    public int UPDATE_INTERVAL = 50; // ms
    public double GIMBAL_SPEED = 80; // deg/s
    private Timer _updateTimer;
    private Stopwatch _stopwatch = new();
    private long _lastTime = 0;

    private static readonly string[] _axisNames = [
    "Left Pan",
"Left Tilt",
"Right Pan",
"Right Tilt",
"Back Pan",
"Back Tilt",
"Arm 1 Pan",
"Arm 1 Tilt",
"Arm 2 Pan",
"Arm 2 Tilt",
"Auger Pan",
"Auger Tilt",
];
    private static double[] _angles = new double[12];

    public Gimbals()
    {
        // Run update function every 100ms
        _updateTimer = new(Update);
        _stopwatch.Start();
    }

    public void GamepadSelectionChanged()
    {
        if (_gamepadSelector.SelectedGamepad == null)
            _updateTimer.Change(Timeout.Infinite, Timeout.Infinite);
        else
            _updateTimer.Change(0, UPDATE_INTERVAL);
    }

    private void Update(object? _)
    {
        // Set teleop if controller being used.
        if (ProcessGamepadInput())
            _opService.SetTeleop();
        // It is safe for this component to take no action when the controller is disconnected.
        InvokeAsync(StateHasChanged);
    }

    // Process gamepad input and return true if rovecomm packets were sent.
    private bool ProcessGamepadInput()
    {
        long now = _stopwatch.ElapsedMilliseconds;
        float deltaT = Math.Min((_lastTime - now) / 1000f, 1f); // Cap deltaT to 1 second.
        _lastTime = now;

        if (_gamepadSelector?.SelectedGamepad == null || !_gamepadSelector.SelectedGamepad.Connected) return false;
        float[] inputs = _gamepadScheme.Update(_gamepadSelector.SelectedGamepad);
        if (OutputDisabled) return false;
        for (int i = 0; i < _angles.Length; i++)
            _angles[i] = Math.Clamp(_angles[i] + inputs[i] * GIMBAL_SPEED / deltaT, -180, 180);
        if (Math.Abs(inputs[0]) > 0 || Math.Abs(inputs[1]) > 0) _RoveCommService.Boards.Core.LeftGimbal((short)_angles[0], (short)_angles[1]);
        if (Math.Abs(inputs[2]) > 0 || Math.Abs(inputs[3]) > 0) _RoveCommService.Boards.Core.RightGimbal((short)_angles[2], (short)_angles[3]);
        if (Math.Abs(inputs[4]) > 0 || Math.Abs(inputs[5]) > 0) _RoveCommService.Boards.Core.BackGimbal((short)_angles[4], (short)_angles[5]);
        if (Math.Abs(inputs[6]) > 0 || Math.Abs(inputs[7]) > 0) _RoveCommService.Boards.Arm.ArmGimbal1((short)_angles[6], (short)_angles[7]);
        if (Math.Abs(inputs[8]) > 0 || Math.Abs(inputs[9]) > 0) _RoveCommService.Boards.Arm.ArmGimbal2((short)_angles[8], (short)_angles[9]);
        if (Math.Abs(inputs[10]) > 0 || Math.Abs(inputs[11]) > 0) _RoveCommService.Boards.Auger.AugerGimbal((short)_angles[10], (short)_angles[11]);
        return true;
    }
}