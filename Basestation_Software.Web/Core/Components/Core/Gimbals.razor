@using System.Diagnostics
@inject RoveCommService _RoveCommService
@inject OpService _opService

<div class="component-header">
    <h3>Gimbals</h3>
    <input type="checkbox" class="output-enabled" @bind=_outputEnabled title="Disable Output" />
    <GamepadSelector @ref=_gamepadSelector OnUpdate=Update />
</div>
<div class="component-body">
    <GamepadScheme @ref=_gamepadScheme AxisNames=_axisNames ControlScheme=_controlScheme />
    <input @bind=_gimbalSpeed type="range" min="0" max="100" step="1" style="max-width:200px" />
    <div style="display: flex">
        @for (int i = 0; i < 12; i++)
        {
            <p>@($"{_axisNames[i]}: {_angles[i]:000}")</p>
        }
    </div>
</div>

@code {
    private struct GimbalAngles
    {
        public double Angle = 0;
        public double Min = 0;
        public double Max = 270;

        public GimbalAngles(double angle, double min, double max) { Angle = angle; Min = min; Max = max; }

        public void Increment(double angle)
        {
            Angle = Math.Clamp(Angle + angle, Min, Max);
        }
    }


    private bool _outputEnabled = true;
    private GamepadSelector? _gamepadSelector;
    private GamepadScheme? _gamepadScheme;
    private ControlScheme _controlScheme = new()
    {
        Binds = [Bind.LSX, Bind.LSY, Bind.RSX, Bind.RSY, Bind.DPadX, Bind.DPadY, Bind.LBumpTrig, Bind.RBumpTrig, Bind.XB, Bind.AY, Bind.XB, Bind.AY],
        Inversions = [true, true, true, true, false, true, false, true, false, true, false, true]
    };
    private double _gimbalSpeed = 75; // deg/s

    private static readonly string[] _axisNames = ["Left Pan", "Left Tilt", "Right Pan", "Right Tilt", "Back Pan", "Back Tilt", "Arm 1 Pan", "Arm 1 Tilt", "Arm 2 Pan", "Arm 2 Tilt", "Auger Pan", "Auger Tilt"];

    private static GimbalAngles[] _angles = [
        new(90, 0, 270), // Left Pan
        new(120, 30, 210), // Left Tilt
        new(220, 0, 270), // Right Pan
        new(90, 0,180), // Right Tilt
        new(120, 50,270), // Back Pan
        new(80, 10, 200), // Back Tilt
        new(0, 0, 270), // Arm 1 Pan
        new(0, 0, 270), // Arm 1 Tilt
        new(0, 0, 270), // Arm 2 Pan
        new(0, 0, 270), // Arm 2 Tilt
        new(60, 0, 180), // Auger Pan
        new(80, 0, 180) // Auger Tilt
    ];

    private async Task Update(Gamepad gamepad, float deltaT)
    {
        if (await ProcessGamepadInput(gamepad, deltaT))
            // Set teleop if controller being used.
            _opService.SetTeleop();
        // It is safe for this component to take no action when the controller is disconnected.
        await InvokeAsync(StateHasChanged);
    }

    // Process gamepad input and return true if rovecomm packets were sent.
    private async Task<bool> ProcessGamepadInput(Gamepad gamepad, float deltaT)
    {
        if (!gamepad.Connected || _gamepadScheme == null) return false;
        float[] inputs = _gamepadScheme.Update(gamepad);

        if (!_outputEnabled) return false;

        for (int i = 0; i < _angles.Length; i++)
            _angles[i].Increment(inputs[i] * _gimbalSpeed * deltaT);
        if (Math.Abs(inputs[0]) > 0 || Math.Abs(inputs[1]) > 0) _RoveCommService.Boards.Core.LeftGimbal((short)_angles[0].Angle, (short)_angles[1].Angle);
        if (Math.Abs(inputs[2]) > 0 || Math.Abs(inputs[3]) > 0) _RoveCommService.Boards.Core.RightGimbal((short)_angles[2].Angle, (short)_angles[3].Angle);
        if (Math.Abs(inputs[4]) > 0 || Math.Abs(inputs[5]) > 0) _RoveCommService.Boards.Core.BackGimbal((short)_angles[4].Angle, (short)_angles[5].Angle);
        if (Math.Abs(inputs[6]) > 0 || Math.Abs(inputs[7]) > 0) _RoveCommService.Boards.Arm.ArmGimbal1((short)_angles[6].Angle, (short)_angles[7].Angle);
        if (Math.Abs(inputs[8]) > 0 || Math.Abs(inputs[9]) > 0) _RoveCommService.Boards.Arm.ArmGimbal2((short)_angles[8].Angle, (short)_angles[9].Angle);
        if (Math.Abs(inputs[10]) > 0 || Math.Abs(inputs[11]) > 0) _RoveCommService.Boards.Auger.AugerGimbal((short)_angles[10].Angle, (short)_angles[11].Angle);
        return true;
    }
}