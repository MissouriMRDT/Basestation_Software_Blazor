@inject CameraService _CameraService
@inject RoveCommService _RoveCommService
@inject IJSRuntime _IJSRuntime
@implements IAsyncDisposable

<style>
    /*Does not work when placed in CameraDisplay.razor.css*/
    .component:has(.camera-display)>.component-move {
        color: var(--secondary);
    }

    .component:has(.camera-display)>.component-delete {
        --primary: var(--primary);
        --secondary: var(--secondary);
    }
</style>

<div class="component-body camera-display">
    <div class="source-buttons-container">
        @for (int _i = 0; _i < 8; _i++)
        {
            var i = _i;
            <button checked=@(sourceIndex == i) class="secondary" @onclick=@(() => SetSource(i))>@(_CameraService.Names[i])</button>
        }
        <button class="camera-display-rotate" @onclick=Rotate><i class="bi-arrow-clockwise" /></button>
        <button onclick="cameras.connect()" title="Connect this tab to WebRTC"><i class="bi-play" /></button>
    </div>
    <div class="video-container" @ref="videoContainer"></div>
</div>

@code {
    private int sourceIndex = 0;
    private ElementReference videoContainer;
    private IJSObjectReference? jsCameraDisplay;

    protected override void OnInitialized()
    {
        _CameraService.Names.CollectionChanged += CameraNamesChanged;
    }

    private async void Rotate()
    {
        if (jsCameraDisplay != null)
        {
            await jsCameraDisplay.InvokeVoidAsync("rotate", 90);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            jsCameraDisplay = await _IJSRuntime.InvokeAsync<IJSObjectReference>("cameras.createCameraDisplay", videoContainer);
        }
    }

    private async Task SetSource(int newSourceIndex)
    {
        sourceIndex = newSourceIndex;
        StateHasChanged();
        if (jsCameraDisplay != null)
        {
            await jsCameraDisplay.InvokeVoidAsync("setCamera", sourceIndex);
        }
    }

    private async void CameraNamesChanged(object? _, object? __) => await InvokeAsync(StateHasChanged);

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        _CameraService.Names.CollectionChanged -= CameraNamesChanged;
        try
        {
            if (jsCameraDisplay != null)
            {
                await jsCameraDisplay.InvokeVoidAsync("dispose");
                await jsCameraDisplay.DisposeAsync();
            }
        }
        catch (Exception)
        {
        }
    }
}