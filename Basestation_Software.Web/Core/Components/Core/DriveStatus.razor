@using FaultCode = RoveComm.Boards.Core.VESCFaultCode
@inject RoveCommService _RoveCommService
@inject IJSRuntime _IJSRuntime

<div class="component-header">
    <h3>Drive Status</h3>
</div>
<div class="component-body" style="display: grid; gap: 1px; grid-template-columns: repeat(5, auto); background-color: #000">
    <p></p>
    <p style="color: #fff">VESC Current (A)</p>
    <p style="color: #fff">Motor Current (A)</p>
    <p style="color: #fff">Speed (%)</p>
    <p style="color: #fff">Fault</p>
    @for (int i = 0; i < 6; i++)
    {
        <p style="background-color: @(_faultCodes[i] == FaultCode.NONE ? "#000" : "#dc3545"); color: #fff;">@_motorNames[i]</p>
        @if (_motorTimeout)
        {
            <p style="background-color: lightgray; color: #000">--</p>
            <p style="background-color: lightgray; color: #000">--</p>
            <p style="background-color: lightgray; color: #000">--</p>
        }
        else
        {
            <p style="background-color: color-mix(in oklab, #ff0000 @(Math.Clamp(_RoveCommService.Boards.Core.VESCCurrents[i], 0, DANGER_INPUT_CURRENT) / DANGER_INPUT_CURRENT * 100)%, #00ff00); color: #000">@($"{_RoveCommService.Boards.Core.VESCCurrents[i]:0.00}")</p>
            <p style="background-color: color-mix(in oklab, #ff0000 @(Math.Clamp(_RoveCommService.Boards.Core.MotorCurrents[i], 0, DANGER_MOTOR_CURRENT) / DANGER_MOTOR_CURRENT * 100)%, #00ff00); color: #000">@($"{_RoveCommService.Boards.Core.MotorCurrents[i]:0.00}")</p>
            <p style="background-color: #00ff00; color: #000">@($"{_RoveCommService.Boards.Core.MotorSpeeds[i] * 100:+000.00;-000.00}")</p>
        }
        <p style="background-color: @(_faultCodes[i] == FaultCode.NONE ? "#198754" : "#dc3545")">@(Enum.GetName<RoveComm.Boards.Core.VESCFaultCode>(_faultCodes[i]))</p>
    }
</div>

@code
{
    private string[] _motorNames = ["FL", "ML", "BL", "FR", "MR", "BR"];
    private bool _motorTimeout = true;
    private RoveComm.Boards.Core.VESCFaultCode[] _faultCodes = new RoveComm.Boards.Core.VESCFaultCode[6];
    private Timer?[] _faultWatchdogs = new Timer?[6];

    const double DANGER_MOTOR_CURRENT = 60;
    const double DANGER_INPUT_CURRENT = 6;

    public const int TELEMETRY_TIMEOUT = 10_000; // ms
    private Timer? TelemetryWatchdog = null!;

    protected override void OnInitialized()
    {
        _RoveCommService.Boards.Core.OnMotorSpeeds(Update);
        _RoveCommService.Boards.Core.OnMotorCurrents(Update);
        _RoveCommService.Boards.Core.OnVESCCurrents(Update);
        _RoveCommService.Boards.Core.OnVESCFault(OnVescFault);

        TelemetryWatchdog = new Timer(async _ =>
        {
            _motorTimeout = true;
            await InvokeAsync(StateHasChanged);
        }, null, TELEMETRY_TIMEOUT, Timeout.Infinite);
    }

    async Task Update<T>(RoveCommPacket<T> _)
    {
        _motorTimeout = false;
        TelemetryWatchdog?.Change(TELEMETRY_TIMEOUT, Timeout.Infinite);
        await InvokeAsync(StateHasChanged);
    }

    private async void OnResetFault(object? context)
    {
        _faultCodes[(int)context!] = FaultCode.NONE;
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnVescFault(RoveCommPacket<byte> packet)
    {
        int i = _RoveCommService.Boards.Core.VESCFault_MotorID;
        if (i < 6)
        {
            _faultCodes[i] = (RoveComm.Boards.Core.VESCFaultCode)_RoveCommService.Boards.Core.VESCFault_FaultCode;
            if (_faultWatchdogs[i] == null)
                _faultWatchdogs[i] = new Timer(OnResetFault, i, TELEMETRY_TIMEOUT, Timeout.Infinite);
            else
                _faultWatchdogs[i]?.Change(TELEMETRY_TIMEOUT, Timeout.Infinite);

            await InvokeAsync(StateHasChanged);
        }
    }
}