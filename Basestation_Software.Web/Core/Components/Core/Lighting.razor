@inject RoveCommService _RoveCommService
@inject OpService _OpState;

<div class="component-header">
    <h3>Lighting</h3>
</div>
<div class="component-body" style="display: flex; align-items: center">
    <p>R</p>
    <input style="width: 20px" @bind=colorComponents[0] />
    <p>G</p>
    <input style="width: 20px" @bind=colorComponents[1] />
    <p>B</p>
    <input style="width: 20px" @bind=colorComponents[2] />
    <p>A</p>
    <input style="width: 20px" @bind=brightness />
    <button class="btn btn-primary" style="justify-self:center;" @onclick=Send>Send</button>
    <div style="width: 24px; height: 24px; background-color: rgb(@colorComponents[0], @colorComponents[1], @colorComponents[2])"></div>
</div>

@code {
    private List<byte> colorComponents = [0, 0, 0];
    private byte brightness = 0;

    private async Task Send()
    {
        await _RoveCommService.SendAsync<byte>("Core", "LEDRGB", colorComponents);
        await _RoveCommService.SendAsync<byte>("Core", "Brightness", [brightness]);
        _OpState.OpColor = Color.FromArgb(colorComponents[0], colorComponents[1], colorComponents[2]);
    }
}