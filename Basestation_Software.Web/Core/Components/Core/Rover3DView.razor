@implements IAsyncDisposable

@inject RoveCommService _RoveCommService
@inject OpService _OpState
@inject IJSRuntime _IJSRuntime

<div class="component-header">
    <h3>3D Rover</h3>
    <input type="checkbox" @bind=_accel />
</div>
<div class="component-body">
    @if (!_dataLoaded)
    {
        <h3>Loading...</h3>
    }
    <div @ref=CanvasContainer style="width: 100%; height: 100%" hidden="@(!_dataLoaded)"></div>
</div>

@code
{
    private ElementReference CanvasContainer;
    private IJSObjectReference? jsRoverView;
    private bool _dataLoaded = false;
    private bool _accel = false;

    protected override void OnInitialized()
    {
        _RoveCommService.Boards.Core.OnAccelerometerData(async packet =>
        {
            // CoreBoard: y-forward, z-up, x-right
            // ThreeJS (WebGL): -z-forward, y-up, x-right
            if (jsRoverView != null)
            {
                if (_accel)
                    await jsRoverView.InvokeVoidAsync("updateAnglesFromUpVector", [_RoveCommService.Boards.Core.AccelerometerData_X, _RoveCommService.Boards.Core.AccelerometerData_Z, -_RoveCommService.Boards.Core.AccelerometerData_Y]);
                else
                    await jsRoverView.InvokeVoidAsync("updateAnglesFromUpVector", [0, 1, 0]);
            }
        });
        _RoveCommService.Boards.Arm.OnPosition(async packet =>
        {
            if (jsRoverView != null)
            {
                await jsRoverView.InvokeVoidAsync("updateArm", [
                _RoveCommService.Boards.Arm.Position_X, _RoveCommService.Boards.Arm.Position_J2, _RoveCommService.Boards.Arm.Position_J3,
                _RoveCommService.Boards.Arm.Position_J4, _RoveCommService.Boards.Arm.Position_J5, _RoveCommService.Boards.Arm.Position_J6]);
                await jsRoverView.InvokeVoidAsync("updateTarget", [true, _RoveCommService.Boards.Arm.Position_GX,  _RoveCommService.Boards.Arm.Position_GY,  _RoveCommService.Boards.Arm.Position_GZ]);
            }
        });
        _RoveCommService.Boards.Arm.OnTarget(async packet =>
        {
            if (jsRoverView != null)
            {
                await jsRoverView.InvokeVoidAsync("updateTargetArm", [
                _RoveCommService.Boards.Arm.Target_X, _RoveCommService.Boards.Arm.Target_J2, _RoveCommService.Boards.Arm.Target_J3,
                _RoveCommService.Boards.Arm.Target_J4, _RoveCommService.Boards.Arm.Target_J5, _RoveCommService.Boards.Arm.Target_J6]);
            }
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await using var jsModule = await _IJSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/rover-3d-view.js");
                jsRoverView = await jsModule.InvokeAsync<IJSObjectReference>("createRoverView", [CanvasContainer]);
            }
            catch
            {
                jsRoverView = null;
            }

            _OpState.SubscribeToStateChanged((Color? c) =>
            {
                if (c != null && jsRoverView != null)
                {
                    _ = jsRoverView.InvokeVoidAsync("updateLighting", [c?.R, c?.G, c?.B]);
                }
            });

            _dataLoaded = true;
            await InvokeAsync(StateHasChanged);
            // component will resize once unhidden
        }

        await InvokeAsync(StateHasChanged);
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        try
        {
            if (jsRoverView != null)
            {
                await jsRoverView.InvokeVoidAsync("dispose");
                await jsRoverView.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }

}