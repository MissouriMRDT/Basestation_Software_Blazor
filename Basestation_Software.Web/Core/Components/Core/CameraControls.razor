@inject RoveCommService _RoveCommService
@inject IJSRuntime _IJSRuntime

<div class="component-header">
    <h3>Camera Controls</h3>
</div>
<div @ref="videoContainer" class="component-body camera-controls">
    <div class="source-buttons-container">
        @for (int i = 0; i < 8; i++)
        {
            // https://stackoverflow.com/questions/54812427/for-loop-not-returning-expected-value-c-sharp-blazor
            var _i = i;
            <button class="secondary @(sourceIndex == _i ? "camera-selected" : "") @(GetClass(_i))" title=@GetTitle(_i) @onclick=@(() => SetSource(_i))>@_i</button>
        }
    </div>
    <p style="grid-area: utilization-1">@utilization1</p>
    <p style="grid-area: utilization-2">@utilization2</p>
    <button style="grid-area: connect" @onclick=ConnectCameras>Connect</button>
    <button style="grid-area: disconnect" @onclick=DisconnectCameras>Disconnect</button>
    <button style="grid-area: restart" @onclick=@(() => ToggleSource(sourceIndex, true))>Restart Camera</button>
    <button style="grid-area: shutdown" @onclick=@(() => ToggleSource(sourceIndex, false))>Shutdown Camera</button>
    <button style="grid-area: screenshot" @onclick=TakePicture>Take Picture</button>
    <button style="grid-area: save" @onclick=SaveImage>Save Image</button>
    <button style="grid-area: panorama" @onclick=TakePano>Take Pano</button>
    <button style="grid-area: arguments" @onclick=@(_ => CameraArgumentsVisible = true)>Arguments</button>
</div>
@if (CameraArgumentsVisible)
{
    <div class="camera-arguments">
        <InputTextArea @bind-Value="@CameraArgumentsValue" style="grid-area: 1 / 1 / 2 / 4" />
        <button @onclick=@(_ => CameraArgumentsVisible = false) class="warning" title="Close"><i class="bi-x-circle" /></button>
        <button @onclick=SetFFMPEGArguments class="success" title="Set FFMPEG Arguments"><i class="bi-camera-video" /></button>
        <button @onclick=SetPictureArguments class="success" title="Set Picture Arguments"><i class="bi-image" /></button>
    </div>
}

@code {
    public const uint TELEMETRY_TIMEOUT = 10_000; // ms
    private System.Threading.Timer TelemetryWatchdog1 = null!;
    private System.Threading.Timer TelemetryWatchdog2 = null!;

    private int sourceIndex = 0;

    private bool connected1 = false;
    private bool connected2 = false;
    private int available1 = 0;
    private int available2 = 0;
    private int streaming1 = 0;
    private int streaming2 = 0;
    private String utilization1 = "cpu0: ???% 1: ???% 2: ???% 3: ???% mem: ???% sd: ???%";
    private String utilization2 = "cpu0: ???% 1: ???% 2: ???% 3: ???% mem: ???% sd: ???%";

    private bool CameraArgumentsVisible = false;
    private String CameraArgumentsValue = "";
    private ElementReference videoContainer;

    protected override void OnInitialized()
    {
        TelemetryWatchdog1 = new System.Threading.Timer(WatchdogTimeout, 1, TELEMETRY_TIMEOUT, Timeout.Infinite);
        TelemetryWatchdog2 = new System.Threading.Timer(WatchdogTimeout, 2, TELEMETRY_TIMEOUT, Timeout.Infinite);

        _RoveCommService.Boards.Camera1.OnAvailableCameras(async packet =>
        {
            available1 = packet.Data[0];
            ResetWatchdog(1);
            await InvokeAsync(StateHasChanged);
        });
        _RoveCommService.Boards.Camera1.OnStreamingCameras(async packet =>
        {
            streaming1 = packet.Data[0];
            ResetWatchdog(1);
            await InvokeAsync(StateHasChanged);
        });
        _RoveCommService.Boards.Camera1.OnUtilization(async packet =>
        {
            utilization1 = $"cpu0: {packet.Data[0]:000}% 1: {packet.Data[1]:000}% 2: {packet.Data[2]:000}% 3: {packet.Data[3]:000}% mem: {packet.Data[4]:000}% sd: {packet.Data[5]:000}%";
            ResetWatchdog(1);
            await InvokeAsync(StateHasChanged);
        });
        _RoveCommService.Boards.Camera1.OnAvailableCameras(async packet =>
        {
            available2 = packet.Data[0];
            ResetWatchdog(2);
            await InvokeAsync(StateHasChanged);
        });
        _RoveCommService.Boards.Camera1.OnStreamingCameras(async packet =>
        {
            streaming2 = packet.Data[0];
            ResetWatchdog(2);
            await InvokeAsync(StateHasChanged);
        });
        _RoveCommService.Boards.Camera1.OnUtilization(async packet =>
        {
            utilization2 = $"cpu0: {packet.Data[0]:000}% 1: {packet.Data[1]:000}% 2: {packet.Data[2]:000}% 3: {packet.Data[3]:000}% mem: {packet.Data[4]:000}% sd: {packet.Data[5]:000}%";
            ResetWatchdog(2);
            await InvokeAsync(StateHasChanged);
        });
    }

    async void WatchdogTimeout(object? pi)
    {
        if ((int?)pi == 1) connected1 = false;
        if ((int?)pi == 2) connected2 = false;
        await InvokeAsync(StateHasChanged);
    }

    void ResetWatchdog(int pi)
    {
        if (pi == 1)
        {
            connected1 = true;
            TelemetryWatchdog1.Change(TELEMETRY_TIMEOUT, Timeout.Infinite);
        }
        if (pi == 2)
        {
            connected2 = true;
            TelemetryWatchdog2.Change(TELEMETRY_TIMEOUT, Timeout.Infinite);
        }
    }

    private String GetClass(int i)
    {
        if (i < 4)
            return !connected1 ? "camera-disconnected" : i < streaming1 ? "camera-streaming" : i < available1 ? "camera-available" : "camera-none";
        else
            return !connected2 ? "camera-disconnected" : i - 4 < streaming2 ? "camera-streaming" : i - 4 < available2 ? "camera-available" : "camera-none";
    }

    private String GetTitle(int i)
    {
        if (i < 4)
            return !connected1 ? "Camera server has not sent RoveComm telemetry to Basestation Server within the last 10s." : i < streaming1 ? "Camera server detects camera, ffmpeg stream started." : i < available1 ? "Camera server detects camera, ffmpeg stream not started." : "Camera server does not detect camera.";
        else
            return !connected2 ? "Camera server has not sent RoveComm telemetry to Basestation Server within the last 10s." : i < streaming2 ? "Camera server detects camera, ffmpeg stream started." : i < available2 ? "Camera server detects camera, ffmpeg stream not started." : "Camera server does not detect camera.";
    }

    private async Task ConnectCameras()
    {
        await _IJSRuntime.InvokeVoidAsync("cameras.connect");
    }

    private async Task DisconnectCameras()
    {
        await _IJSRuntime.InvokeVoidAsync("cameras.disconnect");
    }

    private async Task SetSource(int newSourceIndex)
    {
        sourceIndex = newSourceIndex;
        await InvokeAsync(StateHasChanged);
    }

    private void TakePicture()
    {
        if (sourceIndex < 4)
            _RoveCommService.Boards.Camera1.TakePicture((byte)(sourceIndex % 4), 1);
        else
            _RoveCommService.Boards.Camera2.TakePicture((byte)(sourceIndex % 4), 1);
    }

    private void SaveImage()
    {
        try
        {
            File.WriteAllBytes("CameraScreenshot_" + ((DateTimeOffset)DateTime.Now).ToUnixTimeMilliseconds() + ".png", Convert.FromBase64String("oiwebjfvdkhjgfdghjkwe"));
        }
        catch (Exception e)
        {
            Console.WriteLine($"Error saving image: {e.Message}");
        }
    }

    private async Task TakePano()
    {
        _RoveCommService.Boards.Core.LeftGimbal(-180, 0);
        await Task.Delay(4000);
        TakePicture();
        await Task.Delay(40000);
        for (int i = 0; i < 3; i++)
        {
            _RoveCommService.Boards.Core.LeftGimbal((short)(i * 60 - 180), 0);
            await Task.Delay(2000);
            TakePicture();
            await Task.Delay(40000);
        }
    }

    private void ToggleSource(int source, bool restartStream)
    {
        if (sourceIndex < 4)
            _RoveCommService.Boards.Camera1.ToggleStream((byte)(sourceIndex % 4), (byte)(restartStream ? 1 : 0));
        else
            _RoveCommService.Boards.Camera2.ToggleStream((byte)(sourceIndex % 4), (byte)(restartStream ? 1 : 0));
    }

    private void SetFFMPEGArguments()
    {
        char[] characters = (String.Join("\x1f", CameraArgumentsValue.Split("\n")) + '\x04').ToCharArray();
        if (sourceIndex < 4)
            _RoveCommService.Boards.Camera1.SetFFMPEGArguments(characters);
        else
            _RoveCommService.Boards.Camera2.SetFFMPEGArguments(characters);
    }

    private void SetPictureArguments()
    {
        char[] characters = (String.Join("\x1f", CameraArgumentsValue.Split("\n")) + '\x04').ToCharArray();
        if (sourceIndex < 4)
            _RoveCommService.Boards.Camera1.SetPictureArguments(characters);
        else
            _RoveCommService.Boards.Camera2.SetPictureArguments(characters);
    }
}