    public const uint TELEMETRY_TIMEOUT = 2_000; // ms
    private System.Threading.Timer TelemetryWatchdog1;
    private System.Threading.Timer TelemetryWatchdog2;

    private int _sourceIndex = 0;

    private bool _connected1 = false;
    private bool _connected2 = false;
    private bool[] _streaming = new bool[8];
    private bool[] _connected = new bool[8];
    private FFMPEGParameters[] _ffmpegArguments = new FFMPEGParameters[8];
    private FFMPEGParameters _p { get => _ffmpegArguments[_sourceIndex]; set => _ffmpegArguments[_sourceIndex] = value; }

    public CameraControls()
    {
        TelemetryWatchdog1 = new System.Threading.Timer(WatchdogTimeout, 1, Timeout.Infinite, Timeout.Infinite);
        TelemetryWatchdog2 = new System.Threading.Timer(WatchdogTimeout, 2, Timeout.Infinite, Timeout.Infinite);
        for (int i = 0; i < 8; i++)
        {
            _ffmpegArguments[i] = new();
        }
    }

    protected override void OnInitialized()
    {
        TelemetryWatchdog1.Change(TELEMETRY_TIMEOUT, Timeout.Infinite);
        TelemetryWatchdog2.Change(TELEMETRY_TIMEOUT, Timeout.Infinite);

        _RoveCommService.Boards.Camera1.OnAvailableCameras(async packet =>
        {
            for (int i = 0; i < 4; i++)
            {
                _streaming[i] = (_RoveCommService.Boards.Camera1.AvailableCameras_Streaming & (1 << i)) != 0;
                _connected[i] = (_RoveCommService.Boards.Camera1.AvailableCameras_Connected & (1 << i)) != 0;
            }
            await ResetWatchdog(packet);
        });
        _RoveCommService.Boards.Camera1.OnUtilization(ResetWatchdog);
        _RoveCommService.Boards.Camera2.OnAvailableCameras(async packet =>
        {
            for (int i = 0; i < 4; i++)
            {
                _streaming[i + 4] = (_RoveCommService.Boards.Camera2.AvailableCameras_Streaming & (1 << i)) != 0;
                _connected[i + 4] = (_RoveCommService.Boards.Camera2.AvailableCameras_Connected & (1 << i)) != 0;
            }
            await ResetWatchdog(packet);
        });
        _RoveCommService.Boards.Camera2.OnUtilization(ResetWatchdog);
        _CameraService.Names.CollectionChanged += CameraNamesChanged;
    }

    async void WatchdogTimeout(object? pi)
    {
        if ((int?)pi == 1) _connected1 = false;
        if ((int?)pi == 2) _connected2 = false;
        await InvokeAsync(StateHasChanged);
    }

    async Task ResetWatchdog(RoveCommPacket<byte> packet)
    {
        if (packet.DataID / 1000 == 12)
        {
            _connected1 = true;
            TelemetryWatchdog1.Change(TELEMETRY_TIMEOUT, Timeout.Infinite);
        }
        else if (packet.DataID / 1000 == 13)
        {
            _connected2 = true;
            TelemetryWatchdog2.Change(TELEMETRY_TIMEOUT, Timeout.Infinite);
        }
        await InvokeAsync(StateHasChanged);
    }

    private string GetClass(int i)
    {
        if (i < 4)
            return !_connected1 ? "camera-disconnected" : _streaming[i] ? "camera-streaming" : _connected[i] ? "camera-available" : "camera-none";
        else
            return !_connected2 ? "camera-disconnected" : _streaming[i] ? "camera-streaming" : _connected[i] ? "camera-available" : "camera-none";
    }

    private string GetTitle(int i) => (i < 4 ? !_connected1 : !_connected2) ? "Camera server has not sent RoveComm telemetry to Basestation within the last 10s." : _streaming[i] ? "Camera server detects camera, ffmpeg stream running." : _connected[i] ? "Camera server detects camera, ffmpeg stream not running." : "Camera server does not detect camera.";

    private async Task SetSource(int newSourceIndex)
    {
        _sourceIndex = newSourceIndex;
        await InvokeAsync(StateHasChanged);
    }

    private void TakePicture()
    {
        if (_sourceIndex < 4)
            _RoveCommService.Boards.Camera1.TakePicture((byte)(_sourceIndex % 4), 1);
        else
            _RoveCommService.Boards.Camera2.TakePicture((byte)(_sourceIndex % 4), 1);
    }

    private void SaveImage()
    {
        try
        {
            File.WriteAllBytes("CameraScreenshot_" + ((DateTimeOffset)DateTime.Now).ToUnixTimeMilliseconds() + ".png", Convert.FromBase64String("oiwebjfvdkhjgfdghjkwe"));
        }
        catch (Exception e)
        {
            Console.WriteLine($"Error saving image: {e.Message}");
        }
    }

    private async Task TakePano()
    {
        _RoveCommService.Boards.Core.LeftGimbal(-180, 0);
        await Task.Delay(4000);
        TakePicture();
        await Task.Delay(40000);
        for (int i = 0; i < 3; i++)
        {
            _RoveCommService.Boards.Core.LeftGimbal((short)(i * 60 - 180), 0);
            await Task.Delay(2000);
            TakePicture();
            await Task.Delay(40000);
        }
    }

    private void ToggleSource(int source, bool restartStream)
    {
        if (!_ffmpegArguments[source].Sent)
        {
            SetFFMPEGArguments();
            _ffmpegArguments[source].Sent = true;
        }
        if (_sourceIndex < 4)
            _RoveCommService.Boards.Camera1.ToggleStream((byte)(_sourceIndex % 4), (byte)(restartStream ? 1 : 0));
        else
            _RoveCommService.Boards.Camera2.ToggleStream((byte)(_sourceIndex % 4), (byte)(restartStream ? 1 : 0));
    }

    private void MarkUnsent() => _p.Sent = false;

    private async void CameraNamesChanged(object? _, object? __) => await InvokeAsync(StateHasChanged);

    private (int, int, int, int) GetCropParameters(FFMPEGParameters p, int iw, int ih)
    {
        double zoom = double.Clamp(_p.Zoom, 0.001, 1);
        double x = double.Clamp(_p.X, 0, 1);
        double y = double.Clamp(_p.Y, 0, 1);
        return ((int)(x * iw * (1 - zoom)), (int)(y * ih * (1 - zoom)), (int)(iw * zoom), (int)(ih * zoom));
    }

    private void SetFFMPEGArguments()
    {
        List<string> filters = [];
        (int, int) input_size;
        if (!FFMPEGParameters.LIST_SIZE_WH.TryGetValue(_p.VideoSize, out input_size)) return;

        int fontsize = input_size.Item1 / 20;

        filters.Add(@$"zmq=bind_address='tcp\://127.0.0.1\:555$index'");
        if (_p.FilterFPS != null) filters.Add($"fps={_p.FilterFPS}");
        if (_p.Histogram)
        {
            filters.Add($"split=2[a][b];[b]format=rgb24,histogram,format=yuv420p,scale=-1:{input_size.Item2}[hh];[a][hh]hstack");
        }
        if (_p.Crop)
        {
            (int x, int y, int w, int h) = GetCropParameters(_p, input_size.Item1, input_size.Item2);
            filters.Add(@$"crop=x={x}:y={y}:w={w}:h={h}");
            fontsize = w / 20;
        }
        filters.Add(@$"drawtext=text=|||||||||:fontsize={fontsize}:x='abs(mod(t*(w-text_w)*0.5,(w-text_w)*2)-(w-text_w))':box=1:boxcolor=#8c00ff:fontcolor=#8c00ff");
        string ffmpeg_arguments = $@"-hide_banner
-f
video4linux2
-input_format
{_p.InputFormat}
-framerate
{_p.DeviceFPS}
-video_size
{_p.VideoSize}
-i
$input
-filter:v
{string.Join(",", filters)}
-codec:v
libvpx
-quality
good
-cpu-used
4
-g
5
-error-resilient
1
-auto-alt-ref
1
-f
rtp
-b:v
{_p.Bitrate}
-maxrate
{_p.Bitrate}
-loglevel
16
rtp://$ip:$port?pkt_size=1200";

        char[] characters = ((char)(_sourceIndex % 4) + ffmpeg_arguments.Replace("\n", "\x1f") + '\x00').ToCharArray();
        if (_sourceIndex < 4)
            _RoveCommService.Boards.Camera1.SetFFMPEGArguments(characters);
        else
            _RoveCommService.Boards.Camera2.SetFFMPEGArguments(characters);
    }

    private void CropX()
    {
        MarkUnsent();
        if (!_p.Crop) return;
        (int, int) input_size;
        if (!FFMPEGParameters.LIST_SIZE_WH.TryGetValue(_p.VideoSize, out input_size)) return;

        (int x, int y, int w, int h) = GetCropParameters(_p, input_size.Item1, input_size.Item2);

        char[] characters = ((char)(_sourceIndex % 4) + $"crop x {x}\x00").ToCharArray();
        if (_sourceIndex < 4)
            _RoveCommService.Boards.Camera1.ZMQCommands(characters);
        else
            _RoveCommService.Boards.Camera2.ZMQCommands(characters);
    }

    private void CropY()
    {
        MarkUnsent();
        if (!_p.Crop) return;
        (int, int) input_size;
        if (!FFMPEGParameters.LIST_SIZE_WH.TryGetValue(_p.VideoSize, out input_size)) return;

        (int x, int y, int w, int h) = GetCropParameters(_p, input_size.Item1, input_size.Item2);

        char[] characters = ((char)(_sourceIndex % 4) + $"crop y {y}\x00").ToCharArray();
        if (_sourceIndex < 4)
            _RoveCommService.Boards.Camera1.ZMQCommands(characters);
        else
            _RoveCommService.Boards.Camera2.ZMQCommands(characters);
    }

    private void CropZ()
    {
        MarkUnsent();
        if (!_p.Crop) return;
        (int, int) input_size;
        if (!FFMPEGParameters.LIST_SIZE_WH.TryGetValue(_p.VideoSize, out input_size)) return;

        (int x, int y, int w, int h) = GetCropParameters(_p, input_size.Item1, input_size.Item2);
        int fontsize = w / 20;

        char[] characters = ((char)(_sourceIndex % 4) + $"crop x {x}\x001fcrop y {y}\x001fcrop w {w}\x001fcrop h {h}\x001fdrawtext reinit text=|||||||||:fontsize={fontsize}:x='abs(mod(t*(w-text_w)*0.5,(w-text_w)*2)-(w-text_w))':box=1:boxcolor=#0d6efd:fontcolor=#0d6efd\x00").ToCharArray();
        if (_sourceIndex < 4)
            _RoveCommService.Boards.Camera1.ZMQCommands(characters);
        else
            _RoveCommService.Boards.Camera2.ZMQCommands(characters);
    }

