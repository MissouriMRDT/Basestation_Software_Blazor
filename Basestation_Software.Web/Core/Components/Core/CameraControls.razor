@using System.Diagnostics
@using System.Collections.Specialized
@inject RoveCommService _RoveCommService
@inject CameraService _CameraService
@inject IJSRuntime _IJSRuntime
@implements IDisposable

<div class="component-header">
    <h3>Camera Controls</h3>
</div>
<div class="component-body camera-controls">
    <div class="source-buttons-container">
        @for (int i_ = 0; i_ < 8; i_++)
        {
            // https://stackoverflow.com/questions/54812427/for-loop-not-returning-expected-value-c-sharp-blazor
            var i = i_;
            <button checked=@(_sourceIndex == i) class="secondary @(GetClass(i))" title=@GetTitle(i) @onclick=@(() => SetSource(i))>@(_CameraService.Names[i])</button>
        }
    </div>
    <p style="grid-area: 2 / 1 / 3 / 3; margin-bottom: 4px">@($"cpu0: {_RoveCommService.Boards.Camera1.Utilization_cpu0:000}% 1: {_RoveCommService.Boards.Camera1.Utilization_cpu1:000}% 2: {_RoveCommService.Boards.Camera1.Utilization_cpu2:000}% 3: {_RoveCommService.Boards.Camera1.Utilization_cpu3:000}% mem: {_RoveCommService.Boards.Camera1.Utilization_mem:000}% sd: {_RoveCommService.Boards.Camera1.Utilization_storage:000}% temp: {_RoveCommService.Boards.Camera1.Utilization_temp:000}C")</p>
    <p style="grid-area: 2 / 3 / 3 / 5; margin-bottom: 4px">@($"cpu0: {_RoveCommService.Boards.Camera2.Utilization_cpu0:000}% 1: {_RoveCommService.Boards.Camera2.Utilization_cpu1:000}% 2: {_RoveCommService.Boards.Camera2.Utilization_cpu2:000}% 3: {_RoveCommService.Boards.Camera2.Utilization_cpu3:000}% mem: {_RoveCommService.Boards.Camera2.Utilization_mem:000}% sd: {_RoveCommService.Boards.Camera2.Utilization_storage:000}% temp: {_RoveCommService.Boards.Camera2.Utilization_temp:000}C")</p>
    <button @onclick=@(() => ToggleSource(_sourceIndex, true)) title="Restart Camera"><i class="bi-arrow-clockwise" /></button>
    <button @onclick=@(() => ToggleSource(_sourceIndex, false)) title="Stop Camera"><i class="bi-stop" /></button>
    <button @onclick=TakePicture title="Take Picture"><i class="bi-image" /></button>
    <button @onclick=TakePano title="Take Panorama"><i class="bi-arrows" /></button>
    <input @bind=@(_CameraService.Names[_sourceIndex]) />
    <select @bind=@(_p.Device) @bind:after=@(() => _p = FFMPEGParameters.GetDefault(_p.Device))>
        @foreach (string device in FFMPEGParameters.LIST_DEVICE_FPS.Keys)
        {
            <option value=@device>@device</option>
        }
    </select>
    <select @bind=@(_p.InputFormat) @bind:after=MarkUnsent>
        @foreach (string format in FFMPEGParameters.LIST_DEVICE_FPS[_p.Device].Keys)
        {
            <option value=@format>@format</option>
        }
    </select>
    <select @bind=@(_p.VideoSize) @bind:after=MarkUnsent>
        @if (FFMPEGParameters.LIST_DEVICE_FPS[_p.Device].ContainsKey(_p.InputFormat))
        {
            @foreach (string size in FFMPEGParameters.LIST_DEVICE_FPS[_p.Device][_p.InputFormat].Keys)
            {
                <option value=@size>@size @(FFMPEGParameters.LIST_ASPECT_RATIO.GetValueOrDefault(size))</option>
            }
        }
    </select>
    <select @bind=@(_p.DeviceFPS) @bind:after=MarkUnsent>
        @if (FFMPEGParameters.LIST_DEVICE_FPS[_p.Device].ContainsKey(_p.InputFormat) && FFMPEGParameters.LIST_DEVICE_FPS[_p.Device][_p.InputFormat].ContainsKey(_p.VideoSize))
            @foreach (int fps in FFMPEGParameters.LIST_DEVICE_FPS[_p.Device][_p.InputFormat][_p.VideoSize])
            {
                <option value=@fps>@(fps)fps</option>
            }
        }
    </select>
    <select @bind=@(_p.FilterFPS) @bind:after=MarkUnsent>
        <option value="">None</option>
        @foreach (int fps in FFMPEGParameters.LIST_FILTER_FPS)
        {
            <option value=@fps>@(fps)fps</option>
        }
    </select>
    <select @bind=@(_p.Bitrate) @bind:after=MarkUnsent>
        @foreach (string bitrate in FFMPEGParameters.LIST_BITRATE)
        {
            <option value=@bitrate>@bitrate</option>
        }
    </select>
    <button @onclick=@(() => { _p.Histogram ^= true; MarkUnsent(); }) checked=@(_p.Histogram)><i class="bi-bar-chart-line" /></button>
    <button @onclick=@(() => { _p.Crop ^= true; MarkUnsent(); }) checked=@(_p.Crop)><i class="bi-crop" /></button>
    <input @bind=@(_p.X) @bind:after=CropX type="range" min="0.0" max="1.0" step="0.01" style="margin-block: 5px; grid-column: 1 / 5" />
    <input @bind=@(_p.Y) @bind:after=CropY type="range" min="0.0" max="1.0" step="0.01" style="margin-block: 5px; grid-column: 1 / 5" />
    <input @bind=@(_p.Zoom) @bind:after=CropZ type="range" min="0.01" max="1.0" step="0.01" style="margin-block: 5px; grid-column: 1 / 5" />
</div>

