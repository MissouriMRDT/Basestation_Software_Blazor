@using System.Diagnostics
@inject RoveCommService _RoveCommService
@inject IJSRuntime _IJSRuntime
@implements IDisposable

<div class="component-header">
    <h3>Camera Controls</h3>
</div>
<div class="component-body camera-controls">
    <div class="source-buttons-container">
        @for (int i = 0; i < 8; i++)
        {
            // https://stackoverflow.com/questions/54812427/for-loop-not-returning-expected-value-c-sharp-blazor
            var _i = i;
            <button checked=@(_sourceIndex == _i) class="secondary @(GetClass(_i))" title=@GetTitle(_i) @onclick=@(() => SetSource(_i))>@_i</button>
        }
    </div>
    <p style="grid-area: 2 / 1 / 3 / 3">@($"cpu0: {_RoveCommService.Boards.Camera1.Utilization_cpu0:000}% 1: {_RoveCommService.Boards.Camera1.Utilization_cpu1:000}% 2: {_RoveCommService.Boards.Camera1.Utilization_cpu2:000}% 3: {_RoveCommService.Boards.Camera1.Utilization_cpu3:000}% mem: {_RoveCommService.Boards.Camera1.Utilization_mem:000}% sd: {_RoveCommService.Boards.Camera1.Utilization_storage:000}%")</p>
    <p style="grid-area: 2 / 3 / 3 / 5">@($"cpu0: {_RoveCommService.Boards.Camera2.Utilization_cpu0:000}% 1: {_RoveCommService.Boards.Camera2.Utilization_cpu1:000}% 2: {_RoveCommService.Boards.Camera2.Utilization_cpu2:000}% 3: {_RoveCommService.Boards.Camera2.Utilization_cpu3:000}% mem: {_RoveCommService.Boards.Camera2.Utilization_mem:000}% sd: {_RoveCommService.Boards.Camera2.Utilization_storage:000}%")</p>
    <button @onclick=@(() => ToggleSource(_sourceIndex, true)) title="Restart Camera"><i class="bi-arrow-clockwise" /></button>
    <button @onclick=@(() => ToggleSource(_sourceIndex, false)) title="Stop Camera"><i class="bi-stop" /></button>
    <button @onclick=TakePicture title="Take Picture"><i class="bi-image" /></button>
    <button @onclick=TakePano title="Take Panorama"><i class="bi-arrows" /></button>
    <select @bind=@(_ffmpegPresets[_sourceIndex]) @bind:after=@(() => _ffmpegArguments[_sourceIndex] = FFMPEGParameters.FromPreset(_ffmpegPresets[_sourceIndex]))>
        @foreach (FFMPEGPreset preset in FFMPEGPreset.GetValues(typeof(FFMPEGPreset)))
        {
            <option value="@preset">@preset</option>
        }
    </select>
    <select @bind=@(_ffmpegArguments[_sourceIndex].InputFormat) @bind:after=NowCustom>
        <option value="mjpeg">MJPEG</option>
        <option value="yuyv422">YUYV</option>
    </select>
    <select @bind=@(_ffmpegArguments[_sourceIndex].VideoSize) @bind:after=NowCustom>
        @if (FFMPEGParameters.LIST_DEVICE_FPS.ContainsKey(_ffmpegArguments[_sourceIndex].InputFormat))
        {
            @foreach (string size in FFMPEGParameters.LIST_DEVICE_FPS[_ffmpegArguments[_sourceIndex].InputFormat].Keys)
            {
                <option value=@size>@size @(FFMPEGParameters.LIST_ASPECT_RATIO.GetValueOrDefault(size))</option>
            }
        }
    </select>
    <select @bind=@(_ffmpegArguments[_sourceIndex].DeviceFPS) @bind:after=NowCustom>
        @if (FFMPEGParameters.LIST_DEVICE_FPS.ContainsKey(_ffmpegArguments[_sourceIndex].InputFormat) && FFMPEGParameters.LIST_DEVICE_FPS[_ffmpegArguments[_sourceIndex].InputFormat].ContainsKey(_ffmpegArguments[_sourceIndex].VideoSize))
            @foreach (int fps in FFMPEGParameters.LIST_DEVICE_FPS[_ffmpegArguments[_sourceIndex].InputFormat][_ffmpegArguments[_sourceIndex].VideoSize])
            {
                <option value=@fps>@(fps)fps</option>
            }
        }
    </select>
    <select @bind=@(_ffmpegArguments[_sourceIndex].FilterFPS) @bind:after=NowCustom>
        <option value="">None</option>
        @foreach (int fps in FFMPEGParameters.LIST_FILTER_FPS)
        {
            <option value=@fps>@(fps)fps</option>
        }
    </select>
    <select @bind=@(_ffmpegArguments[_sourceIndex].Bitrate) @bind:after=NowCustom>
        @foreach (string bitrate in FFMPEGParameters.LIST_BITRATE)
        {
            <option value=@bitrate>@bitrate</option>
        }
    </select>
    <button @onclick=@(() => { _ffmpegArguments[_sourceIndex].Histogram ^= true; MarkUnsent(); }) checked=@(_ffmpegArguments[_sourceIndex].Histogram)><i class="bi-bar-chart-line" /></button>
    <button @onclick=@(() => { _ffmpegArguments[_sourceIndex].Crop ^= true; MarkUnsent(); }) checked=@(_ffmpegArguments[_sourceIndex].Crop)><i class="bi-crop" /></button>
    <input @bind=@(_ffmpegArguments[_sourceIndex].X) @bind:after=CropX type="range" min="0.0" max="1.0" step="0.01" style="margin-block: 5px; grid-column: 1 / 5" />
    <input @bind=@(_ffmpegArguments[_sourceIndex].Y) @bind:after=CropY type="range" min="0.0" max="1.0" step="0.01" style="margin-block: 5px; grid-column: 1 / 5" />
    <input @bind=@(_ffmpegArguments[_sourceIndex].Zoom) @bind:after=CropZ type="range" min="0.01" max="1.0" step="0.01" style="margin-block: 5px; grid-column: 1 / 5" />
</div>

@code {
    private enum FFMPEGPreset
    {
        Custom, MinBitrate, MaxResolution, HighResolution, Balanced
    }

    private class FFMPEGParameters
    {
        public FFMPEGParameters() { }
        public string InputFormat = "mjpeg";
        public string VideoSize = "800x600";
        public int DeviceFPS = 20;
        public int? FilterFPS = null;
        public bool Crop = false;
        public double X = 0.5;
        public double Y = 0.5;
        public double Zoom = 1;
        public string Bitrate = "1M";
        public bool Histogram = false;
        public bool Sent = false;

        public static readonly Dictionary<string, Dictionary<string, List<int>>> LIST_DEVICE_FPS = new()
        {
            ["mjpeg"] = new()
            {
                ["3840x2160"] = [30, 25, 20, 15, 10, 5],
                ["3840x2880"] = [15, 10, 5],
                ["3264x2448"] = [15, 10, 5],
                ["2592x1944"] = [30, 25, 20, 15, 10, 5],
                ["2048x1536"] = [30, 25, 20, 15, 10, 5],
                ["1600x1200"] = [30, 25, 20, 15, 10, 5],
                ["1920x1080"] = [30, 25, 20, 15, 10, 5],
                ["1280x960"] = [30, 25, 20, 15, 10, 5],
                ["1280x720"] = [30, 25, 20, 15, 10, 5],
                ["800x600"] = [30, 25, 20, 15, 10, 5],
                ["640x480"] = [30, 25, 20, 15, 10, 5]
            },
            ["yuyv422"] = new()
            {
                ["3840x2160"] = [1],
                ["3840x2880"] = [1],
                ["3264x2448"] = [1],
