@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable
@inject DatabaseService _databaseService
@inject IDbContextFactory<DatabaseContext> _dbContextFactory
@inject GPSWaypointState _GPSWaypointState
@inject NavigationManager _NavigationManager
@inject IJSRuntime _IJSRuntime
@inject RoveCommService _RoveCommService

<style>
    .rover-map-icon:after {
        background-image: url(images/marker.png);
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
        height: 50px;
        width: 50px;
        content: "";
        display: inline-block;
        transform: rotateZ(
                @(_heading)
                deg);
    }
</style>

<div class="card h-100">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h3>Map</h3>
            @if (_cachingMapTiles)
            {
                <div>
                    <h6 class="col">Caching map tiles... (only caches in dev mode)</h6>
                </div>
            }
        </div>
    </div>
    <div class="card-body p-0">
        @if (!_dataLoaded)
        {
            <div class="row">
                <div class="spinner-border " role="status"></div>
                <div class="col">
                    <h3>Loading...</h3>
                </div>
            </div>
        }
        else
        {
            <div @ref=MapContainer class="w-100 h-100" style="position: relative;"></div>
        }
    </div>
</div>

@code
{
    // Component parameters.
    [Parameter]
    public double InitialLat { get; set; } = 37.951764;
    [Parameter]
    public double InitialLong { get; set; } = -91.778441;
    [Parameter]
    public int InitialZoomLevel { get; set; } = 18;

    // Declare page member variables.
    private float _heading = 0;
    private ElementReference MapContainer;
    private IJSObjectReference? jsRoverMap;
    private DotNetObjectReference<RoverMap>? ObjectReference;

    // Flags.
    private bool _dataLoaded = false;
    private bool _cachingMapTiles = false;

    protected override async Task OnInitializedAsync()
    {
        // Toggle component is done loading.
        _dataLoaded = true;
        await InvokeAsync(StateHasChanged);
        _RoveCommService.On<double>("Nav", "GPSLatLonAlt", async (packet) =>
        {
            await jsRoverMap!.InvokeVoidAsync("addRoverIcon", [packet.Data[0], packet.Data[1]]);
        });

        _RoveCommService.On<float>("Nav", "IMUData", async (packet) =>
        {
            _heading = packet.Data[1];
            await InvokeAsync(StateHasChanged);
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await using var jsModule = await _IJSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/rover-map.js");
            // Create leaflet map.
            Uri baseUri = new Uri(_NavigationManager.BaseUri);
            ObjectReference = DotNetObjectReference.Create(this);
            jsRoverMap = await jsModule.InvokeAsync<IJSObjectReference>("createRoverMap", [MapContainer, ObjectReference, $"{baseUri.Scheme}://{baseUri.Host}:5000/api/MapTiles/{{z}}/{{y}}/{{x}}.png", $"{baseUri.Scheme}://{baseUri.Host}:5000/api/LidarTiles/{{z}}/{{y}}/{{x}}.png", InitialLat, InitialLong, InitialZoomLevel]);

            // Plot waypoints and keep them updated.
            await PlotWaypoints();
            _databaseService.SubscribeToTableChanges(typeof(GPSWaypoint), UpdateWaypoints);
            _GPSWaypointState.SubscribeToWaypointSelected(OnWaypointSelected);
        }
    }

    private async Task UpdateWaypoints()
    {
        // Update waypoint markers.
        await jsRoverMap!.InvokeVoidAsync("clearWaypointMarkers");
        await PlotWaypoints();
    }

    private async Task PlotWaypoints()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        List<GPSWaypoint> waypoints = await databaseContext.Waypoints.ToListAsync();
        await Task.WhenAll(waypoints.ConvertAll<Task>(waypoint => jsRoverMap!.InvokeVoidAsync("addWaypointMarker", [waypoint.Latitude, waypoint.Longitude, waypoint.SearchRadius, ColorTranslator.ToHtml(Color.FromArgb(waypoint.WaypointColor)), waypoint.TagID]).AsTask()));
    }

    [JSInvokable]
    public async Task AddWaypoint(double lat, double lon)
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        await databaseContext.Waypoints.AddAsync(new()
        {
            ID = Guid.NewGuid(),
            Latitude = lat,
            Longitude = lon,
        });
    }

    private async Task OnWaypointSelected(GPSWaypoint? waypoint)
    {
        if (waypoint != null) await PanToCoordinates(waypoint.Latitude, waypoint.Longitude);
    }

    public async Task PanToCoordinates(double lat, double lon)
    {
        await jsRoverMap!.InvokeVoidAsync("panToCoordinates", [lat, lon]);
    }

    [JSInvokable]
    public async Task OnWaypointSelected(double lat, double lon)
    {
        // Find closest match by lat and lon
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        List<GPSWaypoint> waypoints = await databaseContext.Waypoints.ToListAsync();
        if (waypoints.Count > 0)
        {
            GPSWaypoint closestWaypoint = waypoints.OrderBy(w => Math.Abs(Math.Pow(w.Latitude - lat, 2) + Math.Pow(w.Longitude - lon, 2))).First();
            _GPSWaypointState.SelectedWaypoint = closestWaypoint;
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        _databaseService.UnsubscribeFromTableChanges(typeof(GPSWaypoint), UpdateWaypoints);
        _GPSWaypointState.UnsubscribeFromWaypointSelected(OnWaypointSelected);
        ObjectReference?.Dispose();
        try
        {
            if (jsRoverMap != null)
            {
                await jsRoverMap.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}