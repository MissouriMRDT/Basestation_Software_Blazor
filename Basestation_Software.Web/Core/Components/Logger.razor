@inject LoggerService _LoggerService

<div class="card full-height">
	<div class="card-header">
		<h3>Logger</h3>
	</div>

	<div class="optionBar">
		<div class="optionBarColumn">
			<RadzenButton Style="background-color:#00AA00;" Click="@(ExportLogs)">Export</RadzenButton>
		</div>
		<div class="optionBarColumn">
			<RadzenButton Style="background-color:#AA0000; margin:0px 0px 0px 8px;" Click="@(ClearLogs)">Clear</RadzenButton>
		</div>
		<div class="optionBarColumn">
			<RadzenCheckBox TValue="bool" Style="margin:8px 0px 8px 8px;" Value="@(_LoggerService.autoExport)" Change="@(value => updateAutoExport(value))"></RadzenCheckBox>
		</div>
		<div class="optionBarColumn">
			<label class="optionText">Auto Export</label>
		</div>
		<div class="optionBarColumn optionTextColumn">
			<label class="optionText">Auto Export Size</label>
		</div>
		<div class="optionBarColumn optionTextBoxColumn">
			<RadzenTextBox class="optionTextBox" Value="@(_LoggerService.autoExportSize.ToString())" ValueChanged="@(value => updateAutoExportSize(value))"></RadzenTextBox>
		</div>
		<div class="optionBarColumn optionTextColumn">
			<label class="optionText">Manual Export/Clear Range</label>
		</div>
		<div class="optionBarColumn optionTextBoxColumn">
			<RadzenTextBox class="optionTextBox" Value="" ValueChanged="@(value => updateExportRange_lowerLimit(value))"></RadzenTextBox>
		</div>
		<div class="optionBarColumn optionTextBoxColumn">
			<RadzenTextBox class="optionTextBox" Value="" ValueChanged="@(value => updateExportRange_upperLimit(value))"></RadzenTextBox>
		</div>
		<div class="optionBarColumn optionTextColumn">
			<label class="optionText">Auto Scroll</label>
		</div>
		<div class="optionBarColumn optionTextBoxColumn">
			<RadzenCheckBox TValue="bool" Style="margin:8px 0px 8px 8px;" Value="@(autoScroll)" Change="@(value => updateAutoScroll(value))"></RadzenCheckBox>
		</div>
		<div class="optionBarColumn optionTextColumn">
			<label class="optionText">Page Size</label>
		</div>
		<div class="optionBarColumn optionTextBoxColumn">
			<RadzenTextBox class="optionTextBox" Value="@(pageSize.ToString())" ValueChanged="@(value => onPageSizeUpdate(value))"></RadzenTextBox>
		</div>
	</div>

	<div class="logEntry">
		<div class="logEntryColumn">
			<label>Message</label>
		</div>
		<div class="logEntryColumn">
			<label>Source</label>
		</div>
		<div class="logEntryColumn">
			<label>Time Stamp: @(search_timeStamp)</label>
		</div>
		<div class="logEntryColumn">
			<label>Channel</label>
		</div>
		<div class="logEntryColumn">
			<label>Level</label>
		</div>
		<div class="logEntryColumn">
			<label>Data</label>
		</div>
	</div>

	<div class="logEntry">
		<div class="logEntryColumn">
			<RadzenTextBox Value="@(search_message)" ValueChanged="@(value => updateSearch_message(value))"></RadzenTextBox>
		</div>
		<div class="logEntryColumn">
			<RadzenTextBox Value="@(search_source)" ValueChanged="@(value => updateSearch_source(value))"></RadzenTextBox>
		</div>
		<div class="logEntryColumn">
			<RadzenTextBox Value="@(search_timeStamp)" ValueChanged="@(value => updateSearch_timeStamp(value))"></RadzenTextBox>
		</div>
		<div class="logEntryColumn">
			<RadzenTextBox Value="@(search_channel)" ValueChanged="@(value => updateSearch_channel(value))"></RadzenTextBox>
		</div>
		<div class="logEntryColumn">
			<RadzenTextBox Value="@(search_level)" ValueChanged="@(value => updateSearch_level(value))"></RadzenTextBox>
		</div>
		<div class="logEntryColumn">
			<RadzenTextBox Value="@(search_data)" ValueChanged="@(value => updateSearch_data(value))"></RadzenTextBox>
		</div>
	</div>

	<div class="navBar">
		<div class="navBarColumn_left">
			<RadzenButton class="navBarButton" Click="@(previousPage)">
				<img src="/images/leftArrow.png" width="16" height="16"/>
			</RadzenButton>
		</div>
		<div class="navBarColumn_center">
			<label Style="margin:0px">@(pageStartingIndex + 1) - @(Math.Min(pageEndingIndex + 1, logs_filtered.Count())) / @(logs_filtered.Count())</label>
		</div>
		<div class="navBarColumn_right">
			<RadzenButton class="navBarButton" Click="@(nextPage)">
				<img src="/images/rightArrow.png" width="16" height="16" />
			</RadzenButton>
		</div>
	</div>

	@if (autoScroll) {
		pageEndingIndex = logs_filtered.Count() - 1;
		pageStartingIndex = Math.Max(pageEndingIndex - pageSize, 0);
	}
	@for (int i = pageStartingIndex; i < Math.Min(pageEndingIndex + 1, logs_filtered.Count()); i++)
	{
		LoggerService.LogEntry log = logs_filtered[i];
		<div class="logEntry">
			<div class="logEntryColumn">
				<label>@log.Message</label>
			</div>
			<div class="logEntryColumn">
				<label>@log.Source</label>
			</div>
			<div class="logEntryColumn">
				<label>@log.TimeStamp</label>
			</div>
			<div class="logEntryColumn">
				<label>@log.Channel</label>
			</div>
			<div class="logEntryColumn">
				<label>@log.Level</label>
			</div>
			<div class="logEntryColumn">
				<label>@log.Data</label>
			</div>
		</div>
	}

	<div class="navBar">
		<div class="navBarColumn_left">
			<RadzenButton class="navBarButton" Click="@(previousPage)">
				<img src="/images/leftArrow.png" width="16" height="16" />
			</RadzenButton>
		</div>
		<div class="navBarColumn_center">
			<label Style="margin:0px;">@(pageStartingIndex + 1) - @(Math.Min(pageEndingIndex + 1, logs_filtered.Count())) / @(logs_filtered.Count())</label>
		</div>
		<div class="navBarColumn_right">
			<RadzenButton class="navBarButton" Click="@(nextPage)">
				<img src="/images/rightArrow.png" width="16" height="16" />
			</RadzenButton>
		</div>
	</div>

</div>

@code {

	string? search_message;
	string? search_source;
	string? search_timeStamp;
	string? search_channel;
	string? search_level;
	string? search_data;

	int pageSize = 25;
	int pageStartingIndex = 0;
	int pageEndingIndex;

	int? exportRange_lowerLimit;
	int? exportRange_upperLimit;

	bool autoScroll = true;

	List<LoggerService.LogEntry> logs_filtered = [];

	// private void addLogEntry() {

	// }

	private async Task OnUpdateLog()
	{
		filterLogs(search_message, search_source, search_timeStamp, search_channel, search_level, search_data);
		await InvokeAsync(StateHasChanged);
	}

	// Export Button Functionality
	private async Task ExportLogs() {
		if (exportRange_lowerLimit == null && exportRange_upperLimit == null) {
			_LoggerService.ExportLogs();
		} else if (exportRange_lowerLimit == null) {
			_LoggerService.ExportLogs(0, exportRange_upperLimit); // Issues with null values
		} else if (exportRange_upperLimit == null) {
			_LoggerService.ExportLogs(exportRange_lowerLimit, _LoggerService.GetLogs().Count);
		} else  {
			_LoggerService.ExportLogs(exportRange_lowerLimit, exportRange_upperLimit);
		}
		await InvokeAsync(StateHasChanged);
	}

	// Clear Button Functionality
	private async Task ClearLogs()
	{
		if (exportRange_lowerLimit == null && exportRange_upperLimit == null) {
			_LoggerService.ClearActiveLogs();
		} else if (exportRange_lowerLimit == null) {
			_LoggerService.ClearActiveLogs(0, exportRange_upperLimit); // Issues with null values
		} else if (exportRange_upperLimit == null) {
			_LoggerService.ClearActiveLogs(exportRange_lowerLimit, _LoggerService.GetLogs().Count);
		} else {
			_LoggerService.ClearActiveLogs(exportRange_lowerLimit, exportRange_upperLimit);
		}
		await InvokeAsync(StateHasChanged);
	}

	private async Task updateAutoExportSize(string value) {
		try
		{
			_LoggerService.autoExportSize = int.Parse(value);
		}
		catch
		{
			_LoggerService.autoExportSize = 25;
		}
		await InvokeAsync(StateHasChanged);
	}

	private async Task updateAutoExport(bool value) {
		_LoggerService.autoExport = value;
		await InvokeAsync(StateHasChanged);
	}

	private async Task updateAutoScroll(bool value) {
		autoScroll = value;
		await InvokeAsync(StateHasChanged);
	}

	// Update Export/Clear Range
	private async Task updateExportRange_lowerLimit(string value) {
		try {
			exportRange_lowerLimit = int.Parse(value);
		} catch {
			exportRange_lowerLimit = null;
		}
		await InvokeAsync(StateHasChanged);
	}

	private async Task updateExportRange_upperLimit(string value) {
		try {
			exportRange_upperLimit = int.Parse(value);
		} catch {
			exportRange_upperLimit = null;
		}
		await InvokeAsync(StateHasChanged);
	}

	// Update Search Criteria and Filter Logs Appropriately
	private async Task updateSearch_message(string value)
	{
		search_message = value;
		filterLogs(search_message, search_source, search_timeStamp, search_channel, search_level, search_data);
		await InvokeAsync(StateHasChanged);
	}

	private async Task updateSearch_source(string value)
	{
		search_source = value;
		filterLogs(search_message, search_source, search_timeStamp, search_channel, search_level, search_data);
		await InvokeAsync(StateHasChanged);
	}

	private async Task updateSearch_timeStamp(string value) {
		search_timeStamp = value;
		filterLogs(search_message, search_source, search_timeStamp, search_channel, search_level, search_data);
		await InvokeAsync(StateHasChanged);
	}

	private async Task updateSearch_channel(string value)
	{
		search_channel = value;
		filterLogs(search_message, search_source, search_timeStamp, search_channel, search_level, search_data);
		await InvokeAsync(StateHasChanged);
	}

	private async Task updateSearch_level(string value)
	{
		search_level = value;
		filterLogs(search_message, search_source, search_timeStamp, search_channel, search_level, search_data);
		await InvokeAsync(StateHasChanged);
	}

	private async Task updateSearch_data(string value)
	{
		search_data = value;
		filterLogs(search_message, search_source, search_timeStamp, search_channel, search_level, search_data);
		await InvokeAsync(StateHasChanged);
	}

	protected override async Task OnInitializedAsync()
	{
		_LoggerService.Subscribe(OnUpdateLog);
		filterLogs(search_message, search_source, search_timeStamp, search_channel, search_level, search_data);
		pageEndingIndex = pageStartingIndex + pageSize - 1;

		await InvokeAsync(StateHasChanged);
	}

	private async void onPageSizeUpdate(string newPageSize) {
		if (newPageSize.All(char.IsDigit)) {
			try
			{
				pageSize = int.Parse(newPageSize);
			}
			catch
			{
				pageSize = 25;
			}
		} else {
			pageSize = 25;
		}
		pageEndingIndex = pageStartingIndex + pageSize - 1;

		await InvokeAsync(StateHasChanged);
	}

	private async void nextPage() {
		if (pageStartingIndex + pageSize < logs_filtered.Count()) {
			pageStartingIndex += pageSize;
			pageEndingIndex = Math.Min(pageStartingIndex + pageSize - 1, logs_filtered.Count() - 1);
		}
		await InvokeAsync(StateHasChanged);
	}

	private async void previousPage() {
		if (pageStartingIndex > 0)
		{
			pageStartingIndex -= pageSize;
			if (pageStartingIndex < 0) {
				pageStartingIndex = 0;
			}
			pageEndingIndex = pageStartingIndex + pageSize - 1;
		}
		await InvokeAsync(StateHasChanged);
	}

	public void filterLogs(string? search_message, string? search_source, string? search_timeStamp, string? search_channel, string? search_level, string? search_data)
	{
		logs_filtered.Clear();
		foreach (LoggerService.LogEntry log in _LoggerService.GetLogs())
		{
			if (((search_message == "") || (search_message == null) || (log.Message.Contains(search_message))) &&
				((search_source == "") || (search_source == null) || (log.Source == null) || (log.Source.Contains(search_source))) &&
				((search_timeStamp == "") || (search_timeStamp == null) || (log.TimeStamp.ToString().Contains(search_timeStamp))) &&
				((search_channel == "") || (search_channel == null) || (log.Channel == null) || (log.Channel.Contains(search_channel))) &&
				((search_level == "") || (search_level == null) || (log.Level == null) || (log.Level.Contains(search_level))) &&
				((search_data == "") || (search_data == null) || (log.Data == null) || (log.Data.Contains(search_data))))
			{
				logs_filtered.Add(log);
			}
		}
		pageStartingIndex = 0;
		pageEndingIndex = pageStartingIndex + pageSize - 1;
		return;
	}


}

<style>

	.optionBar {
		display: flex;
		flex-wrap:wrap;
		background-color: var(--bs-secondary-bg);
		margin: 4px;
		padding: 4px;
	}

	.optionBarColumn {
		display: flex;
		background-color: var(--bs-secondary-bg);
		align-items:center;
	}

	.optionTextColumn {
		flex-grow:1;
		flex-direction:row-reverse;
	}

	.optionText {
		width:max-content;
		margin:8px;
	}

	.optionTextBoxColumn {
		flex-shrink:1;
		width:min-content;
	}

	.optionTextBox {
		width:64px;
	}

	.logEntry {
		display:flex;
		background-color: var(--bs-secondary-bg);
		margin:4px;
		padding:4px;
	}

	.logEntryColumn {
		display:flex;
		flex-grow:1;
		flex-basis:0;
		overflow:hidden;
	}

	.navBar {
		display:flex;
		background-color: var(--bs-secondary-bg);
		margin:4px;
		padding:4px;
	}

	.navBarColumn_left {
		display:flex;
		background-color: var(--bs-secondary-bg);
		flex-shrink:1;
		flex-basis:0;
	}

	.navBarColumn_center {
		display:flex;
		background-color: var(--bs-secondary-bg);
		flex-grow:1;
		flex-basis:0;
		align-items:center;
		justify-content:center;
	}

	.navBarColumn_right {
		display:flex;
		background-color: var(--bs-secondary-bg);
		flex-shrink:1;
		flex-basis:0;
	}

	.navBarButton {
		background-color:#f7f7f7 !important;
	}

</style>
