@inject RoveCommService _RoveCommService
@inject IJSRuntime _IJSRuntime
@implements IDisposable

<style>
    .camera-display {
        display: grid;
        padding: 0;
        grid-template-columns: 1fr 1fr 1fr 1fr;
        grid-template-rows: 1fr min-content min-content min-content;
        grid-template-areas:
            "video video video video"
            "source-buttons source-buttons source-buttons source-buttons"
            "connect disconnect restart shutdown"
            "screenshot save panorama rotate";
        place-items: stretch stretch;
    }

    .video-display {
        grid-area: video;
        height: 100%;
    }

    .source-buttons-container {
        grid-area: source-buttons;
        display: flex;
        flex-direction: row;
        margin-inline: 5%;
        margin-block: 1%;
    }

    .source-buttons-container button {
        margin: 1px;
        flex: 1;
    }

    .source-buttons-container :not(:first-child):not(:last-child) {
        border-radius: 0;
    }

    .source-buttons-container :first-child {
        border-radius: 20px 0 0 20px;
    }

    .source-buttons-container :last-child {
        border-radius: 0 20px 20px 0;
    }
</style>

<div class="card h-100">
    <div class="card-header">
        <h3>Camera Display</h3>
    </div>
    <div @ref="videoContainer" class="card-body camera-display">
        <div class="source-buttons-container">
            @for (int i = 0; i < 8; i++)
            {
                // https://stackoverflow.com/questions/54812427/for-loop-not-returning-expected-value-c-sharp-blazor
                var _i = i;
                <button class="@("btn btn-secondary " + ((_sourceIndex == _i) ? "active" : ""))" @onclick="() => SetSource(_i)">@(_i)</button>
            }
        </div>
        @* <div class="source-buttons-container" style="margin-block: 1%"> *@
        @*     @for (int i = 0; i < CameraService._sources.Length; i++) *@
        @*     { *@
        @*         <button class="power" style="background-image: url(images/@( streamingCams[i] == 1 ? "on.png" : "off.png"));"></button> *@
        @*     } *@
        @* </div> *@
        <button class="btn btn-primary" style="grid-area: connect" onclick="webRTCCameras.connect()">Connect</button>
        <button class="btn btn-primary" style="grid-area: disconnect" onclick="webRTCCameras.disconnect()">Disconnect</button>
        <button class="btn btn-primary" style="grid-area: restart" @onclick="() => ToggleSource(_sourceIndex, 1)">Restart Source</button>
        <button class="btn btn-primary" style="grid-area: shutdown" @onclick="() => ToggleSource(_sourceIndex, 0)">Shutdown Source</button>
        <button class="btn btn-primary" style="grid-area: screenshot" @onclick="TakeScreenshot">Take Screenshot</button>
        <button class="btn btn-primary" style="grid-area: save" @onclick="SaveImage">Save Image</button>
        <button class="btn btn-primary" style="grid-area: panorama" @onclick="TakePano">Take Pano</button>
        <button class="btn btn-primary" style="grid-area: rotate" @onclick="Rotate">Rotate</button>
    </div>
</div>

@code {
    private bool _prerendered = false;
    private int _sourceIndex = 0;
    private int rot = 0;
    private ElementReference videoContainer;
    private IJSObjectReference jsCameraDisplay; 

    private void Rotate()
    {
        rot += 90;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            jsCameraDisplay = await _IJSRuntime.InvokeAsync<IJSObjectReference>("createCameraDisplay", videoContainer);
    }

    private async Task SetSource(int newSourceIndex)
    {
        _sourceIndex = newSourceIndex;
        StateHasChanged();
        await jsCameraDisplay.InvokeVoidAsync("setCamera", _sourceIndex);
    }

    private void TakeScreenshot()
    {
        _ = _RoveCommService.SendAsync<byte>("Camera" + (_sourceIndex < 4 ? "1" : "2"), "TakePicture", [(byte)(_sourceIndex % 4), 1]);
    }

    private void SaveImage()
    {
        Console.WriteLine("Write File");
        try 
        {
            File.WriteAllBytes("CameraScreenshot_" + ((DateTimeOffset)DateTime.Now).ToUnixTimeMilliseconds() + ".png", Convert.FromBase64String("oiwebjfvdkhjgfdghjkwe"));

        }
        catch(Exception e)
        {
            Console.WriteLine("Wrong Format!");
        }
    }

    private async Task TakePano()
    {
        _ = _RoveCommService.SendAsync<short>("Core", "LeftMainGimbalIncrement", [-180, 0]);
        await Task.Delay(4000);
        SaveImage();
        for (int i = 0; i < 4; i++)
        {
            _ = _RoveCommService.SendAsync<short>("Core", "LeftMainGimbalIncrement", [90, 0]);
            await Task.Delay(2000);
            SaveImage();
            TakeScreenshot();
            await Task.Delay(1000);
        }
        
    }

    private void ToggleSource(int source, int data)
    {
        string boardNum = (_sourceIndex < 4 ? "1" : "2");
        _ = _RoveCommService.SendAsync<byte>("Camera" + boardNum, "ToggleStream" + boardNum, [(byte)(_sourceIndex % 4), (byte)data]);
    }

    void IDisposable.Dispose()
    {
    }
}
