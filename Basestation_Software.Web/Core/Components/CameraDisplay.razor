@inject RoveCommService _RoveCommService
@inject IJSRuntime _IJSRuntime
@implements IDisposable

<style>
    .camera-display {
        display: grid;
        padding: 0;
        grid-template-columns: 1fr;
        grid-template-rows: 1fr min-content min-content min-content;
        grid-template-areas:
            "video"
            "source-buttons";
        place-items: stretch stretch;
    }

    .video-display {
        grid-area: video;
        height: 100%;
    }

    .source-buttons-container {
        grid-area: source-buttons;
        display: flex;
        flex-direction: row;
        margin-inline: 5%;
        margin-block: 1%;
    }

    .source-buttons-container button {
        margin: 1px;
        flex: 1;
    }

    .source-buttons-container :not(:first-child):not(:last-child) {
        border-radius: 0;
    }

    .source-buttons-container :first-child {
        border-radius: 20px 0 0 20px;
    }

    .source-buttons-container :last-child {
        border-radius: 0 20px 20px 0;
    }

    .camera-display-rotate {
        position: absolute;
        left: 0;
        right: 0;
        width: 3rem;
    }

    .camera-selected {
        border: 4px solid black;
    }

    .camera-streaming {
        background-color: #65c100 !important;
    }

    .camera-available {
        background-color: #cd9f00 !important;
    }

    .camera-none {
        background-color: #808080 !important;
    }
</style>

<div class="card h-100">
    <div class="card-header">
        <h3>Camera Display</h3>
    </div>
    <div @ref="videoContainer" class="card-body camera-display">
        <div class="source-buttons-container">
            @for (int i = 0; i < 8; i++)
            {
                // https://stackoverflow.com/questions/54812427/for-loop-not-returning-expected-value-c-sharp-blazor
                var _i = i;
                <button class="@("btn btn-secondary " + ((sourceIndex == _i) ? "camera-selected" : "")) @(GetClass(_i))" @onclick="() => SetSource(_i)">@(_i)</button>
            }
        </div>
        <button class="btn btn-primary camera-display-rotate" @onclick="Rotate"><i class="bi bi-arrow-clockwise"></i></button>
    </div>
</div>

@code {
    private bool _prerendered = false;
    private int sourceIndex = 0;

    private int available1 = 0;
    private int available2 = 0;
    private int streaming1 = 0;
    private int streaming2 = 0;

    private int rot = 0;
    private ElementReference videoContainer;
    private IJSObjectReference jsCameraDisplay;

    protected override async Task OnInitializedAsync()
    {
        _RoveCommService.On<byte>("Camera1", "AvailableCameras", async (packet) =>
        {
            available1 = packet.Data[0];
            await InvokeAsync(StateHasChanged);
        });
        _RoveCommService.On<byte>("Camera1", "StreamingCameras", async (packet) =>
        {
            streaming1 = packet.Data[0];
            await InvokeAsync(StateHasChanged);
        });
        _RoveCommService.On<byte>("Camera2", "AvailableCameras", async (packet) =>
        {
            available2 = packet.Data[0];
            await InvokeAsync(StateHasChanged);
        });
        _RoveCommService.On<byte>("Camera2", "StreamingCameras", async (packet) =>
        {
            streaming2 = packet.Data[0];
            await InvokeAsync(StateHasChanged);
        });
    }

    private String GetClass(int i) {
        if (i < 4)
            return i < streaming1 ? "camera-streaming" : i < available1 ? "camera-available" : "camera-none";
        else
            return i - 4 < streaming2 ? "camera-streaming" : i - 4 < available2 ? "camera-available" : "camera-none";
    }

    private async void Rotate()
    {
        rot += 90;
        await jsCameraDisplay.InvokeVoidAsync("rotate", rot);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            jsCameraDisplay = await _IJSRuntime.InvokeAsync<IJSObjectReference>("createCameraDisplay", videoContainer);
    }

    private async Task SetSource(int newSourceIndex)
    {
        sourceIndex = newSourceIndex;
        StateHasChanged();
        await jsCameraDisplay.InvokeVoidAsync("setCamera", sourceIndex);
    }

    void IDisposable.Dispose()
    {
    }
}
