@inject CameraService _CameraService
@implements IDisposable

<link rel="stylesheet" type="text/css" href="CameraDisplay.razor.css?version=0.1">

<div class="card full-height">
    <div class="card-header">
        <h3>Camera Display</h3>
    </div>
    <div class="cam-container">
        <img class="cam-display" src="@_frameData" />
    </div>
    <div class="source-buttons-container">
        @for (int i = 0; i < 8; i++)
        {
            // https://stackoverflow.com/questions/54812427/for-loop-not-returning-expected-value-c-sharp-blazor
            var _i = i;
            <button class="@("btn btn-secondary " + ((_sourceIndex == _i) ? "active" : ""))" @onclick="() => SetSource(_i)">@(_i + 1)</button>
        }
    </div>

    <div class="settings-container">
        <div class="settings-row">
            <button @onclick="RestartCam">restart reciever</button>
            <button @onclick="ToggleSource">toggle current source</button>
            <button @onclick="TakeScreenshot">take screenshot</button>
        </div>
        @code {
            // settings input variables
            private int _framerateInput = 30;
            private int _bitrateInput = 24000;
            private int _resolutionInputX = 320;
            private int _resolutionInputY = 240;

        }
        <div class="settings-row">
            <button @onclick="() => ChangeFramerate(_framerateInput)">apply framerate</button>
            <input @bind="_framerateInput" type="number">
        </div>

        <div class="settings-row">
            <button @onclick="() => ChangeBitrate(_bitrateInput)">apply bitrate</button>
            <input @bind="_bitrateInput" type="number">
        </div>

        <div class="settings-row">
            <button @onclick="() => ChangeResolution(_resolutionInputX, _resolutionInputY)">apply resolution</button>
            <input @bind="_resolutionInputX" type="number">x<input @bind="_resolutionInputY" type="number">
        </div>
    </div>
</div>

@code {
    private bool _prerendered = false;
    private int _sourceIndex = 0;
    private string? _frameData;

    protected override async Task OnInitializedAsync()
    {
        await InvokeAsync(StateHasChanged);
        _CameraService.GetCameraReference(_sourceIndex).FrameNotifier += OnNewFrame;
    }

    private async Task OnNewFrame(string frameData)
    {
        _frameData = frameData;
        await InvokeAsync(StateHasChanged);
    }

    private void SetSource(int newSourceIndex)
    {
        _CameraService.GetCameraReference(_sourceIndex).FrameNotifier -= OnNewFrame;
        _sourceIndex = newSourceIndex;
        _CameraService.GetCameraReference(_sourceIndex).FrameNotifier += OnNewFrame;
        StateHasChanged();

    }

    private void RestartCam()
    {
        _CameraService.Dispose(_sourceIndex);
        _CameraService.InitCapture(_sourceIndex);
    }

    private void ToggleSource()
    {

    }

    private void TakeScreenshot()
    {

    }

    private void ChangeFramerate(int framerate)
    {

    }

    private void ChangeBitrate(int bitrate)
    {

    }

    private void ChangeResolution(int x, int y)
    {
        
    }

    void IDisposable.Dispose()
    {
        if (_prerendered)
        {
            _CameraService.DisposeAll();
        }
        else
        {
            _prerendered = true;
        }
    }
}
