@inject RoveCommService _RoveCommService
@inject IJSRuntime _IJSRuntime
@implements IDisposable

<style>
    .camera-display {
        display: grid;
        padding: 0;
        grid-template-columns: 1fr;
        grid-template-rows: 1fr min-content min-content min-content;
        grid-template-areas:
            "video"
            "source-buttons";
        place-items: stretch stretch;
    }

    .video-display {
        grid-area: video;
        height: 100%;
    }

    .source-buttons-container {
        grid-area: source-buttons;
        display: flex;
        flex-direction: row;
        margin-inline: 5%;
        margin-block: 1%;
    }

    .source-buttons-container button {
        margin: 1px;
        flex: 1;
    }

    .source-buttons-container :not(:first-child):not(:last-child) {
        border-radius: 0;
    }

    .source-buttons-container :first-child {
        border-radius: 20px 0 0 20px;
    }

    .source-buttons-container :last-child {
        border-radius: 0 20px 20px 0;
    }

    .camera-display-rotate {
        position: absolute;
        left: 0;
        right: 0;
        width: 3rem;
    }

    .camera-selected {
        border: 4px solid black;
    }
</style>

<div class="card h-100">
    <div class="card-header">
        <h3>Camera Display</h3>
    </div>
    <div @ref="videoContainer" class="card-body camera-display">
        <div class="source-buttons-container">
            @for (int i = 0; i < 8; i++)
            {
                // https://stackoverflow.com/questions/54812427/for-loop-not-returning-expected-value-c-sharp-blazor
                var _i = i;
                <button class="@("btn btn-secondary " + ((sourceIndex == _i) ? "camera-selected" : ""))" @onclick="() => SetSource(_i)">@(_i)</button>
            }
        </div>
        <button class="btn btn-primary camera-display-rotate" @onclick="Rotate"><i class="bi bi-arrow-clockwise"></i></button>
    </div>
</div>

@code {
    private bool _prerendered = false;
    private int sourceIndex = 0;
    private int rot = 0;
    private ElementReference videoContainer;
    private IJSObjectReference jsCameraDisplay; 

    private async void Rotate()
    {
        rot += 90;
        await jsCameraDisplay.InvokeVoidAsync("rotate", rot);
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            jsCameraDisplay = await _IJSRuntime.InvokeAsync<IJSObjectReference>("createCameraDisplay", videoContainer);
    }

    private async Task SetSource(int newSourceIndex)
    {
        sourceIndex = newSourceIndex;
        StateHasChanged();
        await jsCameraDisplay.InvokeVoidAsync("setCamera", sourceIndex);
    }

    void IDisposable.Dispose()
    {
    }
}
