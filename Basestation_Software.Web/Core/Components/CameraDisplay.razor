@inject CameraService _CameraService
@inject RoveCommService _RoveCommService
@implements IDisposable

<link rel="stylesheet" type="text/css" href="CameraDisplay.razor.css?version=0.1">

<div class="card full-height">
    <div class="card-header">
        <h3>Camera Display</h3>
    </div>
    <div class="card-body">
        <div class="cam-container" style="transform:rotate(@(rot)deg)">
            <img class="cam-display" src=@("data:image/gif;base64," + _frameData)  />
        </div>

        <div class="source-buttons-container" style="margin-block 0.5%">
            @for (int i = 0; i < CameraService._sources.Length; i++)
            {
                // https://stackoverflow.com/questions/54812427/for-loop-not-returning-expected-value-c-sharp-blazor
                var _i = i;
                <button class="@("btn btn-secondary " + ((_sourceIndex == _i) ? "active" : ""))" @onclick="() => SetSource(_i)">@(_i + 1)</button>
            }
        </div>

        <div class="source-buttons-container" style="margin-block: 1%">
            @for (int i = 0; i < CameraService._sources.Length; i++)
            {
                <button class="power" style="background-image: url(images/@( streamingCams[i] == 1 ? "on.png" : "off.png"));"></button>
            }
        </div>

        <div class="d-flex">
            <button class="btn btn-primary" @onclick="RestartCam">restart reciever</button>
            <button class="btn btn-primary" @onclick="() => ToggleSource(_sourceIndex, 1)">restart source</button>
            <button class="btn btn-primary" @onclick="() => ToggleSource(_sourceIndex, 0)">shutdown source</button>
            <button class="btn btn-primary" @onclick="TakeScreenshot">take screenshot</button>
            <button class="btn btn-primary" @onclick="SaveImage">save image</button>
            <button class="btn btn-primary" @onclick="Rotate">rotate</button>
        </div>
    </div>
</div>

@code {
    private bool _prerendered = false;
    private int _sourceIndex = 0;
    private string? _frameData;
    private string _defualtFrameData = "images/loading.jpg";
    private int[] streamingCams = [0, 0, 0, 1, 0, 0, 0, 0];
    private int rot = 0;

    private void Rotate()
    {
        rot += 90;
    }
    protected override async Task OnInitializedAsync()
    {
        await InvokeAsync(StateHasChanged);
        _frameData = _defualtFrameData;
        _CameraService.GetCameraReference(_sourceIndex).FrameNotifier += OnNewFrame;
    }

    private async Task OnNewFrame(string frameData)
    {
        _frameData = frameData;
        await InvokeAsync(StateHasChanged);
    }

    private void SetSource(int newSourceIndex)
    {
        _CameraService.GetCameraReference(_sourceIndex).FrameNotifier -= OnNewFrame;
        _sourceIndex = newSourceIndex;
        _CameraService.GetCameraReference(_sourceIndex).FrameNotifier += OnNewFrame;
        _frameData = _defualtFrameData;
        StateHasChanged();

    }

    private void SetIP(string newIP)
    {
        _CameraService.SetIP(_sourceIndex, newIP);
        RestartCam();
    }

    private void RestartCam()
    {
        _CameraService.Dispose(_sourceIndex);
        _CameraService.InitCapture(_sourceIndex);
    }

    private void TakeScreenshot()
    {
        _ = _RoveCommService.SendAsync<byte>("Camera" + (_sourceIndex < 4 ? "1" : "2"), "TakePicture", [(byte)(_sourceIndex % 4), 1]);
    }

    private void SaveImage()
    {
        Console.WriteLine("Write File");
        File.WriteAllBytes("CameraScreenshot_" + ((DateTimeOffset)DateTime.Now).ToUnixTimeMilliseconds() + ".png", Convert.FromBase64String(_frameData));
    }

    private void TakePano()
    {
        
    }

    private void ToggleSource(int source, int data)
    {
        string boardNum = (_sourceIndex < 4 ? "1" : "2");
        _ = _RoveCommService.SendAsync<byte>("Camera" + boardNum, "ToggleStream" + boardNum, [(byte)(_sourceIndex % 4), (byte)data]);
    }

    void IDisposable.Dispose()
    {
        if (_prerendered)
        {
            _CameraService.DisposeAll();
        }
        else
        {
            _prerendered = true;
        }
    }
}
