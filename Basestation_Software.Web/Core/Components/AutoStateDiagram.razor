@using System.Xml.Linq
@inject RoveCommService _RoveCommService

<!-- Setting up style and scripts for the diagram -->
<html>
<head>
    <link href="_content/Z.Blazor.Diagrams/style.min.css" rel="stylesheet" />
    <link href="_content/Z.Blazor.Diagrams/default.styles.min.css" rel="stylesheet" />
</head>
<body>
    <script src="_content/Z.Blazor.Diagrams/script.min.js"></script>
    <script src="_content/Z.Blazor.Diagrams/script.js"></script>
</body>
</html>

<rect width="50" height="50" style="fill:rgb(2,45,255);stroke-width:3;stroke:rgb(24,76,243)" />

<!-- Displaying the diagram -->
<div class="card full-height">
    <div class="card-header">
        <h3>Autonomy State Diagram</h3>
    </div>
    <div class="card-body">

        <svg style="width:100%; height:800px" preserveAspectRatio="xMidYMax meet">
            @AsMarkupString(diagramRoot)
        </svg>

    </div>
</div>

@code {

    private byte _currState = 0;
    XElement? diagramRoot;
    XElement? idleBox;

    // Helper function to get displayable XML of an XElement
    private MarkupString AsMarkupString(XElement el)
    {
        return (MarkupString)Regex.Replace(el.ToString(), "svg:", String.Empty);
    }

    protected override async Task OnInitializedAsync()
    {
        // Load auto diagram as XElement
        string diagramFilePath = "wwwroot/state-diagram.svg";
        diagramRoot = XElement.Load(diagramFilePath);

        // idleBox = (
        //     from el in diagramRoot.Descendants()
        //     where el.Attribute("id")?.Value == "path9"
        //     select el
        //     ).FirstOrDefault();

        // idleBox?.SetAttributeValue("fill", "#00ff00");

        _RoveCommService.On<byte>("Autonomy", "CurrentState", async (packet) =>
        {
            _currState = packet.Data[0];
            switch (_currState)
            {
                case 0:
                    {
                        //Idle
                        break;
                    }
                case 1:
                    {
                        //Navigating
                        break;
                    }
                case 2:
                    {
                        //Search Pattern
                        break;
                    }
                case 3:
                    {
                        //Approaching Marker
                        break;
                    }
                case 4:
                    {
                        //Approaching Object
                        break;
                    }
                case 5:
                    {
                        //Verifying GPS
                        break;
                    }
                case 6:
                    {
                        //Verifying Marker
                        break;
                    }
                case 7:
                    {
                        //Verifying Object
                        break;
                    }
                case 8:
                    {
                        //Avoidance
                        break;
                    }
                case 9:
                    {
                        //Reversing
                        break;
                    }
                case 10:
                    {
                        //Stuck
                        break;
                    }
            }
            await InvokeAsync(StateHasChanged);
        });
    }


}


