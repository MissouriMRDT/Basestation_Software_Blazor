@implements IDisposable
@inject SwitchMonitorService _SwitchMonitorService

<div class="card full-height">
    <div class="card-header">
        <h3>Network Switch Monitor</h3>
    </div>
    <div class="card-body">
        <button class="btn" @onclick=TestCommand>Test Command</button>
        <svg viewBox="0 0 100 100">
            <style>
                .routed {
                    fill: rgba(255, 8, 0, 0.4);
                }
                .vlan2 {
                    fill: rgba(32, 194, 0, 0.4);
                }
                .vlan3 {
                    fill: rgba(0, 89, 255, 0.4);
                }
                .vlan4 {
                    fill: rgba(255, 174, 0, 0.4);
                }
                .vlan100 {
                    fill: rgba(153, 0, 255, 0.4);
                }
                .connected {
                    stroke: none;
                }
                .notconnect {
                    stroke: yellow;
                }
            </style>
            <image x="0" y="0" width="100" height="100" href="images/Cisco_IE_2000_16TC_GE.png" />
            @for(int i = 0; i < 8; i++)
            {
                <g transform="translate(@((i%2+1)*11), @((i/2+1)*11))">
                    <rect id="fa1-@i" class="@_ports[i].VLan" x="0" y="0" width="9" height="11" />
                    <rect class="@(_ports[i].Connected ? "connected" : "notconnect")" fill="none" x="0" y="0" width="9" height="11" />
                    <line class="@(_ports[i].Connected ? "connected" : "notconnect")" x1="0" y1="0" x2="9" y2="11" />
                    <line class="@(_ports[i].Connected ? "connected" : "notconnect")" x1="9" y1="0" x2="0" y2="11" />
                </g>
            }
            @for(int i = 0; i < 8; i++)
            {
                <g transform="translate(@(29+(i%2+1)*11), @((i/2+1)*11))">
                    <rect id="fa1-@(i+8)" class="@_ports[i+8].VLan" x="0" y="0" width="9" height="11" />
                    <rect class="@(_ports[i+8].Connected ? "connected" : "notconnect")" fill="none" x="0" y="0" width="9" height="11" />
                    <line class="@(_ports[i+8].Connected ? "connected" : "notconnect")" x1="0" y1="0" x2="9" y2="11" />
                    <line class="@(_ports[i+8].Connected ? "connected" : "notconnect")" x1="9" y1="0" x2="0" y2="11" />
                </g>
            }
            <g transform="translate(51, 62.5)">
                <rect id="gi1-1" class="@_ports[16].VLan" x="0" y="0" width="9" height="11" />
                <rect class="@(_ports[16].Connected ? "connected" : "notconnect")" fill="none" x="0" y="0" width="9" height="11" />
                <line class="@(_ports[16].Connected ? "connected" : "notconnect")" x1="0" y1="0" x2="9" y2="11" />
                <line class="@(_ports[16].Connected ? "connected" : "notconnect")" x1="9" y1="0" x2="0" y2="11" />
            </g>
            <g transform="translate(51, 80.5)">
                <rect id="gi1-2" class="@_ports[17].VLan" x="0" y="0" width="9" height="11" />
                <rect class="@(_ports[17].Connected ? "connected" : "notconnect")" fill="none" x="0" y="0" width="9" height="11" />
                <line class="@(_ports[17].Connected ? "connected" : "notconnect")" x1="0" y1="0" x2="9" y2="11" />
                <line class="@(_ports[17].Connected ? "connected" : "notconnect")" x1="9" y1="0" x2="0" y2="11" />
            </g>
        </svg>
    </div>
</div>


@code
{
    public class PortInfo
    {
        public string VLan { get; set; } = "routed";
        public bool Connected { get; set; }
    }
    public PortInfo[] _ports = new PortInfo[18];

    protected override void OnInitialized()
    {
        UpdatePortStatuses();
    }

    private void UpdatePortStatuses()
    {
        var ports = SwitchMonitorService.GetPorts();
        for (int i = 0; i < 16; i++)
        {
            var port = ports.Find(p => p.Port == $"Fa1/{i+1}");
            if (port is not null)
            {
                _ports[i] = new PortInfo {
                        VLan = port.Routed ? "routed" : $"vlan{port.VLan}",
                        Connected = port.Connected
                    };
            }
        }
        for (int i = 0; i < 2; i++)
        {
            var port = ports.Find(p => p.Port == $"Gi1/{i+1}");
            if (port is not null)
            {
                _ports[16+i] = new PortInfo {
                    VLan = port.Routed ? "routed" : $"vlan{port.VLan}",
                    Connected = port.Connected
                };
            }
        }
    }

    private void TestCommand()
    {
        Console.WriteLine("Testing Commands...");
        SwitchMonitorService.GetInterfaces();
        SwitchMonitorService.GetEigrpTopology();
        UpdatePortStatuses();
    }

    void IDisposable.Dispose() { }
}
