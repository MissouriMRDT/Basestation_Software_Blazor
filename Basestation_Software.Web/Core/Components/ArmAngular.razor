@implements IDisposable
@using Microsoft.EntityFrameworkCore
@inject RoveCommService _RoveCommService
@inject DatabaseService _databaseService
@inject IDbContextFactory<DatabaseContext> _dbContextFactory

<div class="card full-height">
    <div class="card-header">
        <h3>Arm Angular</h3>
    </div>
    <div class="card-body">
        <div class="d-flex">
            <label class="form-label">IK Mode</label>
            <InputCheckbox @bind-Value=_isIKMode></InputCheckbox>
        </div>
        <div style="display: flex; flex-wrap: wrap; justify-content: center;">
            @foreach (JointNames joint in Enum.GetValues<JointNames>())
            {
                JointNames _joint = joint;
                <div class="d-flex flex-column" style="flex: 0 1 160px; border-radius: 10px; background-color: var(--bs-secondary-bg); margin: 0.2rem; padding: 0.3rem;">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.1rem" JustifyContent="JustifyContent.Center" Style="">
                        <p style="width: 80px; margin-inline: 0.4rem; margin-bottom:0; text-align: right">@(_isIKMode? Enum.GetName((IKNames)_joint) : Enum.GetName(_joint))</p>
                        <RadzenNumeric TValue="float" Min="-360" Max="360" @bind-value=@(_activeJointValues[_joint])></RadzenNumeric>
                        <button class="btn btn-sm btn-secondary" @onclick="() => SetSingle(_joint)" title="Set Joint"><i class="bi bi-inline-text bi-arrow-up-right" /></button>
                        <button class="btn btn-sm btn-secondary" @onclick="() => GetSingle(_joint)" title="Get Joint"><i class="bi bi-inline-text bi-arrow-down-right" /></button>
                    </RadzenStack>
                    <label class="form-label text-center">@(!_isIKMode ? _lastPosTelemetry?[_joint].ToString("F") ?? "-" : _lastCoordTelemetry?[_joint].ToString("F") ?? "-")</label>
                    @*<label class="form-label text-center">@(_lastCoordTelemetry?[_joint].ToString("F") ?? "-")</label> *@

                </div>
            }
        </div>
        <p style="width: auto; text-align: center">Pitch From Ground: @(_ac.ToString("F"))</p>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" JustifyContent="JustifyContent.Center" Style="margin-block: 1rem">
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="@GetAll">Get All</RadzenButton>
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="@SetAll">Set All</RadzenButton>

        </RadzenStack>

        <RadzenDataGrid @ref="_positionDataGrid" AllowColumnResize="true" AllowAlternatingRows="true" AllowSorting="false" TItem="ArmAngularPosition" SelectionMode="DataGridSelectionMode.Single" AllowRowSelectOnRowClick="true" Data="@_armAngularPositions" Density="Density.Compact" CellRender="@OnCellRender" RowClick="@OnPositionClick" RowDoubleClick="@OnPositionDoubleClick" Style="margin-inline: 10%; height: 11vh; overflow-y: auto;">

            <Columns>
                <RadzenDataGridColumn Filterable="false" Title="Position" Frozen="true" Width="80px" TextAlign="TextAlign.Center">
                    <Template Context="position">
                        <p style="-moz-user-select: none;">@position.Name</p>
                    </Template>

                </RadzenDataGridColumn>

                <RadzenDataGridColumn Filterable="false" Title="Actions" Frozen="true" Width="50px" TextAlign="TextAlign.Center">

                    <Template Context="position">
                        <button class="btn btn-sm btn-danger" title="Delete Position" @onclick="() => DeletePosition(position)"><i class="bi bi-inline-text bi-trash" /></button>
                        <button class="btn btn-sm btn-success" title="Add Keyframe" @onclick="() => AddKeyframe(position)"><i class="bi bi-inline-text bi-plus" /></button>

                    </Template>

                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" JustifyContent="JustifyContent.Center" Style="margin-block: 1rem">
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="() => AddPosition(_positionNameInput)">Save Position</RadzenButton>
            <RadzenTextBox @bind-Value=_positionNameInput></RadzenTextBox>

        </RadzenStack>

        <meter min="0" max="5000" value="@_keyframeStatusMeter"></meter>
        <ol>
            @for (int i = 0; i < _keyframes.Count; i++)
            {
                int _i = i;
                <li style=@(_i == _currentKeyframeIndex ? "font-weight: bold" : "font-weight: auto")>@_keyframes[_i].Name</li>
            }
        </ol>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" @onclick="@(() => PlayKeyframes())">Play</button>
            <button class="btn btn-primary" @onclick="@(() => { _keyframes = new(); InvokeAsync(StateHasChanged); })">Clear</button>

        </div>

    </div>
</div>

@code
{
    private List<ArmAngularPosition> _armAngularPositions = new();
    private ArmAngularPosition? _selectedPosition = null;
    private JointValues _activeJointValues = new();
    private string _positionNameInput = "";
    private RadzenDataGrid<ArmAngularPosition>? _positionDataGrid;
    private JointValues? _lastPosTelemetry;
    private JointValues? _lastCoordTelemetry;
    private bool _isIKMode = false;
    private List<ArmAngularPosition> _keyframes = new();
    private int _currentKeyframeIndex = 0;
    private int _keyframeStatusMeter = 0;
    private bool _enableKeyframeLerping = false;
    private float _ac;

    protected override async Task OnInitializedAsync()
    {
        _RoveCommService.On<float>("Arm", "Positions", async (packet) =>
        {
            if (_lastPosTelemetry == null)
            {
                _lastPosTelemetry = new();
            }

            for (int i = 0; i < packet.DataCount - 1; i++)
            {
                _lastPosTelemetry[(JointNames)i] = packet.Data[i];
            }
            _ac = packet.Data[6];

            await InvokeAsync(StateHasChanged);
        });

        _RoveCommService.On<float>("Arm", "Coordinates", async (packet) =>
        {
            if (_lastCoordTelemetry == null)
            {
                _lastCoordTelemetry = new();
            }

            for (int i = 0; i < packet.DataCount; i++)
            {
                _lastCoordTelemetry[(JointNames)i] = packet.Data[i];
            }
            await InvokeAsync(StateHasChanged);
        });

        _databaseService.SubscribeToTableChanges(typeof(ArmAngularPosition), UpdateArmAngularPositions);

        await UpdateArmAngularPositions();
    }

    private async Task UpdateArmAngularPositions()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        _armAngularPositions = await databaseContext.ArmAngularPositions.ToListAsync();
        _positionDataGrid?.Reload();
        await InvokeAsync(StateHasChanged);
    }

    private void AddKeyframe(ArmAngularPosition position)
    {
        _keyframes.Add(position);
    }

    private async Task PlayKeyframes()
    {
        for (int i = 0; i < _keyframes.Count; i++)
        {
            _currentKeyframeIndex = i;
            ArmAngularPosition k = _keyframes[i];
            _keyframeStatusMeter = 0;
            _ = _RoveCommService.SendAsync<float>(
            "Arm",
            "SetIKPosition",
            [k[JointNames.X], 0f, 0f, 0f, k[JointNames.Pitch], 0f]);

            await InvokeAsync(StateHasChanged);
            for (int j = 0; j < 100; j++)
            {
                _keyframeStatusMeter += 50;
                if (_enableKeyframeLerping)
                {

                }
                _ = InvokeAsync(StateHasChanged);
                await Task.Delay(50);
            }
            await _RoveCommService.SendAsync<byte>("Arm", "Solenoid", [1]);
            await Task.Delay(100);
            await _RoveCommService.SendAsync<byte>("Arm", "Solenoid", [0]);
            await Task.Delay(100);
        }
    }

    private async void ClearKeyframes()
    {
        _keyframes = new();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Runs when a position row is clicked.
    /// </summary>
    /// <param name="args">The event args with info about the click and the row.</param>
    private void OnPositionClick(DataGridRowMouseEventArgs<ArmAngularPosition> args)
    {
        _selectedPosition = args.Data;
        _positionNameInput = args.Data.Name ?? "---";
        StateHasChanged();
    }

    // load position on double-click
    private void OnPositionDoubleClick(DataGridRowMouseEventArgs<ArmAngularPosition> args)
    {
        _activeJointValues = args.Data;
    }

    private void OnCellRender(DataGridCellRenderEventArgs<ArmAngularPosition> args)
    {
        if (args.Data == _selectedPosition)
            args.Attributes.Add("style", $"background-color: #9a0000c0 !important");
    }

    private async Task AddPosition(string positionName)
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        ArmAngularPosition newPosition = new();
        newPosition.Name = positionName;
        newPosition.SetAll(_activeJointValues);
        await databaseContext.ArmAngularPositions.AddAsync(newPosition);
    }

    private async void DeletePosition(ArmAngularPosition position)
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        databaseContext.ArmAngularPositions.Remove(position);
    }

    private void SetAll()
    {
        SetSingle(JointNames.X);
        SetSingle(JointNames.Pitch);
        // if (!_isIKMode)
        // {
        // _ = _RoveCommService.SendAsync<float>(
        // "Arm",
        // "SetIndividualTargetAngles",
        // _activeJointValues.ToList());
        // }
        // else
        // {
        // _ = _RoveCommService.SendAsync<float>(
        // "Arm",
        // "SetIKPosition",
        // _activeJointValues.ToList());
        // }
    }

    private void SetSingle(JointNames joint)
    {
        _ = _RoveCommService.SendAsync<float>(
        "Arm",
        "SetJointTargetAngle",
        [(int)joint, _activeJointValues[joint]]);
    }

    private void GetAll()
    {
        _activeJointValues.SetAll(_lastPosTelemetry ?? new());
    }

    private void GetSingle(JointNames joint)
    {
        _activeJointValues[joint] = _lastPosTelemetry?[joint] ?? 0;
    }

    void IDisposable.Dispose()
    {
        _databaseService.UnsubscribeFromTableChanges(typeof(ArmAngularPosition), UpdateArmAngularPositions);
    }
}