@inject ArmAngularService _ArmAngularService
@inject RoveCommService _RoveCommService
@using Models.Arm

<div class="card full-height">
    <div class="card-header">
        <h3>Arm Angular</h3>
    </div>
    <div class="card-body">
        <div class="d-flex">
            <label class="form-label">IK Mode</label>
            <InputCheckbox @bind-Value=_isIKMode></InputCheckbox>
        </div>
        <div class="d-flex">
            <label class="form-label">Keyframe Increment Lerping</label>
            <InputCheckbox @bind-Value=_enableKeyframeLerping></InputCheckbox>
        </div>
        <div style="display: flex; flex-wrap: wrap; justify-content: center;">
            @foreach (JointNames joint in Enum.GetValues<JointNames>())
            {
                JointNames _joint = joint;
                <div class="d-flex flex-column" style="flex: 0 1 160px; border-radius: 10px; background-color: var(--bs-secondary-bg); margin: 0.2rem; padding: 0.3rem;">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.1rem" JustifyContent="JustifyContent.Center" Style="">
                        <p style="width: 80px; margin-inline: 0.4rem; margin-bottom:0; text-align: right">@(_isIKMode ? Enum.GetName((IKNames)_joint) : Enum.GetName(_joint))</p>
                        <RadzenNumeric TValue="float" Min="-360" Max="360" @bind-value=@(_activeJointValues[_joint])></RadzenNumeric>
                        <button class="btn btn-sm btn-secondary" @onclick="() => SetSingle(_joint)" title="Set Joint"><i class="bi bi-inline-text bi-arrow-up-right" /></button>
                        <button class="btn btn-sm btn-secondary" @onclick="() => GetSingle(_joint)" title="Get Joint"><i class="bi bi-inline-text bi-arrow-down-right" /></button>
                    </RadzenStack>
                    <label class="form-label text-center">@(_lastTelemetry?[_joint].ToString("F") ?? "-")</label>
                </div>
            }
        </div>
        <p style="width: auto; text-align: center">Pitch From Ground: @(_ac.ToString("F"))</p>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" JustifyContent="JustifyContent.Center" Style="margin-block: 1rem">
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="@GetAll">Get All</RadzenButton>
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="@SetAll">Set All</RadzenButton>

        </RadzenStack>

        <RadzenDataGrid 
        @ref="_presetsDataGrid"
        AllowColumnResize="true" 
        AllowAlternatingRows="true" 
        AllowSorting="false"
        TItem="ArmPreset"
        SelectionMode="DataGridSelectionMode.Single"
        AllowRowSelectOnRowClick="true"
        Data="@_cachedPresets"
        Density="Density.Compact"
        CellRender="@OnCellRender"
        RowClick="@OnPresetClick"
        RowDoubleClick="@OnPresetDoubleClick"
        Style="margin-inline: 10%; height: 11vh; overflow-y: auto;">

            <Columns>
                <RadzenDataGridColumn 
                Filterable="false" 
                Title="Preset" 
                Frozen="true" 
                Width="80px"
                TextAlign="TextAlign.Center" >
                    <Template Context="preset">
                        <p style="-moz-user-select: none;">@preset.Name</p>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn 
                Filterable="false"
                Title="Actions"
                Frozen="true"
                Width="50px"
                TextAlign="TextAlign.Center">

                    <Template Context="preset">
                        <button class="btn btn-sm btn-danger" title="Delete Preset" @onclick="() => DeletePreset(preset)"><i class="bi bi-inline-text bi-trash" /></button>
                        <button class="btn btn-sm btn-success" title="Add Keyframe" @onclick="() => AddKeyframe(preset)"><i class="bi bi-inline-text bi-plus" /></button>

                    </Template>

                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" JustifyContent="JustifyContent.Center" Style="margin-block: 1rem">
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="() => AddPreset(_presetNameInput)">Save Preset</RadzenButton>
            <RadzenTextBox @bind-Value=_presetNameInput></RadzenTextBox>

        </RadzenStack>

        <meter min="0" max="5000" value="@_keyframeStatusMeter"></meter>
        <ol>
            @for (int i = 0; i < _keyframes.Count; i++)
            {
                int _i = i;
                <li style=@(_i == _currentKeyframeIndex ? "font-weight: bold" : "font-weight: auto")>@_keyframes[_i].Name</li>
            }
        </ol>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" @onclick="@(() => PlayKeyframes())">Play</button>
            <button class="btn btn-primary" @onclick="@(() => {_keyframes = new(); InvokeAsync(StateHasChanged);})">Clear</button>

        </div>

    </div>
</div>

@code 
{
    private bool OutputDisabled = false;
    private List<ArmPreset>? _cachedPresets;
    private ArmPreset? _selectedPreset = null;
    private JointValues _activeJointValues = new();
    private string _presetNameInput = "";
    private RadzenDataGrid<ArmPreset>? _presetsDataGrid;
    private JointValues? _lastTelemetry;
    private bool _isIKMode = false;
    private List<ArmPreset> _keyframes = new();
    private int _currentKeyframeIndex = 0;
    private int _keyframeStatusMeter = 0;
    private bool _enableKeyframeLerping = false;
    private float _ac;

    protected override async Task OnInitializedAsync()
    {
        _RoveCommService.On<float>("Arm", "Positions", async (packet) =>
        {

            if (_lastTelemetry is null)
            {
                _lastTelemetry = new();
            }

            for (int i = 0; i < packet.DataCount - 1; i++)
            {
                _lastTelemetry[(JointNames)i] = packet.Data[i];
            }
            _ac = packet.Data[6];

            await InvokeAsync(StateHasChanged);
        });
        await _ArmAngularService.RefreshPresets();
        await SyncCache();
        _presetsDataGrid?.Reload();
    }

    private async Task SyncCache()
    {
        _cachedPresets = _ArmAngularService.GetPresets();
        await InvokeAsync(StateHasChanged);
    }

    private void AddKeyframe(ArmPreset preset)
    {
        _keyframes.Add(preset);
    }

    private async Task PlayKeyframes()
    {
        for (int i = 0; i < _keyframes.Count; i++)
        {
            _currentKeyframeIndex = i;
            ArmPreset k = _keyframes[i];
            _keyframeStatusMeter = 0;
            Console.WriteLine(k.Name);
            if (k.Joints != null)
            {
                _ = _RoveCommService.SendAsync<float>(
                    "Arm",
                    "SetIKPosition",
                    [k.Joints[JointNames.X], 0f, 0f, 0f, k.Joints[JointNames.Pitch], 0f]);
            }

                await InvokeAsync(StateHasChanged);
            for (int j = 0; j < 100; j++)
            {
                _keyframeStatusMeter += 50;
                if (_enableKeyframeLerping)
                {

                }
                _ = InvokeAsync(StateHasChanged);
                await Task.Delay(50);
            }
            await _RoveCommService.SendAsync<byte>("Arm", "Solenoid", [1]);
            await Task.Delay(100);
            await _RoveCommService.SendAsync<byte>("Arm", "Solenoid", [0]);
            await Task.Delay(100);
        }
    }

    private async void ClearKeyframes()
    {
        _keyframes = new();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Runs when a preset row is clicked.
    /// </summary>
    /// <param name="args">The event args with info about the click and the row.</param>
    private void OnPresetClick(DataGridRowMouseEventArgs<ArmPreset> args)
    {
        _selectedPreset = args.Data;
        _presetNameInput = args.Data.Name ?? "---";
        StateHasChanged();
    }

    // load preset on double-click
    private void OnPresetDoubleClick(DataGridRowMouseEventArgs<ArmPreset> args)
    {
        _activeJointValues = args.Data.Joints ?? new();
    }

    private void OnCellRender(DataGridCellRenderEventArgs<ArmPreset> args)
    {
        if (args.Data == _selectedPreset)
            args.Attributes.Add("style", $"background-color: #9a0000c0 !important");
    }

    private async Task AddPreset(string presetName)
    {
        ArmPreset newPreset = new();
        newPreset.Name = presetName;
        newPreset.Joints = new();
        newPreset.Joints.SetAll(_activeJointValues);
        await _ArmAngularService.AddPreset(newPreset);
        await SyncCache();
        _presetsDataGrid?.Reload();
    }

    private async void DeletePreset(ArmPreset preset)
    {
        Console.WriteLine("Delete");
        await _ArmAngularService.DeletePreset(preset);
        await SyncCache();
        _presetsDataGrid?.Reload();

    }

    private void SetAll()
    {
        SetSingle(JointNames.X);
        SetSingle(JointNames.Pitch);
        // if (!_isIKMode)
        // {
        //     _ = _RoveCommService.SendAsync<float>(
        //     "Arm",
        //     "SetIndividualTargetAngles",
        //     _activeJointValues.ToList());
        // }
        // else
        // {
        //     _ = _RoveCommService.SendAsync<float>(
        //     "Arm",
        //     "SetIKPosition",
        //     _activeJointValues.ToList());
        // }
    }

    private void SetSingle(JointNames joint)
    {
        _ = _RoveCommService.SendAsync<float>(
            "Arm",
            "SetJointTargetAngle",
            [(int)joint, _activeJointValues[joint]]);
    }

    private void GetAll()
    {
        _activeJointValues.SetAll(_lastTelemetry ?? new());
    }

    private void GetSingle(JointNames joint)
    {
        _activeJointValues[joint] = _lastTelemetry?[joint] ?? 0;
    }
}
