@using Models.Arm
@inject ArmAngularService _ArmAngularService

<div class="card full-height">
    <div class="card-header">
        <h3>Arm Angular</h3>
    </div>
    <div class="card-body">
        <div style="display: flex; flex-wrap: wrap;">
            @foreach (string joint in JointNames.GetNames<JointNames>())
            {
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" JustifyContent="JustifyContent.Center" Style="flex: 0 1 160px;">
                    <RadzenText TextAlign="TextAlign.Right" Style="width: 80px">@joint</RadzenText>
                    <RadzenNumeric TValue="int" Min="0" Max="1000" @bind-value=@_activeJointValues.Values[joint]></RadzenNumeric>
                </RadzenStack>
            }
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" JustifyContent="JustifyContent.Center" Style="margin-block: 1rem">
            <RadzenButton ButtonStyle="ButtonStyle.Secondary">Get Position</RadzenButton>
            <RadzenButton ButtonStyle="ButtonStyle.Secondary">Set Position</RadzenButton>
            <RadzenButton ButtonStyle="ButtonStyle.Secondary">Toggle Auto Telem</RadzenButton>

        </RadzenStack>

        <RadzenDataGrid 
        @ref="_presetsDataGrid"
        AllowColumnResize="true" 
        AllowAlternatingRows="true" 
        AllowSorting="false"
        TItem="ArmPreset"
        SelectionMode="DataGridSelectionMode.Single"
        AllowRowSelectOnRowClick="true"
        Data="@_cachedPresets"
        Density="Density.Compact"
        CellRender="@OnCellRender"
        RowClick="@OnPresetClick"
        RowDoubleClick="@OnPresetDoubleClick"
        Style="margin-inline: 10%; height: 23vh; overflow-y: auto;">

            <Columns>
                <RadzenDataGridColumn 
                Filterable="false" 
                Title="Preset" 
                Frozen="true" 
                Width="80px"
                TextAlign="TextAlign.Center" >
                    <Template Context="preset">
                        <RadzenText Style="-moz-user-select: none;">@preset.Name</RadzenText>
                    </Template>
                </RadzenDataGridColumn>

                <RadzenDataGridColumn 
                Filterable="false"
                Title="Actions"
                Frozen="true"
                Width="20px"
                TextAlign="TextAlign.Center">

                    <Template Context="preset">
                        <button class="btn btn-sm btn-danger" title="Delete Preset" @onclick="() => DeletePreset(preset)"><i class="bi bi-inline-text bi-trash" /></button>
                    </Template>

                </RadzenDataGridColumn>

            </Columns>

        </RadzenDataGrid>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="2rem" JustifyContent="JustifyContent.Center" Style="margin-block: 1rem">
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="() => AddPreset(_presetNameInput)">Save Preset</RadzenButton>
            <RadzenTextBox @bind-Value=_presetNameInput></RadzenTextBox>

        </RadzenStack>

    </div>
</div>

@code 
{
    private List<ArmPreset>? _cachedPresets;
    private ArmPreset? _selectedPreset = null;
    private JointValues _activeJointValues = new();
    private string _presetNameInput = "";
    private RadzenDataGrid<ArmPreset>? _presetsDataGrid;

    protected override async Task OnInitializedAsync()
    {
        await _ArmAngularService.RefreshPresets();
        await SyncCache();
        _presetsDataGrid?.Reload();
    }

    private async Task SyncCache()
    {
        _cachedPresets = _ArmAngularService.GetPresets();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Runs when a preset row is clicked.
    /// </summary>
    /// <param name="args">The event args with info about the click and the row.</param>
    private void OnPresetClick(DataGridRowMouseEventArgs<ArmPreset> args)
    {
        _selectedPreset = args.Data;
        _presetNameInput = args.Data.Name;
        StateHasChanged();
    }

    // load preset on double-click
    private void OnPresetDoubleClick(DataGridRowMouseEventArgs<ArmPreset> args)
    {
        _activeJointValues.Values = new(args.Data.Joints.Values);
    }

    private void OnCellRender(DataGridCellRenderEventArgs<ArmPreset> args)
    {
        if (args.Data == _selectedPreset)
            args.Attributes.Add("style", $"background-color: #9a0000c0 !important");
    }

    private async Task AddPreset(string presetName)
    {
        ArmPreset newPreset = new() 
        {
            Name = presetName,
            Joints = new(),
        };
        newPreset.Joints.Values = new(_activeJointValues.Values);
        await _ArmAngularService.AddPreset(newPreset);
        await SyncCache();
        _presetsDataGrid?.Reload();

    }

    private async void DeletePreset(ArmPreset preset)
    {
        Console.WriteLine("Delete");
        await _ArmAngularService.DeletePreset(preset);
        await SyncCache();
        _presetsDataGrid?.Reload();


    }
}
