@implements IDisposable
@using Basestation_Software.Web.Utils;
@inject RoveCommService _roveCommService;


<div class="card h-100">
    <div class="card-header">
        <div class="col-6 d-flex align-self-center">
            <h5>Arm Controller</h5>
            <div class="vr">&nbsp;</div>
            <GamepadSelector @ref=GamepadSelector_ />
        </div>
    </div>
    <div class="card-body w-100">
        @if (GamepadSelector_?.SelectedGamepad is not null)
        {
            <table>
                <tr><th>Axis</th><th>Value</th></tr>
                @for (int i = 0; i < GamepadSelector_.SelectedGamepad.Axes.Count; i++)
                {
                    <tr><td>@i</td><td>@GamepadSelector_.SelectedGamepad.Axes[i]</td></tr>
                }
                <tr><th>Button</th><th>Value</th><th>Pressed</th></tr>
                @for (int i = 0; i < GamepadSelector_.SelectedGamepad.Buttons.Count; i++)
                {
                    <tr><td>@i</td><td>@GamepadSelector_.SelectedGamepad.Buttons[i].Value</td><td>@GamepadSelector_.SelectedGamepad.Buttons[i].Pressed</td></tr>
                }
            </table>
        }
    </div>
</div>

@code
{
    // State
    private GamepadSelector GamepadSelector_;
    private JointValues _controller = new ();
    private JointValues _arm = new ();
    private JointValues _target = new();
    public JointValues RoverControllerDelta = new(){
        X = 1, J2 = 10, J3 = 10, J4 = 10, Pitch = 10, Roll = 10
    };

    Timer Timer_;

    protected override void OnInitialized()
    {
        _roveCommService.On<float>("Arm","Positions",async(packet) => {
            _arm.X=packet.Data[0];
            _arm.J2=packet.Data[1];
            _arm.J3=packet.Data[2];
            _arm.J4=packet.Data[3];
            _arm.Roll=packet.Data[4];
            _arm.Pitch=packet.Data[5];
        });
        Timer_ = new Timer(_ =>
        {
            InvokeAsync(StateHasChanged);
        }, null, 0, 100);
    }
    private async Task Update() //Collects all of Angles, Filters the angles of each axis, then Sends the Join
    {
        if(GamepadSelector_.SelectedGamepad?.Axes.Count >= 7)
        {
            _controller.X = (float)GamepadSelector_.SelectedGamepad.Axes[0];
            _controller.J2 = (float)GamepadSelector_.SelectedGamepad.Axes[1];
            _controller.J3 = (float)GamepadSelector_.SelectedGamepad.Axes[2];
            _controller.J4 = (float)GamepadSelector_.SelectedGamepad.Axes[5];
            _controller.Pitch = (float)GamepadSelector_.SelectedGamepad.Axes[6];
            _target.X = Math.Abs(_controller.X-_arm.X)>RoverControllerDelta.X?_arm.X:_controller.X;//If the angle is outside ControllerDelta, There will be no change in position
            _target.J2 = Math.Abs(_controller.J2-_arm.J2)>RoverControllerDelta.J2?_arm.J2:_controller.J2;
            _target.J3 = Math.Abs(_controller.J3-_arm.J3)>RoverControllerDelta.J3?_arm.J3:_controller.J3;
            _target.J4 = Math.Abs(_controller.J4-_arm.J4)>RoverControllerDelta.J4?_arm.J4:_controller.J4;
            _target.Pitch = Math.Abs(_controller.Pitch-_arm.Pitch)>RoverControllerDelta.Pitch?_arm.Pitch:_controller.Pitch;
            RoveComm.Boards.Arm.SetIndividualTargetAngles(_roveCommService, _controller.X, _controller.J2, _controller.J3, _controller.J4, _controller.Pitch, _controller.Roll);
        }
    }
    void IDisposable.Dispose() { }
}