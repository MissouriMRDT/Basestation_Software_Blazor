@inject RoveCommService _RoveCommService

<div class="card full-height">
    <div class="card-header">
        <h3>Autonomy Drive Power</h3>
    </div>
    <div class="card-body">

        <div class="row-container">
            <p>Max Speed</p>
            <p style="width: 8%">@(_maxSpeed / 10f)%</p>
            <RadzenSlider TValue="int" Value=@_maxSpeed Change="@(v => _maxSpeed = v)" Min="0" Max="1000" style="width:30%;" />
            <button @onclick="SendSpeed">Submit</button>
        </div>
        <div class="row-container">
            <button @onclick="() => SetWatchdogMode(0)">Teleop Watchdog</button>
            <button @onclick="() => SetWatchdogMode(1)">Autonomy Watchdog</button>
        </div>

    </div>
</div>

@code {
    private int _maxSpeed = 0;

    private void SendSpeed()
    {
        _ = _RoveCommService.SendAsync<float>("Autonomy", "SetMaxSpeed", [_maxSpeed / 1000f]);
    }

    private void SetWatchdogMode(byte mode)
    {
        _ = _RoveCommService.SendAsync<byte>("Autonomy", "SetWatchdogMode", [mode]);
    }
}
