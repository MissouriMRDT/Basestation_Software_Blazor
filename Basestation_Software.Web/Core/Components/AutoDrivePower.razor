@inject RoveCommService _RoveCommService

<div class="card full-height">
    <div class="card-header">
        <h3>Autonomy Drive Power</h3>
    </div>
    <div class="card-body">

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" JustifyContent="JustifyContent.Center">
            <p style="margin: 0">Max Speed</p>
            <p style="width: 60px; margin: 0">@(_maxSpeed / 10f)%</p>
            <RadzenSlider TValue="int" Value=@_maxSpeed Change="@(v => _maxSpeed = v)" Min="0" Max="1000" />
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="SendSpeed">Submit</RadzenButton>
        </RadzenStack>
        <div class="row-container">
            <RadzenButton ButtonStyle="ButtonStyle.Warning" 
            Icon=@(_watchdogPanelCollapsed ? "arrow_right" : "arrow_drop_down") 
            Size="ButtonSize.ExtraSmall" 
            Click="() => _watchdogPanelCollapsed = !_watchdogPanelCollapsed">
            </RadzenButton>
            <hr style="width:100%" />
        </div>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem" JustifyContent="JustifyContent.Center" Visible=@(!_watchdogPanelCollapsed)>
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="() => SetWatchdogMode(0)">Teleop Watchdog</RadzenButton>
            <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="() => SetWatchdogMode(1)">Autonomy Watchdog</RadzenButton>
        </RadzenStack>

    </div>
</div>

@code {
    private int _maxSpeed = 0;
    private bool _watchdogPanelCollapsed = true;

    private void SendSpeed()
    {
        _ = _RoveCommService.SendAsync<float>("Autonomy", "SetMaxSpeed", [_maxSpeed / 1000f]);
    }

    private void SetWatchdogMode(byte mode)
    {
        _ = _RoveCommService.SendAsync<byte>("Core", "SetWatchdogMode", [mode]);
    }
}
