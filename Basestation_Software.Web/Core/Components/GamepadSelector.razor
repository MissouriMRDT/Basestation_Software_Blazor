@implements IDisposable
@inject Toolbelt.Blazor.Gamepad.GamepadList _GamepadList

<button @onclick=@(async _ => Gamepads = await _GamepadList.GetGamepadsAsync())>Update</button>
<select @onchange="ChangeHandler">
    <option value="-1">None</option>
    @for (int i = 0; i < Gamepads.Count; i++)
    {
        <option value="@i">@i - @Gamepads[i].Id</option>
    }
</select>

@code
{
    public delegate void GamepadSelectionChanged();

    // Component parameters
    [Parameter]
    public GamepadSelectionChanged? ChangedCallback { get; set; }

    // State
    private IReadOnlyList<Toolbelt.Blazor.Gamepad.Gamepad> Gamepads = new List<Toolbelt.Blazor.Gamepad.Gamepad>();
    private Dictionary<int, bool> LastPressed = new Dictionary<int, bool>();
    public Toolbelt.Blazor.Gamepad.Gamepad? SelectedGamepad { get; private set; }

    // Returns true if the button is pressed now and wasn't the last time this was called.
    public bool SoftwareDebounce(int buttonIndex)
    {
        if (SelectedGamepad is null) return false;
        if (buttonIndex < 0 || buttonIndex >= SelectedGamepad.Buttons.Count) return false;
        bool pressed = SelectedGamepad.Buttons[buttonIndex].Pressed;
        if (pressed && !LastPressed.GetValueOrDefault(buttonIndex, false))
        {
            LastPressed[buttonIndex] = pressed;
            return true;
        }
        LastPressed[buttonIndex] = pressed;
        return false;
    }

    private void ChangeHandler(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value as string, out int selected) && selected >= 0 && selected < Gamepads.Count)
        {
            if (SelectedGamepad != Gamepads[selected])
            {
                SelectedGamepad = Gamepads[selected];
                LastPressed.Clear();
                ChangedCallback?.Invoke();
            }
            else
            {
                SelectedGamepad = Gamepads[selected];
            }
        }
        else
        {
            if (SelectedGamepad != null)
            {
                SelectedGamepad = null;
                ChangedCallback?.Invoke();
            }
            else
            {
                SelectedGamepad = null;
            }
        }
    }

    void IDisposable.Dispose() { }
}