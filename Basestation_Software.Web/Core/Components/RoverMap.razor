@implements IAsyncDisposable
@inject MapTileService _MapTileService
@inject GPSWaypointService _GPSWaypointService
@inject GPSWaypointState _GPSWaypointState
@inject NavigationManager _NavigationManager
@inject IJSRuntime _IJSRuntime
@inject RoveCommService _RoveCommService
@inject LidarTileService _LidarTileService

<style>
    .rover-map-icon:after {
    background-image: url(images/marker.png);
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    height: 50px;
    width: 50px;
    content: "";
    display: inline-block;
    transform: rotateZ(@(_heading)deg);
    }

    .tile-hover-border {
    pointer-events: none;
    stroke: #ff7800;
    stroke-width: 3;
    fill: none;
    }
</style>

<div class="card h-100">
    <div class="card-header">
        <div class="d-flex justify-content-between align-items-center">
            <h3>Map</h3>
            @if (_cachingMapTiles)
            {
                <div>
                    <h6 class="col">Caching map tiles... (only caches in dev mode)</h6>
                </div>
            }
        </div>
    </div>
    <div class="card-body p-0">
        @if (!_dataLoaded)
        {
            <div class="row">
                <div class="spinner-border " role="status"></div>
                <div class="col">
                    <h3>Loading...</h3>
                </div>
            </div>
        }
        else
        {
            <div @ref=MapContainer class="w-100 h-100" style="position: relative;"></div>
        }
    </div>
</div>

@code
{
    // Component parameters.
    [Parameter]
    public double InitialLat { get; set; } = 37.951764;
    [Parameter]
    public double InitialLong { get; set; } = -91.778441;
    [Parameter]
    public int InitialZoomLevel { get; set; } = 18;

    // Declare page member variables.
    private float _heading = 0;
    private ElementReference MapContainer;
    private IJSObjectReference? jsRoverMap;
    private DotNetObjectReference<RoverMap>? ObjectReference;

    // Flags.
    private bool _dataLoaded = false;
    private bool _cachingMapTiles = false;

    protected override async Task OnInitializedAsync()
    {
        // Toggle component is done loading.
        _dataLoaded = true;
        await InvokeAsync(StateHasChanged);
        _RoveCommService.On<double>("Nav", "GPSLatLonAlt", async (packet) =>
        {
            await jsRoverMap!.InvokeVoidAsync("addRoverIcon", [packet.Data[0], packet.Data[1]]);
        });

        _RoveCommService.On<float>("Nav", "IMUData", async (packet) => 
        {
            _heading = packet.Data[1];
            await InvokeAsync(StateHasChanged);
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await using var jsModule = await _IJSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/rover-map.js");
            // Create leaflet map.
            Uri baseUri = new Uri(_NavigationManager.BaseUri);
            ObjectReference = DotNetObjectReference.Create(this);
            jsRoverMap = await jsModule.InvokeAsync<IJSObjectReference>("createRoverMap", [
                MapContainer,
        ObjectReference,
        $"{baseUri.Scheme}://{baseUri.Host}:5000/api/MapTiles/{{z}}/{{y}}/{{x}}.png",
        $"{baseUri.Scheme}://{baseUri.Host}:5000/api/LidarTiles/{{z}}/{{y}}/{{x}}.png",
        InitialLat,
        InitialLong,
        InitialZoomLevel
            ]);

            // Plot waypoints and keep them updated.
            await PlotWaypoints();
            _GPSWaypointService.SubscribeToWaypointsChanges(OnWaypointSync);
            _GPSWaypointState.SubscribeToWaypointSelected(OnWaypointSelected);
        }
    }

    private async Task OnWaypointSync()
    {
        // Update waypoint markers.
        await jsRoverMap!.InvokeVoidAsync("clearWaypointMarkers");
        await PlotWaypoints();
    }

    private async Task PlotWaypoints()
    {
        await Task.WhenAll(_GPSWaypointService.GetGPSWaypoints().ConvertAll<Task>(waypoint =>
        {
            return jsRoverMap!.InvokeVoidAsync("addWaypointMarker", [
                waypoint.Latitude ?? 0,
        waypoint.Longitude ?? 0,
        waypoint.SearchRadius ?? 0,
        ColorTranslator.ToHtml(Color.FromArgb(waypoint.WaypointColor ?? 0)),
        waypoint.TagID ?? -99
            ]).AsTask();
        }));
    }

    [JSInvokable]
    public async Task AddWaypoint(double lat, double lon)
    {
        await _GPSWaypointService.AddGPSWaypoint(new GPSWaypoint
        {
            ID = -1,
            Name = "",
            Latitude = lat,
            Longitude = lon,
            Altitude = 0,
            WaypointColor = 0,
            SearchRadius = 0,
            Type = WaypointType.Navigation,
        });
    }

    private async Task OnWaypointSelected(GPSWaypoint? waypoint)
    {
        if (waypoint is not null && waypoint.Latitude is not null && waypoint.Longitude is not null) {
            await PanToCoordinates(waypoint.Latitude ?? 0, waypoint.Longitude ?? 0);
        }
    }

    public async Task PanToCoordinates(double lat, double lon)
    {
        await jsRoverMap!.InvokeVoidAsync("panToCoordinates", [lat, lon]);
    }

    [JSInvokable]
    public async Task OnZoomLevel(double lat, double lon, int zoom)
    {
        #if DEBUG
    using (HttpClient client = new HttpClient())
    {
    client.DefaultRequestHeaders.UserAgent.ParseAdd("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36");
    client.DefaultRequestHeaders.Referrer = new Uri("http://mt1.google.com");

    var tasks = new List<Task>();

    // Convert geographic bounds to tile coordinates
    int tileX = LonToTileX(lon, zoom);
    int tileY = LatToTileY(lat, zoom);

    for (int y = (tileY - 3); y < (tileY + 3); y++)
    {
    for (int x = (tileX - 3); x < (tileX + 3); x++)
    {
    MapTile? mapTile = await _MapTileService.GetMapTile(x, y, zoom);
    if (mapTile is null)
    {
        string url = $"http://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={zoom}";
        tasks.Add(DownloadAndSaveTile(client, url, x, y, zoom));
        _cachingMapTiles = true;
    }
    }
    }

    await Task.WhenAll(tasks);
    _cachingMapTiles = false;
    }
        #else
        await Task.CompletedTask;
        #endif
    }

    [JSInvokable]
    public async Task DownloadTileRange(double min_lat, double max_lat, double min_lon, double max_lon, int zoom, bool isLidar) {
        using (HttpClient client = new HttpClient()) {

            client.DefaultRequestHeaders.UserAgent.ParseAdd("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36");
            client.DefaultRequestHeaders.Referrer = new Uri("http://mt1.google.com");

            for (int y = LatToTileY(min_lat, zoom); y >= LatToTileY(max_lat, zoom); --y)
            {
                for (int x = LonToTileX(min_lon, zoom); x <= LonToTileX(max_lon, zoom); ++x)
                {

                    // Determine download URL for tile.
                    string url;
                    if (isLidar) {
                        double lat1 = LatToEPSG3857(TileYToLat(y, zoom));
                        double lon1 = LonToEPSG3857(TileXToLon(x, zoom));
                        double lat2 = LatToEPSG3857(TileYToLat(y + 1, zoom));
                        double lon2 = LonToEPSG3857(TileXToLon(x + 1, zoom));
                        url = $"https://elevation.nationalmap.gov/arcgis/services/3DEPElevation/ImageServer/WMSServer?&service=WMS&request=GetMap&layers=3DEPElevation%3AHillshade%20Gray&styles=&format=image%2Fjpeg&transparent=false&version=1.1.1&width=256&height=256&srs=EPSG%3A3857&bbox={lon1},{lat2},{lon2},{lat1}";
                    } else {
                        url = $"http://mt1.google.com/vt/lyrs=y&x={x}&y={y}&z={zoom}";
                    }

                    // Download tile and ensure success.
                    var response = await client.GetAsync(url);
                    try
                    {
                        response.EnsureSuccessStatusCode();
                    }
                    catch (HttpRequestException e)
                    {
                        Console.WriteLine($"An error occurred: {e.Message}");
                        return;
                    }

                    // Save tile to database.
                    using (var memoryStream = new MemoryStream())
                    {
                        await response.Content.CopyToAsync(memoryStream);
                        byte[] imageBytes = memoryStream.ToArray();
                        if (isLidar)
                        {
                            await _LidarTileService.AddMapTile(new LidarTile { X = x, Y = y, Z = zoom, ImageData = imageBytes });
                        }
                        else
                        {
                            await _MapTileService.AddMapTile(new MapTile { X = x, Y = y, Z = zoom, ImageData = imageBytes });
                        }
                    }
                }
            }
        }
    }

    // Coordinate conversion functions

    private double TileXToLon(int tileX, int zoom)
    {
        return tileX / Math.Pow(2, zoom) * 360 - 180;
    }

    private double TileYToLat(int tileY, int zoom)
    {
        return Math.Atan(Math.Sinh(Math.PI * (1 - 2 * tileY / Math.Pow(2, zoom)))) * 180.0 / Math.PI;
    }

    private int LonToTileX(double lon, int zoom)
    {
        return (int)Math.Floor((lon + 180.0) / 360.0 * Math.Pow(2.0, zoom));
    }

    private int LatToTileY(double lat, int zoom)
    {
        return (int)Math.Floor((1 - Math.Log(Math.Tan(lat * Math.PI / 180.0) + 1 / Math.Cos(lat * Math.PI / 180.0)) / Math.PI) / 2.0 * Math.Pow(2.0, zoom));
    }

    private double LonToEPSG3857(double lon)
    {
        return (lon * 20037508.34) / 180f;
    }

    private double LatToEPSG3857(double lat)
    {
        return (Math.Log(Math.Tan((lat + 90) * (Math.PI / 360f))) / (Math.PI / 180f)) * (20037508.34 / 180);
    }

    private async Task DownloadAndSaveTile(HttpClient client, string url, int x, int y, int z)
    {
        var response = await client.GetAsync(url);
        try
        {
            response.EnsureSuccessStatusCode();
        }
        catch (HttpRequestException e)
        {
            Console.WriteLine($"An error occurred: {e.Message}");
            return;
        }
        using (var memoryStream = new MemoryStream())
        {
            await response.Content.CopyToAsync(memoryStream);
            byte[] imageBytes = memoryStream.ToArray();
            // await _MapTileService.AddMapTile(new MapTile { X = x, Y = y, Z = z, ImageData = imageBytes });
        }
    }

    [JSInvokable]
    public async Task OnWaypointSelected(double lat, double lon)
    {
        // Find closest match by lat and lon
        List<GPSWaypoint> waypoints = _GPSWaypointService.GetGPSWaypoints();
        GPSWaypoint? closestWaypoint = waypoints.OrderBy(w => Math.Abs(((w.Latitude ?? 100) - lat)*((w.Longitude ?? 100) - lon))).FirstOrDefault();
        if (closestWaypoint is not null)
        {
            _GPSWaypointState.SelectedWaypoint = closestWaypoint;
        }
        await Task.CompletedTask;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        _GPSWaypointService.UnsubscribeFromWaypointsChanges(OnWaypointSync);
        _GPSWaypointState.UnsubscribeFromWaypointSelected(OnWaypointSelected);
        ObjectReference?.Dispose();
        try
        {
            if (jsRoverMap is not null)
            {
                await jsRoverMap.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
