@inject RoveCommService _RoveCommService
@using Basestation_Software.Models.RamanGraph
@using System;
@using System.Linq;
@using System.Numerics;

<style>
    .rz-line-series.rz-series-0 path {
    display: @(_showLines ? "auto" : "none");
    }
</style>

<div class="card h-100">
    <div class="card-header">
        <h5>Raman Spectroscopy Graph</h5>
    </div>
    <div class="card-body w-100">
        <RadzenChart>
            <RadzenLineSeries Data="@ramanGraph" CategoryProperty="Raman_Shift" ValueProperty="Intensity">
                <RadzenMarkers Visible="@showMarkers" MarkerType="MarkerType.Circle" StrokeWidth="0" Size="@_dotSize"/>
                <RadzenSeriesDataLabels Visible="@showDataLabels" />
            </RadzenLineSeries>

            <RadzenValueAxis Min="0">
                <RadzenAxisTitle Text="Intensity" />
            </RadzenValueAxis>
        </RadzenChart>
        <button class="btn btn-primary" @onclick=RequestRamanData> Request Raman Spectroscopy Data </button>
        <div class="d-flex">
            <p>Dot Size: </p>
            <RadzenNumeric TValue="float" @bind-Value="@_dotSize"/>
        </div>
        <div class="d-flex">
            <p>Show Lines: </p>
            <RadzenCheckBox TValue="bool" @bind-Value="@_showLines"/>
        </div>
    </div>
</div> 


@code {

    private int _maxY = 2000;
    bool showMarkers = true;
    bool showDataLabels = false;
    private float _dotSize = 2f;
    private bool _showLines = false;

    List<DataItem> ramanGraph = new();

    private async Task RequestRamanData()
    {
        await _RoveCommService.SendAsync<uint>("Raman", "RequestRamanReading", [0], reliable: false);
    }

    protected override async Task OnInitializedAsync()
    {
        // Initialize ramanGraph
        for (int i = 0; i < 2048; i++)
        {
            Console.WriteLine(i);
            ramanGraph.Add(new DataItem { Raman_Shift = i, Intensity = 1d});
        }
            
        //Receiving RoveComm packets if they are sent in
        _RoveCommService.On<ushort>("Raman", "RamanReading_Part1", async (packet) =>
        {
            for (int i = 0; i < 512; i++) ramanGraph[i].Intensity = packet.Data[i];
            await InvokeAsync(StateHasChanged);
        });

        await Task.CompletedTask;
        _RoveCommService.On<ushort>("Raman", "RamanReading_Part2", async (packet) =>
        {
            for (int i = 0; i < 512; i++) ramanGraph[i + 512].Intensity = packet.Data[i];
            await InvokeAsync(StateHasChanged);
        });

        _RoveCommService.On<ushort>("Raman", "RamanReading_Part3", async (packet) =>
        {
            for (int i = 0; i < 512; i++) ramanGraph[i + 1024].Intensity = packet.Data[i];
            await InvokeAsync(StateHasChanged);
        });

        _RoveCommService.On<ushort>("Raman", "RamanReading_Part4", async (packet) =>
        {
            for (int i = 0; i < 512; i++) ramanGraph[i + 1536].Intensity = packet.Data[i];
            await InvokeAsync(StateHasChanged);
        });
    }
}
