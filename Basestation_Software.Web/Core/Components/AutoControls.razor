@implements IDisposable
@inject GPSWaypointState _GPSWaypointState
@inject RoveCommService _RoveCommService
@inject OpService _OpService

<div class="card h-100">
    <div class="card-header">
        <h3>Autonomy Controls</h3>
    </div>
    <div class="card-body align-content-center h-100">
        <div class="button-header">
            <div class="d-inline-flex bg-body-secondary justify-content-center p-2 rounded gap-2">
                <p><b>Selected:</b> @(_selectedWaypoint is not null ? _selectedWaypoint.Name : "None")</p>
                <div class="color-preview" style="background-color: @_selectedWaypoint?.WaypointColor"></div>
                @if (_selectedWaypoint is not null && _selectedWaypoint.TagID is not null && _selectedWaypoint.TagID >= 0)
                {
                    <ArucoTagDisplay ID="@(_selectedWaypoint.TagID ?? 0)" Scale="10" />
                }
            </div>
        </div>

        <div class="text-center">
            <div class="btn-group btn-group-sm justify-content-center mb-2 gap-1" role="group">
                <button class="btn btn-secondary" @onclick=AddPositionLeg>Add Position Leg</button>
                <button class="btn btn-secondary" @onclick=AddMarkerLeg>Add Marker Leg</button>
                <button class="btn btn-secondary" @onclick=AddObjectLeg>Add Object Leg</button>
                <button class="btn btn-secondary" @onclick=AddObstacle>Add Obstacle</button>
                <button class="btn btn-secondary" @onclick=ClearWaypoints>Clear Waypoints</button>
                <button class="btn btn-secondary" @onclick=ClearObstacles>Clear Obstacles</button>
            </div>
        </div>

        <div class="text-center mb-2">
            <div class="btn-group btn-group-sm justify-content-center" role="group">
                <button title="Start Autonomy" class="btn @(_doStuckRoutine ? "btn-info" : "btn-success")" @onclick=StartAutonomy><i class="bi bi-caret-right-fill h1 d-block m-0"></i></button>
                <button title="Stop Autonomy" class="btn btn-danger" @onclick=StopAutonomy><i class="bi bi-pause-fill h1 d-block m-0"></i></button>
            </div>
        </div>

        <div class="bg-body-secondary justify-content-center p-2 rounded gap-2 text-center">
            <label><b>GET ME OUTTA HERE!!</b></label>
            <div style="display: grid; grid-template-columns: auto auto; gap:0.5rem;">
                <label>Enable: </label><InputCheckbox @bind-Value=@_doStuckRoutine style="align-self-right" />
                <label>Speed: </label><InputNumber step="0.1" @bind-Value=@_unstuckSpeed />
                <label>Time: </label><InputNumber step="100" @bind-Value=@_unstuckTime />
            </div>
        </div>

    </div>
</div>

@code
{
    private GPSWaypoint? _selectedWaypoint = null;

    private bool _doStuckRoutine = false;
    // [0.0 - 1.0]
    private float _unstuckSpeed = 0.5f;
    // ms
    private int _unstuckTime = 3000;

    public async Task StartAutonomy()
    {
        _RoveCommService.SubscribeAll();
        _OpService.SetAutonomy();
        if (_doStuckRoutine)
        {
            // Send drive packets every 100ms to avoid triggering watchdog
            for (int i = 0; i < _unstuckTime; i += 100)
            {
                RoveComm.Boards.Core.DriveLeftRight(_RoveCommService, -_unstuckSpeed, -_unstuckSpeed);
                await Task.Delay(100);
            }
        }
        await _RoveCommService.SendAsync<byte>("Autonomy", "StartAutonomy", [0]);
        _OpService.SetAutonomy();
    }

    public async Task StopAutonomy()
    {
        await _RoveCommService.SendAsync<byte>("Autonomy", "DisableAutonomy", [0]);
        _OpService.SetNone();
    }

    public async Task ClearWaypoints()
    {
        await _RoveCommService.SendAsync<byte>("Autonomy", "ClearWaypoints", [0]);
    }

    public async Task ClearObstacles()
    {
        await _RoveCommService.SendAsync<byte>("Autonomy", "ClearObstacles", [0]);
    }

    public async Task AddPositionLeg()
    {
        if (_selectedWaypoint is not null
            && _selectedWaypoint.Latitude is not null
            && _selectedWaypoint.Longitude is not null)
        {
            // await _RoveCommService.SendAsync<double>("Autonomy", "AddPositionLeg", [_selectedWaypoint.Latitude ?? 0, _selectedWaypoint.Longitude ?? 0, _selectedWaypoint.TagID ?? -99]);
            RoveCommBoardDesc board = RoveCommManifest.Boards["Autonomy"];
            await _RoveCommService.SendAsync<double>(board.Commands["AddPositionLeg"].DataID, [_selectedWaypoint.Latitude ?? 0, _selectedWaypoint.Longitude ?? 0, _selectedWaypoint.TagID ?? -99], board.IP);
        }
    }

    public async Task AddMarkerLeg()
    {
        if (_selectedWaypoint != null
            && _selectedWaypoint.Latitude is not null
            && _selectedWaypoint.Longitude is not null
            && _selectedWaypoint.TagID is not null && _selectedWaypoint.TagID >= 0
            && _selectedWaypoint.SearchRadius is not null && _selectedWaypoint.SearchRadius >= 0)
        {
            await _RoveCommService.SendAsync<double>("Autonomy", "AddMarkerLeg", [_selectedWaypoint.Latitude ?? 0, _selectedWaypoint.Longitude ?? 0, _selectedWaypoint.TagID ?? 0, _selectedWaypoint.SearchRadius ?? 0]);
        }
    }

    public async Task AddObjectLeg()
    {
        if (_selectedWaypoint != null
            && _selectedWaypoint.Latitude is not null
            && _selectedWaypoint.Longitude is not null
            && _selectedWaypoint.SearchRadius is not null && _selectedWaypoint.SearchRadius >= 0)
        {
            await _RoveCommService.SendAsync<double>("Autonomy", "AddObjectLeg", [_selectedWaypoint.Latitude ?? 0, _selectedWaypoint.Longitude ?? 0, _selectedWaypoint.TagID ?? 0, _selectedWaypoint.SearchRadius ?? 0]);
        }
    }

    public async Task AddObstacle()
    {
        if (_selectedWaypoint != null
            && _selectedWaypoint.Latitude is not null
            && _selectedWaypoint.Longitude is not null
            && _selectedWaypoint.SearchRadius is not null && _selectedWaypoint.SearchRadius >= 0)
        {
            await _RoveCommService.SendAsync<double>("Autonomy", "AddObstacle", [_selectedWaypoint.Latitude ?? 0, _selectedWaypoint.Longitude ?? 0, _selectedWaypoint.SearchRadius ?? 0]);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _GPSWaypointState.SubscribeToWaypointSelected(OnWaypointSelected);
        await Task.CompletedTask;
    }

    private async Task OnWaypointSelected(GPSWaypoint? waypoint)
    {
        _selectedWaypoint = waypoint;
        await InvokeAsync(StateHasChanged);
    }
    

    void IDisposable.Dispose()
    {

    }
}
