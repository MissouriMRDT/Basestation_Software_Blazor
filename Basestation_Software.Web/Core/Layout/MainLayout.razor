@page "/{PageID:guid=00000000-0000-0000-0000-000000000000}"
@implements IDisposable
@using Basestation_Software.Web.Models
@using System.Text.Json;
@using Microsoft.AspNetCore.Mvc.ModelBinding
@using Microsoft.EntityFrameworkCore
@using System.Collections.ObjectModel
@using System.Collections.Immutable
@inherits LayoutComponentBase
@inject IJSRuntime _IJSRuntime
@inject NavigationManager _NavigationManager
@inject DatabaseService _databaseService
@inject IDbContextFactory<DatabaseContext> _dbContextFactory
@inject NavigationManager UriHelper
@inject RoveCommService _RoveCommService
@inject IJSRuntime _jSRuntime

<PageTitle>MRDT Basestation</PageTitle>

<style>
    #navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 54px;
        padding: 8px 16px;
        display: flex;
        justify-content: left;
        place-items: center;
        border-bottom: 1px solid #000;
    }

    #layout-grid {
        position: fixed;
        inset: 54px 0 0 0;
    }

    #layout-grid>div {
        position: absolute;
    }

    #copy-area {
        position: fixed;
        inset: 10vh 10vw 10vh 10vw;
        z-index: 2000;
        display: grid;
        grid-template-rows: 9fr 1fr;
        grid-template-columns: 1fr 1fr;
    }

    #copy-area button {
        font-size: 5vh;
    }
</style>
<div id="navbar">
    <img src="images/swoosh.svg" style="height: 100%">
    <select @bind=ComponentName>
        @foreach (string name in ComponentNames)
        {
            <option value="@name">@name</option>
        }
    </select>
    <button class="success" @onclick=NewComponent title="New Component"><i class="bi-node-plus" /></button>
    <button class="primary" title="RoveComm Resubscribe All" @onclick="_RoveCommService.SubscribeAll">
        <img src="/images/rovecomm-sil.png" style="height: 13px">
    </button>
    <button class="success" @onclick=NewPage title="New Page"><i class="bi-file-earmark-plus" /></button>
    <button class="danger" @onclick=DeletePage title="Delete Page"><i class="bi-trash" /></button>
    <button class="success" @onclick=OpenCopyArea title="Edit Page"><i class="bi-pencil" /></button>
    <button class="success" @onclick=SavePage title="Save Page"><i class="bi-floppy" /></button>
    <select id="pageSelect" value="@PageID" @onchange=@(async (ChangeEventArgs __e) => { if (Guid.TryParse(__e?.Value as string, out Guid guid)) await Navigate(guid); })>
        <option value="00000000-0000-0000-0000-000000000000">Default</option>
        @SelectOptions
    </select>
</div>
<BlazoredToasts ShowProgressBar="true" Position=Blazored.Toast.Configuration.ToastPosition.TopRight DisableTimeout />
<div id="layout-grid">
    @CustomRender
</div>
@if (CopyAreaVisible)
{
    <div id="copy-area">
        <InputTextArea @ref="CopyArea" @bind-Value="@CopyAreaValue" style="grid-area: 1 / 1 / 2 / 3" />
        <button @onclick="ImportPage" class="success" title="Save Page"><i class="bi-floppy" /></button>
        <button @onclick="@(_ => CopyAreaVisible = false)" class="warning" title="Close"><i class="bi-x-circle" /></button>
    </div>
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    // State
    private RenderFragment? CustomRender { get; set; }
    private RenderFragment? SelectOptions { get; set; }
    private Guid PageID = Guid.Empty;
    private Page Page_ = new Page();
    private InputTextArea? CopyArea;
    private string CopyAreaValue = "";
    private bool CopyAreaVisible = false;
    private DotNetObjectReference<MainLayout>? ObjectReference;
    private bool RegisterComponents = false;
    private Timer PageSaveTimer;
    private List<string> ComponentNames = new();
    private string ComponentName = "";

    [CascadingParameter]
    RouteData RouteData_ { get; set; } = new(typeof(MainLayout), new ReadOnlyDictionary<string, object?>(new Dictionary<string, object?>()));

    public MainLayout()
    {
        PageSaveTimer = new(async _ => await SavePage());
        string prefix = "Basestation_Software.Web.Core.Components";
        foreach (Type type in Assembly.GetExecutingAssembly().GetTypes())
        {
            if (
            type.FullName == null
            || !type.FullName.StartsWith(prefix)
            || !type.IsSubclassOf(typeof(Microsoft.AspNetCore.Components.ComponentBase))
            || type.IsDefined(typeof(Basestation_Software.Web.Core.Layout.ComponentAttributes.Ignore))
            ) continue;
            ComponentNames.Add(type.FullName![(prefix.Length + 1)..]);
        }
        ComponentNames.Sort();
    }

    protected override async Task OnInitializedAsync()
    {
        // Get PageID from url as specified at @page "/{PageID:guid?}".
        // This workaround depends on <CascadingValue Value="@routeData"> in Routes.razor.
        // All because `[Parameter] PageID` wasn't updating PageID with the value from the url.
        PageID = ((Guid?)RouteData_.RouteValues.GetValueOrDefault("PageID", null) ?? PageID);

        ObjectReference = DotNetObjectReference.Create(this);

        _databaseService.SubscribeToTableChanges(typeof(Page), TableChanged);
        if (PageID != Guid.Empty)
        {
            _databaseService.SubscribeToEntityChanges(typeof(Page), PageID, PageChanged);
            _databaseService.SubscribeToEntityDeleted(typeof(Page), PageID, PageChanged);
        }

        await TableChanged();
        await PageChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await _jSRuntime.InvokeVoidAsync("components.setDotNetComponent", ObjectReference);
        if (firstRender || RegisterComponents)
        {
            await _jSRuntime.InvokeVoidAsync("components.registerComponents");
            RegisterComponents = false;
        }
    }

    [JSInvokable]
    public void PauseSave()
    {
        PageSaveTimer.Change(Timeout.Infinite, Timeout.Infinite);
    }
    [JSInvokable]
    public void ComponentMoved(int i, uint x, uint y)
    {
        if (i >= Page_.Components.Count) return;
        if (x != Page_.Components[i].X || y != Page_.Components[i].Y)
        {
            Page_.Components[i].X = x;
            Page_.Components[i].Y = y;
            PageSaveTimer.Change(1000, Timeout.Infinite);
        }
    }
    [JSInvokable]
    public void ComponentResized(int i, uint width, uint height)
    {
        if (i >= Page_.Components.Count) return;
        if (width != Page_.Components[i].Width || height != Page_.Components[i].Height)
        {
            Page_.Components[i].Width = width;
            Page_.Components[i].Height = height;
            PageSaveTimer.Change(1000, Timeout.Infinite);
        }
    }
    [JSInvokable]
    public async void DeleteComponent(int i)
    {
        if (i >= Page_.Components.Count) return;
        Page_.Components.RemoveAt(i);
        await SavePage();
    }

    private async Task Navigate(Guid guid)
    {
        _databaseService.UnsubscribeFromEntityChanges(typeof(Page), PageID, PageChanged);
        _databaseService.UnsubscribeFromEntityDeleted(typeof(Page), PageID, PageChanged);

        PageID = guid;
        _NavigationManager.NavigateTo($"/{PageID}");
        await PageChanged();

        if (PageID != Guid.Empty)
        {
            _databaseService.SubscribeToEntityChanges(typeof(Page), PageID, PageChanged);
            _databaseService.SubscribeToEntityDeleted(typeof(Page), PageID, PageChanged);
        }
    }

    private async Task TableChanged()
    {
        SelectOptions = CreateSelectOptions();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PageChanged()
    {
        if (PageID == Guid.Empty)
        {
            Page_ = new();
        }
        else
        {
            using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();

            Page? page = await databaseContext.Pages.FindAsync(PageID);
            if (page == null)
            {
                _ToastService.ShowError($"Config with id={PageID} not found.");
                page = new();
            }
            Page_ = page;
        }

        CustomRender = CreateComponents();

        RegisterComponents = true;
        await InvokeAsync(StateHasChanged);
    }

    private RenderFragment CreateSelectOptions() => async builder =>
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        // Select.ToListAsync.Select.ToListAsync is necessary because IQueryable does not support tuples.
        List<(Guid, string)> pages = (await databaseContext.Pages.Select(x => new { x.ID, x.Name }).ToListAsync()).Select(x => (x.ID, x.Name)).ToList();

        builder.OpenRegion(0);
        int i = 0;
        foreach ((Guid id, string name) in pages)
        {
            // <option value=config.Key>config.Value.Name</option>
            builder.OpenElement(i, "option");
            builder.AddAttribute(i + 1, "value", id.ToString());
            builder.AddContent(i + 2, name);
            builder.CloseElement();
            i += 10;
        }

        builder.CloseRegion();
    };

    private RenderFragment CreateComponents() => builder =>
    {
        // https://learn.microsoft.com/en-us/aspnet/core/blazor/advanced-scenarios
        // Sequence number i will increase with little change between renders
        builder.OpenRegion(0); // so we can start i at 0
        int i = 0;
        int componentIndex = 0;
        foreach (Component component in Page_.Components)
        {
            Type? componentType = Type.GetType("Basestation_Software.Web.Core.Components." + component.Type);
            if (componentType == null)
            {
                _ToastService.ShowWarning($"Component type {component.Type} not found.");
                continue;
            }

            if (componentType.IsDefined(typeof(ComponentAttributes.Ignore)))
            {
                _ToastService.ShowWarning($"Component type {component.Type} is not valid.");
                continue;
            }

            builder.OpenElement(i, "div"); // <div style="left: X%; top: Y%; width: Width%; height: Height%" class="component" idx=componentIndex>
            builder.AddAttribute(i + 1, "style",
        $"left: {component.X}%; top: {component.Y}%; width: {component.Width}%; height: {component.Height}%"
        );
            builder.AddAttribute(i + 2, "class", "component");
            builder.AddAttribute(i + 3, "idx", componentIndex);

            builder.AddMarkupContent(i + 4, $"<i class=\"component-move bi-arrows-move\"></i><i class=\"component-resize bi-arrow-down-right\"></i><button class=\"danger component-delete\" title=\"Delete Component\" onclick=\"components.delete_({componentIndex})\"><i class=\"bi-trash\"></i></button>");

            builder.OpenComponent(i + 5, componentType); // <componentType>
            if (componentType.GetMember("ID").Length > 0)
            {
                // Component requires an ID, generate one.
                string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
                char[] stringChars = new char[20];
                Random random = new Random();
                for (int j = 0; j < stringChars.Length; j++)
                {
                    stringChars[j] = chars[random.Next(chars.Length)];
                }
                string componentID = new String(stringChars);
                builder.AddComponentParameter(i + 6, "ID", componentID);
            }
            builder.CloseComponent(); // </componentType>
            builder.CloseElement(); // </div>

            i += 10;
            componentIndex++;

        }
        builder.CloseRegion();
    };

    private async Task SavePage()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        if (PageID == Guid.Empty)
        {
            // Create a new page instead of changing the default page.
            await NewPage();
        }
        else
        {
            databaseContext.Pages.Update(Page_);
            await databaseContext.SaveChangesAsync(_databaseService);
        }
    }

    private async Task NewPage()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        Page_.ID = Guid.NewGuid();
        databaseContext.Pages.Add(Page_);
        await databaseContext.SaveChangesAsync(_databaseService);
        await Navigate(Page_.ID);
    }

    private async Task DeletePage()
    {
        if (PageID == Guid.Empty) return;
        Page deleted = Page_;
        await Navigate(Guid.Empty);
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        databaseContext.Pages.Remove(deleted);
        await databaseContext.SaveChangesAsync(_databaseService);
    }

    private async Task NewComponent()
    {
        Page_.Components.Add(new Component
        {
            X = 5,
            Y = 5,
            Width = 20,
            Height = 10,
            Type = ComponentName,
        }
        );
        await SavePage();
    }

    private void OpenCopyArea()
    {
        CopyAreaValue = JsonSerializer.Serialize(Page_);
        CopyAreaVisible = true;
    }

    private async Task ImportPage()
    {
        CopyAreaVisible = false;
        Page_ = JsonSerializer.Deserialize<Page?>(CopyAreaValue) ?? Page_;
        await SavePage();
    }

    void IDisposable.Dispose()
    {
        _databaseService.UnsubscribeFromEntityChanges(typeof(Page), PageID, PageChanged);
        _databaseService.UnsubscribeFromEntityDeleted(typeof(Page), PageID, PageChanged);
        _databaseService.UnsubscribeFromTableChanges(typeof(Page), TableChanged);
        ObjectReference?.Dispose();
    }
}