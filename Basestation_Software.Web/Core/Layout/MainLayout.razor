@page "/{PageID:guid=00000000-0000-0000-0000-000000000001}"
@implements IDisposable
@using Basestation_Software.Web.Models
@using System.Text.Json;
@using Microsoft.EntityFrameworkCore
@using System.Collections.ObjectModel
@inherits LayoutComponentBase
@inject IJSRuntime _IJSRuntime
@inject NavigationManager _NavigationManager
@inject DatabaseService _databaseService
@inject IDbContextFactory<DatabaseContext> _dbContextFactory
@inject NavigationManager UriHelper
@inject CookieService _CookieService
@inject RoveCommService _RoveCommService

<PageTitle>MRDT Basestation</PageTitle>

<style>
    #layout-grid {
        display: grid;
        grid-template-columns: repeat(
                @Page_.Columns
                , 1fr);
        grid-template-rows: repeat(
                @Page_.Columns
                , 1fr);
        /* width: @($"{Page_.Width}vw")
        ;
        */ height:
            @($"{Page_.Height}vh")
        ;
        padding-top: 75px;
        gap: 0.5rem;
        margin: 0.75rem;
    }

    #copy-area {
        position: fixed;
        inset: 10vh 10vw 10vh 10vw;
        z-index: 2000;
        display: grid;
        grid-template-rows: 9fr 1fr;
        grid-template-columns: 1fr 1fr;
    }

    #copy-area button {
        font-size: 5vh;
    }
</style>

<div class="page">
    <link rel="stylesheet" href="_content/Radzen.Blazor/css/default-base.css" />
    <link rel="stylesheet" href=themes/default.css />
    <nav class="navbar navbar-expand-sm border-bottom box-shadow mb-3 mat-glass shadow-sm fixed-top" style="padding: 8px 16px">
        <div class="navbar-nav">
            <img src="images/swoosh.svg" height="35" />
        </div>
        <div class="nav ms-auto me-e justify-content-end">
            <button class="btn btn-sm btn-primary" title="RoveComm Resubscribe All" style="margin-right: 3rem" @onclick="_RoveCommService.SubscribeAll">
                <img src="/images/rovecomm-sil.png" />
            </button>
            <select id="pageSelect" value="@PageID" @onchange=@(async (ChangeEventArgs __e) => { if (Guid.TryParse(__e?.Value as string, out Guid guid)) await Navigate(guid); })>
                @SelectOptions
            </select>
            <button class="btn btn-sm btn-success" @onclick=NewPage title="New Page"><i class="bi bi-inline-text bi-file-earmark-plus" /></button>
            <button class="btn btn-sm btn-danger" @onclick=DeletePage title="Delete Page"><i class="bi bi-inline-text bi-trash" /></button>
            <button class="btn btn-sm btn-success" @onclick=OpenCopyArea title="Edit Page"><i class="bi bi-inline-text bi-pencil" /></button>
            <button class="btn btn-sm btn-success" @onclick=SavePage title="Save Page"><i class="bi bi-inline-text bi-floppy" /></button>
            <button class="btn btn-sm btn-success" @onclick=NewComponent title="New Component"><i class="bi bi-inline-text bi-node-plus" /></button>
        </div>
        <BlazoredToasts ShowProgressBar="true" Position=Blazored.Toast.Configuration.ToastPosition.TopRight DisableTimeout />
    </nav>
    <div id="layout-grid">
        @CustomRender
    </div>
    @if (CopyAreaVisible)
    {
        <div id="copy-area">
            <InputTextArea @ref="CopyArea" @bind-Value="@CopyAreaValue" style="grid-area: 1 / 1 / 2 / 3" />
            <button @onclick="ImportConfig" class="btn btn-success" title="Save Page"><i class="bi bi-inline-text bi-floppy" /></button>
            <button @onclick="@(_ => CopyAreaVisible = false)" class="btn btn-warning" title="Close"><i class="bi bi-inline-text bi-x-circle" /></button>
        </div>
    }
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    // State
    private RenderFragment? CustomRender { get; set; }
    private RenderFragment? SelectOptions { get; set; }
    private Guid PageID = new();
    private Page Page_ = new Page();
    private InputTextArea? CopyArea;
    private string CopyAreaValue = "";
    private bool CopyAreaVisible = false;

    [CascadingParameter]
    RouteData RouteData_ { get; set; } = new(typeof(MainLayout), new ReadOnlyDictionary<string, object?>(new Dictionary<string, object?>()));

    protected override async Task OnInitializedAsync()
    {
        // Get PageID from url as specified at @page "/{PageID:guid?}".
        // This workaround depends on <CascadingValue Value="@routeData"> in Routes.razor.
        // All because `[Parameter] PageID` wasn't updating PageID with the value from the url.
        PageID = ((Guid?)RouteData_.RouteValues.GetValueOrDefault("PageID", null) ?? PageID);

        _databaseService.SubscribeToEntityChanges(typeof(Page), PageID, PageChanged);
        _databaseService.SubscribeToEntityDeleted(typeof(Page), PageID, PageChanged);
        _databaseService.SubscribeToTableChanges(typeof(Page), TableChanged);

        await PageChanged();
    }

    private async Task Navigate(Guid guid)
    {
        PageID = guid;
        _NavigationManager.NavigateTo($"/{PageID}");
        await PageChanged();
    }

    private async Task TableChanged()
    {
        SelectOptions = CreateSelectOptions();
        await InvokeAsync(StateHasChanged);
    }

    private async Task PageChanged()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();

        Page? page = await databaseContext.Pages.FindAsync(PageID);
        if (page == null)
        {
            _ToastService.ShowError($"Config with id={PageID} not found.");
        }
        else
        {
            Page_ = page;
            CustomRender = CreateComponents();
        }

        await TableChanged();
    }

    private RenderFragment CreateSelectOptions() => async builder =>
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        // Select.ToListAsync.Select.ToListAsync is neccesary because IQueryable does not support tuples.
        List<(Guid, string)> pages = (await databaseContext.Pages.Select(x => new { x.ID, x.Name }).ToListAsync()).Select(x => (x.ID, x.Name)).ToList();

        builder.OpenRegion(0);
        int i = 0;
        foreach ((Guid id, string name) in pages)
        {
            // <option value=config.Key>config.Value.Name</option>
            builder.OpenElement(i, "option");
            builder.AddAttribute(i + 1, "value", id.ToString());
            builder.AddContent(i + 2, name);
            builder.CloseElement();
            i += 10;
        }

        builder.CloseRegion();
    };

    private RenderFragment CreateComponents() => builder =>
    {
        // https://learn.microsoft.com/en-us/aspnet/core/blazor/advanced-scenarios
        // Sequence number i will increase with little change between renders
        builder.OpenRegion(0); // so we can start i at 0
        int i = 0;
        int componentIndex = 0;
        foreach (Component component in Page_.Components)
        {
            Type? componentType = Type.GetType("Basestation_Software.Web.Core.Components." + component.Type);
            if (componentType == null)
            {
                _ToastService.ShowWarning($"Component type {component.Type} not found.");
                continue;
            }

            if (componentType.IsDefined(typeof(ComponentAttributes.Ignore)))
            {
                _ToastService.ShowWarning($"Component type {component.Type} is not valid.");
                continue;
            }

            builder.OpenElement(i, "div"); // <div>
            builder.AddAttribute(i + 1, "style",
        $"grid-area: {component.Y + 1} / {component.X + 1} / span {component.Height} / span {component.Width}; place-self: {component.PlaceSelf}"
        );
            builder.OpenComponent(i + 2, typeof(ComponentOptions)); // <ComponentOptions>
            builder.AddComponentParameter(i + 3, "Components", Page_.Components);
            builder.AddComponentParameter(i + 4, "ComponentIndex", componentIndex);
            builder.AddAttribute(i + 5, "OnSaved", EventCallback.Factory.Create(this, SavePage)); // It was a lot of fun to find this solution /s
            builder.CloseComponent(); // </ComponentOptions>

            builder.OpenComponent(i + 6, componentType); // <componentType>
            if (componentType.GetMember("ID").Length > 0)
            {
                // Component requires an ID, generate one.
                string chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
                char[] stringChars = new char[20];
                Random random = new Random();
                for (int j = 0; j < stringChars.Length; j++)
                {
                    stringChars[j] = chars[random.Next(chars.Length)];
                }
                string componentID = new String(stringChars);
                builder.AddComponentParameter(i + 7, "ID", componentID);
            }
            builder.CloseComponent(); // </componentType>
            builder.CloseElement(); // </div>

            i += 10;
            componentIndex++;

        }
        builder.CloseRegion();
    };

    private async Task SavePage()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        databaseContext.Pages.Update(Page_);
        await databaseContext.SaveChangesAsync(_databaseService);
    }

    private async Task NewPage()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        Guid newID = Guid.NewGuid();
        Page_.ID = newID;
        await databaseContext.Pages.AddAsync(Page_);
        await databaseContext.SaveChangesAsync(_databaseService);
        await Navigate(newID);
    }

    private async Task DeletePage()
    {
        using DatabaseContext databaseContext = await _dbContextFactory.CreateDbContextAsync();
        Guid guid = PageID;
        PageID = new Guid("00000000-0000-0000-0000-000000000001");
        databaseContext.Pages.Remove(Page_);
        await databaseContext.SaveChangesAsync(_databaseService);
        await Navigate(PageID);
    }

    private async Task NewComponent()
    {
        Page_.Components.Add(new Component
        {
            X = 5,
            Y = 5,
            Width = 20,
            Height = 10,
            Type = "Other.Placeholder",
            PlaceSelf = "stretch"
        }
        );
        await SavePage();
    }

    private void OpenCopyArea()
    {
        CopyAreaValue = JsonSerializer.Serialize(Page_);
        CopyAreaVisible = true;
    }

    private async Task ImportConfig()
    {
        CopyAreaVisible = false;
        Page_ = JsonSerializer.Deserialize<Page?>(CopyAreaValue) ?? Page_;
        await SavePage();
    }

    void IDisposable.Dispose()
    {
        _databaseService.UnsubscribeFromEntityChanges(typeof(Page), PageID, PageChanged);
        _databaseService.UnsubscribeFromEntityDeleted(typeof(Page), PageID, PageChanged);
        _databaseService.UnsubscribeFromTableChanges(typeof(Page), TableChanged);
    }
}