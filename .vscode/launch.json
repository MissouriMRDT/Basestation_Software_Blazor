{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/Basestation_Software.Web/bin/Debug/net8.0/Basestation_Software.Web.dll",
            "linux": {
                "program": "${workspaceFolder}/Basestation_Software.Web/bin/Debug/net8.0/linux-x64/Basestation_Software.Web.dll"
            },
            "args": [],
            "cwd": "${workspaceFolder}/Basestation_Software.Web",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://*:8080",
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder}/Basestation_Software.Web/Views"
            }
        }
    ]
}